local KEY={100,43,146,72,165,82,19,170,60,211,242,27,135,27,238,25,90,220,234,115,80,90,194,56,122,34,81,168,35,45,106,22,181,201,14,34,76,165,141,205,40,227,114,162,56,145,53,43}
local SEED=1630674688
local IV=106
local HASH=282643645
local N=835468

local LK={}
do
  local a="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  for i=1,#a do LK[string.byte(a,i)]=i-1 end
end

-- base64 decode -> byte array
local enc={}
local en=0
do
  local eq=string.byte("=")
  local len=#B64
  local i=1
  while i<=len do
    local c1=LK[string.byte(B64,i)]   or 0
    local c2=LK[string.byte(B64,i+1)] or 0
    local b3=string.byte(B64,i+2)
    local b4=string.byte(B64,i+3)
    local c3=(b3 and LK[b3]) or 0
    local c4=(b4 and LK[b4]) or 0
    local n1=c1*262144+c2*4096+c3*64+c4
    en=en+1; enc[en]=band(rshift(n1,16),255)
    if b3 and b3~=eq then en=en+1; enc[en]=band(rshift(n1,8),255) end
    if b4 and b4~=eq then en=en+1; enc[en]=band(n1,255) end
    i=i+4
  end
end

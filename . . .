-- stream-cipher decrypt
local out={}
local s=SEED
local prev=IV
local nk=#KEY
for i=1,en do
  s=bxor(s,lshift(s,13))
  s=bxor(s,rshift(s,17))
  s=bxor(s,lshift(s,5))
  local kb=bxor(band(s,255),KEY[((i-1)%nk)+1])
  local c=enc[i]
  local p=bxor(bxor(c,kb),prev)
  out[i]=p
  prev=c
end

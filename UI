local function BindHover(button, glow, extra)
	button.MouseEnter:Connect(function()
		if glow then Tween(glow, ANIM.Hover, { ImageTransparency = 0.35 }) end
		if extra then extra(true) end
	end)
	button.MouseLeave:Connect(function()
		if glow then Tween(glow, ANIM.Hover, { ImageTransparency = 1 }) end
		if extra then extra(false) end
	end)
end


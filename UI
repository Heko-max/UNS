function Window:_card(parent, info, order)
	local card = New("TextButton", {
		Name = info.Title or "CARD", Parent = parent, LayoutOrder = order,
		Text = "", AutoButtonColor = false,
		BackgroundColor3 = THEME.Panel, BackgroundTransparency = 0.5,
		ZIndex = 4,
	}, { Corner(UDim.new(0.12, 0)) })
	New("UIStroke", { Parent = card, Color = THEME.GradTop, Thickness = 1.2, Transparency = 0.55 })
	local glow = HoverGlow(card)
	New("ImageLabel", {
		Name = "Icon", Parent = card, BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0.06, 0.5), Size = UDim2.fromScale(0.22, 0.55),
		Image = asset(info.Image or IMAGES.TabIcon), ScaleType = Enum.ScaleType.Fit, ZIndex = 5,
	})
	New("TextLabel", {
		Name = "Title", Parent = card, BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.32, 0.20), Size = UDim2.fromScale(0.62, 0.30),
		Text = info.Title or "TAB", RichText = true, TextScaled = true,
		TextColor3 = THEME.Text, FontFace = FONT.Bold,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	})
	New("TextLabel", {
		Name = "Desc", Parent = card, BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.32, 0.52), Size = UDim2.fromScale(0.62, 0.28),
		Text = info.Desc or "", RichText = true, TextScaled = true,
		TextColor3 = THEME.Text, TextTransparency = 0.45, FontFace = FONT.Semi,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	})
	BindHover(card, glow, function(inside)
		Tween(card, ANIM.Hover, { BackgroundTransparency = inside and 0.28 or 0.5 })
	end)
	return card
end

local function fadeInRows(container)
	local i = 0
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("GuiObject") then
			i += 1
			child.BackgroundTransparency = 1
			local target = 0.5
			task.delay(i * ANIM.RowStagger, function()
				if child.Parent then Tween(child, ANIM.SectionIn, { BackgroundTransparency = target }) end
			end)
		end
	end
end

function Window:_showLevel(n, animate)
	self.Level = n
	local frames = { self.LevelTabs, self.LevelSections, self.CurrentConfig }
	for i, f in ipairs(frames) do
		if f then f.Visible = (i == n) end
	end
	if self.CurrentConfig and n ~= 3 then self.CurrentConfig.Visible = false end
	self.ReturnButton.Visible = (n > 1)
	self.SearchBox.Size = UDim2.fromScale(n > 1 and 0.787 or 0.890, 0.116)
	self.EmptyHint.Visible = (n == 1 and #self.Tabs == 0)

	local shown = frames[n]
	if shown and animate ~= false then
		shown.Position = UDim2.fromScale(0.055 + 0.06, n == 1 and 0.345 or 0.337)
		Tween(shown, ANIM.SectionIn, { Position = UDim2.fromScale(0.055, n == 1 and 0.345 or 0.337) })
		fadeInRows(shown)
	end
end

function Window:GoBack()
	if self.Level == 3 then
		self:_showLevel(2)
	elseif self.Level == 2 then
		self:_showLevel(1)
	end
end

function Window:_filter(query)
	query = string.lower(query or "")
	local frames = { self.LevelTabs, self.LevelSections, self.CurrentConfig }
	local current = frames[self.Level]
	if not current then return end
	for _, child in ipairs(current:GetDescendants()) do
		if child:IsA("GuiButton") and child:FindFirstChild("Title") then
			local ok = (query == "") or string.find(string.lower(child.Title.Text), query, 1, true) ~= nil
			child.Visible = ok
		end
	end
end

--=====================================================================
-- 11) TABS / SECTIONS / CONTROLS
--     live control heights (relative to the column unit):
--       Button 0.60 | Checkbox 0.80 | Slider 1.25 | Textbox 1.48 | Dropdown 3.31
--=====================================================================
local H = { Button = 0.60, Toggle = 0.80, Slider = 1.25, Textbox = 1.48, Dropdown = 3.31, Label = 0.55, Keybind = 0.80 }

local Tab = {}
Tab.__index = Tab
local Section = {}
Section.__index = Section

-- ui:AddTab({ Title = "AUTO FARM", Desc = "...", Image = "..." })
function Window:AddTab(info)
	info = info or {}
	local tab = setmetatable({}, Tab)
	tab.Window = self
	tab.Title = info.Title or ("TAB " .. tostring(#self.Tabs + 1))
	tab.Sections = {}

	-- level-2 page that will hold this tab's section cards
	tab.Page = New("Frame", {
		Name = "MINI_" .. (#self.Tabs + 1), Parent = self.LevelSections,
		BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 3,
	})
	New("UIGridLayout", {
		Parent = tab.Page,
		CellSize = UDim2.fromScale(0.475, 0.30),
		CellPadding = UDim2.fromScale(0.02, 0.045),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	tab.Card = self:_card(self.LevelTabs, {
		Title = tab.Title, Desc = info.Desc, Image = info.Image,
	}, #self.Tabs + 1)
	tab.Card.MouseButton1Click:Connect(function()
		for _, t in ipairs(self.Tabs) do t.Page.Visible = false end
		tab.Page.Visible = true
		self:_showLevel(2)
	end)

	table.insert(self.Tabs, tab)
	self.EmptyHint.Visible = false
	return tab
end

function Window:FindTab(name)
	for _, t in ipairs(self.Tabs) do if t.Title == name then return t end end
end

-- tab:AddSection({ Title = "MAIN", Desc = "...", Image = "..." })
function Tab:AddSection(info)
	info = info or {}
	local win = self.Window
	local sec = setmetatable({}, Section)
	sec.Window = win
	sec.Tab = self
	sec.Title = info.Title or ("SECTION " .. tostring(#self.Sections + 1))
	sec.Controls = {}
	sec._col = 1

	-- level-3 config page, exact live layout
	sec.Page = New("ScrollingFrame", {
		Name = "CONFIG_" .. sec.Title, Parent = win.Anchor,
		BackgroundColor3 = THEME.Section, BackgroundTransparency = 0.75, BorderSizePixel = 0,
		Position = UDim2.fromScale(0.055, 0.345), Size = UDim2.fromScale(0.890, 0.602),
		CanvasSize = UDim2.fromScale(0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 0, ClipsDescendants = true, ZIndex = 3, Visible = false,
	}, { Corner(GEO.Corner) })

	local scroll = New("Frame", {
		Name = "Inner", Parent = sec.Page, BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.022, 0.054), Size = UDim2.fromScale(0.965, 0.946), ZIndex = 4,
	})
	local function column(x)
		return New("Frame", {
			Parent = scroll, BackgroundTransparency = 1,
			Position = UDim2.fromScale(x, 0), Size = UDim2.fromScale(0.475, 0.080), ZIndex = 4,
		}, {
			Aspect(GEO.ColumnAspect, Enum.AspectType.ScaleWithParentSize, Enum.DominantAxis.Width),
			VList(UDim.new(0.3, 0)),
		})
	end
	sec.Col1 = column(0)
	sec.Col2 = column(0.518)

	sec.Card = win:_card(self.Page, {
		Title = sec.Title, Desc = info.Desc, Image = info.Image,
	}, #self.Sections + 1)
	sec.Card.MouseButton1Click:Connect(function()
		if win.CurrentConfig then win.CurrentConfig.Visible = false end
		win.CurrentConfig = sec.Page
		win:_showLevel(3)
	end)

	table.insert(self.Sections, sec)
	return sec
end

function Section:_slot(height)
	local parent = (self._col == 1) and self.Col1 or self.Col2
	self._col = (self._col == 1) and 2 or 1
	return New("TextButton", {
		Parent = parent, Text = "", AutoButtonColor = false,
		BackgroundColor3 = THEME.Panel, BackgroundTransparency = 0.35,
		Size = UDim2.fromScale(1, height), LayoutOrder = #self.Controls + 1, ZIndex = 4,
	}, { Corner(UDim.new(0.18, 0)) })
end

local function slotTitle(slot, text, x)
	return New("TextLabel", {
		Name = "Title", Parent = slot, BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(x or 0.05, 0.5), Size = UDim2.fromScale(0.65, 0.45),
		Text = text, RichText = true, TextScaled = true, TextColor3 = THEME.Text,
		FontFace = FONT.Semi, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	})
end

--------------------------------------------------------------------- BUTTON
function Section:AddButton(info)
	info = info or {}
	local slot = self:_slot(H.Button)
	slot.BackgroundColor3 = THEME.AccentDeep
	slot.BackgroundTransparency = 0.15
	slot.ClipsDescendants = true
	local glow = HoverGlow(slot)
	New("TextLabel", {
		Name = "Title", Parent = slot, BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.9, 0.55),
		Text = info.Title or "BUTTON", RichText = true, TextScaled = true,
		TextColor3 = THEME.Text, FontFace = FONT.Bold, ZIndex = 5,
	})
	BindHover(slot, glow, function(inside)
		Tween(slot, ANIM.Hover, { BackgroundTransparency = inside and 0 or 0.15 })
	end)
	slot.MouseButton1Click:Connect(function()
		Tween(slot, ANIM.Press, { Size = UDim2.fromScale(0.96, H.Button * 0.94) })
		task.delay(0.09, function() Tween(slot, ANIM.Press, { Size = UDim2.fromScale(1, H.Button) }) end)
		if info.Callback then task.spawn(info.Callback) end
	end)
	table.insert(self.Controls, slot)
	return slot
end

--------------------------------------------------------------------- TOGGLE
function Section:AddToggle(info)
	info = info or {}
	local slot = self:_slot(H.Toggle)
	slotTitle(slot, info.Title or "TOGGLE")
	local state = info.Default and true or false

	local track = New("Frame", {
		Name = "Track", Parent = slot, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(0.94, 0.5), Size = UDim2.fromScale(0.20, 0.42),
		BackgroundColor3 = state and THEME.AccentDeep or Color3.fromRGB(60, 60, 60), ZIndex = 5,
	}, { Corner(UDim.new(1, 0)) })
	local knob = New("Frame", {
		Name = "Knob", Parent = track, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(state and 1 or 0, 0.5),
		Position = UDim2.fromScale(state and 0.94 or 0.06, 0.5),
		Size = UDim2.fromScale(0.42, 0.78),
		BackgroundColor3 = THEME.Text, ZIndex = 6,
	}, { Corner(UDim.new(1, 0)) })
	local glow = HoverGlow(slot)
	BindHover(slot, glow, function(inside)
		Tween(slot, ANIM.Hover, { BackgroundTransparency = inside and 0.2 or 0.35 })
	end)

	local api = {}
	function api:Set(v, silent)
		state = v and true or false
		Tween(track, ANIM.ToggleFlip, {
			BackgroundColor3 = state and THEME.AccentDeep or Color3.fromRGB(60, 60, 60) })
		Tween(knob, ANIM.ToggleFlip, {
			Position = UDim2.fromScale(state and 0.94 or 0.06, 0.5),
			AnchorPoint = Vector2.new(state and 1 or 0, 0.5) })
		if info.Flag then Nexo.Flags[info.Flag] = state end
		if not silent and info.Callback then task.spawn(info.Callback, state) end
	end
	function api:Get() return state end
	slot.MouseButton1Click:Connect(function() api:Set(not state) end)
	api:Set(state, true)
	table.insert(self.Controls, slot)
	return api
end

--------------------------------------------------------------------- SLIDER
function Section:AddSlider(info)
	info = info or {}
	local min, max = info.Min or 0, info.Max or 100
	local value = math.clamp(info.Default or min, min, max)
	local decimals = info.Decimals or 0
	local slot = self:_slot(H.Slider)
	slot.AutoButtonColor = false

	New("TextLabel", {
		Name = "Title", Parent = slot, BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.05, 0.10), Size = UDim2.fromScale(0.60, 0.30),
		Text = info.Title or "SLIDER", RichText = true, TextScaled = true,
		TextColor3 = THEME.Text, FontFace = FONT.Semi,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	})
	local valueLabel = New("TextLabel", {
		Name = "Value", Parent = slot, BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(0.95, 0.10), Size = UDim2.fromScale(0.3, 0.30),
		Text = tostring(value), TextScaled = true, TextColor3 = THEME.Accent,
		FontFace = FONT.Bold, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 5,
	})
	local bar = New("Frame", {
		Name = "Bar", Parent = slot, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.80), Size = UDim2.fromScale(0.90, 0.14),
		BackgroundColor3 = Color3.fromRGB(45, 45, 45), ZIndex = 5,
	}, { Corner(UDim.new(1, 0)) })
	local fill = New("Frame", {
		Name = "Fill", Parent = bar, BorderSizePixel = 0,
		Size = UDim2.fromScale((value - min) / (max - min), 1),
		BackgroundColor3 = THEME.AccentDeep, ZIndex = 6,
	}, { Corner(UDim.new(1, 0)) })
	New("UIGradient", {
		Parent = fill,
		Color = ColorSequence.new(THEME.GradTop, THEME.Accent),
	})

	local api = {}
	function api:Set(v, silent)
		value = math.clamp(v, min, max)
		local mult = 10 ^ decimals
		value = math.floor(value * mult + 0.5) / mult
		Tween(fill, ANIM.Slider, { Size = UDim2.fromScale((value - min) / (max - min), 1) })
		valueLabel.Text = tostring(value) .. (info.Suffix or "")
		if info.Flag then Nexo.Flags[info.Flag] = value end
		if not silent and info.Callback then task.spawn(info.Callback, value) end
	end
	function api:Get() return value end

	local dragging = false
	local function update(input)
		local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		api:Set(min + (max - min) * rel)
	end
	slot.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true update(input)
		end
	end)
	slot.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
	end)
	api:Set(value, true)
	table.insert(self.Controls, slot)
	return api
end

------------------------------------------------------------------- DROPDOWN
function Section:AddDropdown(info)
	info = info or {}
	local options = info.Options or {}
	local multi = info.Multi and true or false
	local selected = multi and (info.Default or {}) or (info.Default or options[1])
	local slot = self:_slot(H.Dropdown)
	slot.ClipsDescendants = true

	slotTitle(slot, info.Title or "DROPDOWN", 0.05).Size = UDim2.fromScale(0.9, 0.12)
	slot.Title.AnchorPoint = Vector2.new(0, 0)
	slot.Title.Position = UDim2.fromScale(0.05, 0.03)

	local list = New("ScrollingFrame", {
		Name = "List", Parent = slot, BackgroundTransparency = 1, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.96), Size = UDim2.fromScale(0.92, 0.78),
		CanvasSize = UDim2.fromScale(0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 2, ScrollBarImageColor3 = THEME.ScrollBar, ZIndex = 5,
	}, { VList(UDim.new(0.02, 0)) })

	local api = {}
	local buttons = {}
	local function isPicked(opt)
		if multi then
			for _, v in ipairs(selected) do if v == opt then return true end end
			return false
		end
		return selected == opt
	end
	local function refresh()
		for opt, btn in pairs(buttons) do
			local on = isPicked(opt)
			Tween(btn, ANIM.Hover, {
				BackgroundColor3 = on and THEME.AccentDeep or THEME.Panel,
				BackgroundTransparency = on and 0.1 or 0.45,
			})
		end
	end
	function api:Set(v, silent)
		selected = v
		refresh()
		if info.Flag then Nexo.Flags[info.Flag] = selected end
		if not silent and info.Callback then task.spawn(info.Callback, selected) end
	end
	function api:Get() return selected end
	function api:Add(opt)
		local btn = New("TextButton", {
			Name = tostring(opt), Parent = list, Text = "", AutoButtonColor = false,
			BackgroundColor3 = THEME.Panel, BackgroundTransparency = 0.45,
			Size = UDim2.new(1, 0, 0, 24), ZIndex = 6,
		}, { Corner(UDim.new(0.35, 0)) })
		New("TextLabel", {
			Name = "Title", Parent = btn, BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1), Text = tostring(opt), TextScaled = true,
			TextColor3 = THEME.Text, FontFace = FONT.Semi, ZIndex = 7,
		})
		buttons[opt] = btn
		btn.MouseButton1Click:Connect(function()
			if multi then
				local found
				for i, v in ipairs(selected) do if v == opt then found = i break end end
				if found then table.remove(selected, found) else table.insert(selected, opt) end
				api:Set(selected)
			else
				api:Set(opt)
			end
		end)
		BindHover(btn, nil, function(inside)
			if not isPicked(opt) then
				Tween(btn, ANIM.Hover, { BackgroundTransparency = inside and 0.25 or 0.45 })
			end
		end)
	end
	function api:Clear()
		for _, b in pairs(buttons) do b:Destroy() end
		buttons = {}
	end
	function api:Refresh(newOptions)
		api:Clear()
		for _, o in ipairs(newOptions or {}) do api:Add(o) end
		refresh()
	end
	api:Refresh(options)
	api:Set(selected, true)
	table.insert(self.Controls, slot)
	return api
end

-------------------------------------------------------------------- TEXTBOX
function Section:AddTextbox(info)
	info = info or {}
	local slot = self:_slot(H.Textbox)
	New("TextLabel", {
		Name = "Title", Parent = slot, BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.05, 0.10), Size = UDim2.fromScale(0.9, 0.3),
		Text = info.Title or "TEXTBOX", RichText = true, TextScaled = true,
		TextColor3 = THEME.Text, FontFace = FONT.Semi,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	})
	local holder = New("Frame", {
		Parent = slot, BackgroundColor3 = Color3.fromRGB(14, 14, 14),
		BackgroundTransparency = 0.2, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.9), Size = UDim2.fromScale(0.9, 0.42), ZIndex = 5,
	}, { Corner(UDim.new(0.3, 0)) })
	local tb = New("TextBox", {
		Parent = holder, BackgroundTransparency = 1,
		Size = UDim2.fromScale(0.92, 0.8), Position = UDim2.fromScale(0.04, 0.1),
		Text = info.Default or "", PlaceholderText = info.Placeholder or "Type here...",
		TextScaled = true, TextColor3 = THEME.Text, FontFace = FONT.Semi,
		ClearTextOnFocus = false, ZIndex = 6,
	})
	tb.FocusLost:Connect(function(enter)
		if info.Flag then Nexo.Flags[info.Flag] = tb.Text end
		if info.Callback then task.spawn(info.Callback, tb.Text, enter) end
	end)
	table.insert(self.Controls, slot)
	return { Set = function(_, v) tb.Text = v end, Get = function() return tb.Text end, Instance = tb }
end

-------------------------------------------------------------------- KEYBIND
function Section:AddKeybind(info)
	info = info or {}
	local slot = self:_slot(H.Keybind)
	slotTitle(slot, info.Title or "KEYBIND")
	local key = info.Default
	local btn = New("TextButton", {
		Parent = slot, AutoButtonColor = false, Text = key and key.Name or "...",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(0.94, 0.5), Size = UDim2.fromScale(0.28, 0.5),
		BackgroundColor3 = THEME.Panel, BackgroundTransparency = 0.2,
		TextScaled = true, TextColor3 = THEME.Accent, FontFace = FONT.Bold, ZIndex = 5,
	}, { Corner(UDim.new(0.3, 0)) })
	local listening = false
	btn.MouseButton1Click:Connect(function()
		listening = true
		btn.Text = "..."
	end)
	UserInputService.InputBegan:Connect(function(input, gpe)
		if listening and input.UserInputType == Enum.UserInputType.Keyboard then
			listening = false
			key = input.KeyCode
			btn.Text = key.Name
			if info.Flag then Nexo.Flags[info.Flag] = key end
		elseif not gpe and key and input.KeyCode == key and info.Callback then
			task.spawn(info.Callback, key)
		end
	end)
	table.insert(self.Controls, slot)
	return { Get = function() return key end }
end

---------------------------------------------------------------------- LABEL
function Section:AddLabel(text)
	local slot = self:_slot(H.Label)
	slot.BackgroundTransparency = 0.6
	New("TextLabel", {
		Name = "Title", Parent = slot, BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.9, 0.6),
		Text = tostring(text), RichText = true, TextScaled = true,
		TextColor3 = THEME.Text, FontFace = FONT.Semi, ZIndex = 5,
	})
	table.insert(self.Controls, slot)
	return slot
end

function Section:AddParagraph(info)
	info = info or {}
	return self:AddLabel(("<b>%s</b>\n%s"):format(info.Title or "", info.Text or ""))
end

--=====================================================================
-- 12) THEME / ASSET COMMANDS (change anything at runtime)
--=====================================================================
function Nexo:SetTheme(tbl)
	for k, v in pairs(tbl or {}) do THEME[k] = v end
end
function Nexo:SetAnimation(tbl)
	for k, v in pairs(tbl or {}) do ANIM[k] = v end
end
function Nexo:SetImages(tbl)
	for k, v in pairs(tbl or {}) do IMAGES[k] = tostring(v) end
end
function Window:SetBanner(id) self.Banner.Image = asset(id) end
function Window:SetLogo(id) self.TopBar.HUB_LOGO.Image = asset(id) end
function Window:SetMiniIcon(id) self.ToggleLogo.Image = asset(id) end
function Window:SetTitle(text) self.HomeHeader.Text = text end
function Window:SetSubtitle(text) self.HomeSubtitle.Text = text end

Nexo.Theme = THEME
Nexo.Animations = ANIM
Nexo.Images = IMAGES
Nexo.Geometry = GEO

return Nexo

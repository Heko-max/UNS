function Window:SetVisible(state, instant)
	if state == self.Open then return end
	self.Open = state
	local info = state and ANIM.Open or ANIM.Close
	if instant then info = TweenInfo.new(0) end

	if state then
		self.Main.Visible = true
		Tween(self.Main, info, {
			Size = GEO.OpenSize,
			Position = GEO.OpenPos,
			GroupTransparency = 0,
		})
		Tween(self.Toggle, info, { GroupTransparency = 0.35 })
		self:PlayTransition()
	else
		Tween(self.Main, info, {
			Size = GEO.ClosedSize,
			Position = GEO.ClosedPos,
			GroupTransparency = 1,
		})
		Tween(self.Toggle, info, { GroupTransparency = 0 })
	end
end

function Window:Show()   self:SetVisible(true)  end
function Window:Hide()   self:SetVisible(false) end
function Window:ToggleUI() self:SetVisible(not self.Open) end

-- the wipe + logo flash used by the live UI when it opens or changes page
function Window:PlayTransition()
	local t, lbl = self.Transition, self.Transition.Label
	t.Position = UDim2.fromScale(0, 0.5)
	t.BackgroundTransparency = 0
	lbl.ImageTransparency = 1
	Tween(lbl, TweenInfo.new(0.25), { ImageTransparency = 0 })
	task.delay(0.25, function()
		Tween(lbl, TweenInfo.new(0.2), { ImageTransparency = 1 })
		Tween(t, ANIM.Transition, { Position = UDim2.fromScale(1, 0.5) })
	end)
end

function Window:SelectZone(index, instant)
	self.CurrentZone = index
	for zone, btn in pairs(self.TopButtons) do
		local active = (zone == index)
		Tween(btn.Title, ANIM.Hover, {
			TextColor3 = active and THEME.Accent or THEME.Text,
			TextTransparency = active and 0 or 0.5,
		})
	end
	local goal = UDim2.fromScale(-index, 0)
	if instant then self.Zones.Position = goal
	else Tween(self.Zones, ANIM.TabSlide, { Position = goal }) end
end

function Window:Destroy()
	for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
	pcall(function() self.Gui:Destroy() end)
end


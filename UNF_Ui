			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then
				local delta = input.Position - startInput
				if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then moved = true end
				local v = Camera.ViewportSize
				mini.Position = UDim2.fromOffset(
					math.clamp(startPos.X.Offset + delta.X, 6, math.max(6, v.X - size - 6)),
					math.clamp(startPos.Y.Offset + delta.Y, 6, math.max(6, v.Y - size - 6))
				)
			end
		end))
		self.Maid:Give(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
				if mini.Parent then tw(mini, 0.09, { Size = UDim2.fromOffset(size, size) }) end
			end
		end))
		self.Maid:Give(mini.Activated:Connect(function()
			if moved then moved = false return end
			if NexoUI.Locked then return end
			self:Toggle()
		end))
		self.Maid:Give(mini.MouseEnter:Connect(function()
			tw(mini, Motion.Fast, { BackgroundTransparency = 0 })
			tw(miniStroke, Motion.Fast, { Transparency = 0.35 })
		end))
		self.Maid:Give(mini.MouseLeave:Connect(function()
			tw(mini, Motion.Fast, { BackgroundTransparency = 0.08 })
			tw(miniStroke, Motion.Fast, { Transparency = 0.66 })
		end))
		self.Maid:Give(kill.Activated:Connect(function()
			tw(mini, Motion.Fast, { Size = UDim2.fromOffset(6, 6) })
			task.delay(Motion.Fast + 0.03, function() self:Destroy() end)
		end))

		self:_SyncMini(true)
		return mini
	end


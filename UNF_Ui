		h, s, v = color:ToHSV()
		swatch.BackgroundColor3 = color
		if not silent then
			Util.safe(config.Callback, color, self.Alpha, self)
			self.Changed:Fire(color)
		end
	end

	self.Maid:Give(swatch.Activated:Connect(function()
		if not self.Enabled then return end
		NexoUI.OpenPopup(self.Window, self.Frame, 186, function(panel)
			local t = NexoUI.Theme
			local pad = Util.pad(12, 12, 12, 12)
			pad.Parent = panel

			-- saturation / value square built from two gradients (no assets)
			local square = Util.new("Frame", {
				Size = UDim2.new(1, -34, 0, 120),
				BackgroundColor3 = Color3.fromHSV(h, 1, 1),
				ZIndex = LAYER.Popup + 2,
				Parent = panel,
			}, { Util.corner(8) })
			Util.gradient(Util.cseq({ 0, Color3.new(1, 1, 1) }, { 1, Color3.new(1, 1, 1) }), 0,
				NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })).Parent = square
			local shade = Util.new("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Color3.new(0, 0, 0),
				ZIndex = LAYER.Popup + 3,
				Parent = square,
			}, { Util.corner(8) })
			Util.gradient(Util.cseq({ 0, Color3.new(0, 0, 0) }, { 1, Color3.new(0, 0, 0) }), 90,
				NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })).Parent = shade
			local cursor = Util.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(s, 1 - v),
				Size = UDim2.fromOffset(11, 11),
				BackgroundTransparency = 1,
				ZIndex = LAYER.Popup + 5,
				Parent = square,
			}, { Util.corner(999), Util.stroke(Color3.new(1, 1, 1), 0, 2) })

			-- hue strip
			local hue = Util.new("Frame", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromScale(1, 0),
				Size = UDim2.fromOffset(22, 120),
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = LAYER.Popup + 2,
				Parent = panel,
			}, { Util.corner(8) })
			local hueColors = {}
			for i = 0, 6 do
				table.insert(hueColors, { i / 6, Color3.fromHSV(i / 6, 1, 1) })
			end
			local hueGrad = Util.gradient(Util.cseq(table.unpack(hueColors)), 90)
			hueGrad.Parent = hue
			local hueCursor = Util.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, h),
				Size = UDim2.new(1, 4, 0, 4),
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = LAYER.Popup + 5,
				Parent = hue,
			}, { Util.corner(2) })

			local readout = Util.label({
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(0, 1),
				Size = UDim2.new(1, 0, 0, 22),
				Text = "",
				Font = FONT.Bold,
				TextSize = 12,
				TextColor3 = t.SubText,
				ZIndex = LAYER.Popup + 3,
				Parent = panel,
			})

			local function push()
				local color = Color3.fromHSV(h, s, v)
				square.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
				cursor.Position = UDim2.fromScale(s, 1 - v)
				hueCursor.Position = UDim2.fromScale(0.5, h)
				swatch.BackgroundColor3 = color
				self.Value = color
				readout.Text = ("RGB %d, %d, %d"):format(
					math.floor(color.R * 255 + 0.5),
					math.floor(color.G * 255 + 0.5),
					math.floor(color.B * 255 + 0.5))
				Util.safe(config.Callback, color, self.Alpha, self)
				self.Changed:Fire(color)
			end
			push()

			local draggingSquare, draggingHue = false, false
			square.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then draggingSquare = true end
			end)
			hue.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then draggingHue = true end
			end)
			local moveConn, endConn
			moveConn = UserInputService.InputChanged:Connect(function(input)
				if not panel.Parent then moveConn:Disconnect() return end
				if input.UserInputType ~= Enum.UserInputType.MouseMovement
					and input.UserInputType ~= Enum.UserInputType.Touch then return end
				if draggingSquare then
					s = math.clamp((input.Position.X - square.AbsolutePosition.X) / math.max(square.AbsoluteSize.X, 1), 0, 1)
					v = 1 - math.clamp((input.Position.Y - square.AbsolutePosition.Y) / math.max(square.AbsoluteSize.Y, 1), 0, 1)
					push()
				elseif draggingHue then
					h = math.clamp((input.Position.Y - hue.AbsolutePosition.Y) / math.max(hue.AbsoluteSize.Y, 1), 0, 1)
					push()
				end
			end)
			endConn = UserInputService.InputEnded:Connect(function(input)
				if not panel.Parent then endConn:Disconnect() return end
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					draggingSquare, draggingHue = false, false
				end
			end)
			self.Maid:Give(moveConn)
			self.Maid:Give(endConn)
		end)
	end))
	return self
end)


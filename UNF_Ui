function Util.label(props)
	local p = props or {}
	if p.BackgroundTransparency == nil then p.BackgroundTransparency = 1 end
	p.Font = p.Font or FONT.Medium
	p.TextSize = p.TextSize or 14
	p.TextXAlignment = p.TextXAlignment or Enum.TextXAlignment.Left
	p.TextYAlignment = p.TextYAlignment or Enum.TextYAlignment.Center
	return Util.new("TextLabel", p)
end

-- ------- value normalisation (never crash on bad user input) -------

-- Accepts 123, "123", "rbxassetid://123", rbxthumb / rbxgameasset / http urls.
function Util.image(id)
	if id == nil then return "" end
	local t = typeof(id)
	if t == "number" then
		if id <= 0 then return "" end
		return "rbxassetid://" .. string.format("%d", math.floor(id))
	end
	if t ~= "string" then return "" end
	local s = (id:gsub("%s", ""))
	if s == "" then return "" end
	if s:match("^%d+$") then return "rbxassetid://" .. s end
	if s:match("^rbxassetid://%d+$")
		or s:match("^rbxthumb://")
		or s:match("^rbxgameasset://")
		or s:match("^rbxasset://")
		or s:match("^https?://") then
		return s
	end
	Util.warn("unrecognised image id '" .. s .. "' - ignored")
	return ""
end

-- Accepts Color3, {r,g,b} or "#rrggbb".
function Util.color(v, fallback)
	if typeof(v) == "Color3" then return v end
	if typeof(v) == "table" and tonumber(v[1]) then
		return Color3.fromRGB(tonumber(v[1]) or 0, tonumber(v[2]) or 0, tonumber(v[3]) or 0)
	end
	if typeof(v) == "string" then
		local hex = v:gsub("#", "")
		if #hex == 6 then
			local r, g, b = tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16)
			if r and g and b then return Color3.fromRGB(r, g, b) end
		end
	end
	if v ~= nil then Util.warn("invalid colour value - using default") end
	return fallback or Color3.new(1, 1, 1)
end

function Util.round(n, step)
	if not step or step <= 0 then return n end
	return math.floor(n / step + 0.5) * step
end

-- Decimal places implied by an increment (0.05 -> 2, 1 -> 0).
function Util.decimals(step)
	if not step or step >= 1 then return 0 end
	local s = tostring(step)
	local dot = s:find("%.")
	if not dot then return 0 end
	return math.min(#s - dot, 4)
end

function Util.isMobile()
	return UserInputService.TouchEnabled and not UserInputService.MouseEnabled
end

-- ---------------------------------------------------------------- 3. maid
local Maid = {}
Maid.__index = Maid
NexoUI.Maid = Maid

function Maid.new()
	return setmetatable({ _tasks = {} }, Maid)
end

-- Accepts connections, instances, functions and objects with :Destroy().
function Maid:Give(item)
	if item ~= nil then table.insert(self._tasks, item) end
	return item
end

function Maid:Clean()
	for i = #self._tasks, 1, -1 do
		local item = self._tasks[i]
		self._tasks[i] = nil
		local t = typeof(item)
		if t == "RBXScriptConnection" then
			pcall(function() item:Disconnect() end)
		elseif t == "Instance" then
			pcall(function() item:Destroy() end)
		elseif t == "function" then
			pcall(item)
		elseif t == "table" and typeof(item.Destroy) == "function" then
			pcall(function() item:Destroy() end)
		end
	end
end
Maid.Destroy = Maid.Clean

-- ---------------------------------------------------------------- 4. signal
local Signal = {}
Signal.__index = Signal
NexoUI.Signal = Signal

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	if typeof(fn) ~= "function" then return { Disconnect = function() end } end
	table.insert(self._handlers, fn)
	local handlers = self._handlers
	return {
		Disconnect = function()
			for i, h in ipairs(handlers) do
				if h == fn then table.remove(handlers, i) break end
			end
		end,
	}
end

function Signal:Fire(...)
	for _, fn in ipairs(table.clone(self._handlers)) do
		Util.safe(fn, ...)
	end
end

function Signal:Destroy()
	table.clear(self._handlers)
end


		row.MouseLeave:Connect(function()
			Util.tween(row, 0.14, { BackgroundTransparency = 0.6 })
		end)
		row.Activated:Connect(function()
			Util.safe(item.Callback)
			close()
		end)
	end
	return { Close = close, Frame = panel }
end


-- =====================================================================
--  28. PLUGIN / EXTENSION SYSTEM
-- =====================================================================
NexoUI.Plugins = {}

function NexoUI:RegisterPlugin(plugin)
	if typeof(plugin) ~= "table" or not plugin.Name then
		Util.warn("RegisterPlugin needs { Name = ... }")
		return nil
	end
	local name = tostring(plugin.Name)
	if NexoUI.Plugins[name] then
		Util.warn("plugin '" .. name .. "' is already registered")
		return NexoUI.Plugins[name]
	end
	local record = {
		Name = name,
		Version = tostring(plugin.Version or "1.0.0"),
		Components = {},
		Themes = {},
		Commands = {},
		Source = plugin,
	}
	for componentName, builder in pairs(plugin.Components or {}) do
		if NexoUI:RegisterComponent(componentName, builder) ~= false then
			table.insert(record.Components, componentName)
		end
	end
	for themeName, palette in pairs(plugin.Themes or {}) do
		NexoUI:AddTheme(themeName, palette)
		table.insert(record.Themes, themeName)
	end
	for _, command in ipairs(plugin.Commands or {}) do
		local created = NexoUI:RegisterCommand(command)
		if created then table.insert(record.Commands, created) end
	end
	if typeof(plugin.Init) == "function" then
		Util.safe(plugin.Init, NexoUI)
	end
	NexoUI.Plugins[name] = record
	NexoUI.FireHook("PluginRegistered", record)
	return record
end

function NexoUI:GetPlugin(name) return NexoUI.Plugins[tostring(name)] end

function NexoUI:ListPlugins()
	local names = {}
	for name in pairs(NexoUI.Plugins) do table.insert(names, name) end
	table.sort(names)
	return names
end

function NexoUI:UnloadPlugin(name)
	local record = NexoUI.Plugins[tostring(name)]
	if not record then return false end
	for _, componentName in ipairs(record.Components) do
		NexoUI.Components[componentName] = nil
	end
	for _, command in ipairs(record.Commands) do
		NexoUI:UnregisterCommand(command)
	end
	if typeof(record.Source.Unload) == "function" then
		Util.safe(record.Source.Unload, NexoUI)
	end
	NexoUI.Plugins[tostring(name)] = nil
	return true
end

-- Adds extra methods to an existing component type without touching core.
function NexoUI:ExtendComponent(typeName, methods)
	local builder = NexoUI.Components[tostring(typeName)]
	if not builder or typeof(methods) ~= "table" then
		Util.warn("ExtendComponent needs an existing component type and a method table")
		return false
	end
	NexoUI.Components[tostring(typeName)] = function(container, config)
		local component = builder(container, config)
		if component then
			for key, fn in pairs(methods) do component[key] = fn end
		end
		return component
	end
	return true
end

-- Convenience wrappers so scripts can stay on one object.
function Window:OpenCommandPalette() return NexoUI:OpenCommandPalette() end
function Window:CreateRestorePoint(name) return NexoUI:CreateRestorePoint(name) end
function Window:Restore(name) return NexoUI:Restore(name) end

-- =====================================================================
--  30. NEXO UI 2.1  -  COMPACT SHELL, COLOUR ENGINE, UNIFIED MOTION
--  Everything here layers on top of the core above. No core feature is
--  removed: every public function keeps its old name and signature.
-- =====================================================================
do
	local Motion = {
		Fast  = 0.11,
		Base  = 0.17,
		Slow  = 0.24,
		Style = Enum.EasingStyle.Quart,
		Dir   = Enum.EasingDirection.Out,
	}
	NexoUI.Motion = Motion
	NexoUI.Version = "2.1.0"
	NexoUI.Locked = false

	local function tw(inst, dur, goal, style)
		return Util.tween(inst, dur or Motion.Base, goal, style or Motion.Style, Motion.Dir)
	end
	NexoUI.Motion.Tween = tw

	local WHITE = Color3.new(1, 1, 1)
	local BLACK = Color3.new(0, 0, 0)
	local RED   = Color3.fromRGB(255, 48, 64)

	local function mix(a, b, t)
		return Color3.new(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t)
	end
	local function shade(c, t) return mix(c, BLACK, t) end
	local function tint(c, t) return mix(c, WHITE, t) end

	local function toColor(v)
		if typeof(v) == "Color3" then return v end
		if typeof(v) == "string" then
			local hex = v:gsub("#", "")
			if #hex == 6 or #hex == 3 then
				local ok, c = pcall(Color3.fromHex, hex)
				if ok then return c end
			end
			local preset = NexoUI.Themes[v]
			if preset then return preset.Accent end
		elseif typeof(v) == "table" and #v >= 3 then
			local ok, c = pcall(Color3.fromRGB, v[1], v[2], v[3])
			if ok then return c end
		end
		return nil
	end
	NexoUI.ToColor = toColor

	-- ------------------------------------------------------------------
	--  COLOUR CUSTOMISATION  (1 colour, or a 2 - 5 colour blend)
	-- ------------------------------------------------------------------
	local function collect(...)
		local input = { ... }
		if #input == 1 and typeof(input[1]) == "table" and typeof(input[1]) ~= "Color3" then
			if input[1].Colors then
				input = input[1].Colors
			elseif #input[1] > 0 and typeof(input[1][1]) ~= "number" then
				input = input[1]
			end
		end
		local out = {}
		for _, v in ipairs(input) do
			local c = toColor(v)
			if c then
				table.insert(out, c)
				if #out >= 5 then break end
			end
		end
		return out
	end

	local function sequence(colors)
		if #colors <= 1 then
			local c = colors[1] or NexoUI.Theme.Accent
			return Util.cseq({ 0, tint(c, 0.2) }, { 1, shade(c, 0.42) })
		end
		local points = {}
		for i, c in ipairs(colors) do
			table.insert(points, { (i - 1) / (#colors - 1), c })
		end
		return Util.cseq(table.unpack(points))
	end
	NexoUI.ColorSequenceFrom = sequence

	-- gradients that should span the whole multi colour palette
	local tracked = setmetatable({}, { __mode = "k" })
	function NexoUI.TrackGradient(gradient)
		if typeof(gradient) ~= "Instance" then return gradient end
		tracked[gradient] = true
		if NexoUI.Gradient then pcall(function() gradient.Color = NexoUI.Gradient end) end
		return gradient
	end

	local coreApplyTheme = NexoUI.ApplyTheme
	function NexoUI.ApplyTheme()
		coreApplyTheme()
		if not NexoUI.Gradient then return end
		for gradient in pairs(tracked) do
			if typeof(gradient) == "Instance" and gradient.Parent then
				pcall(function() gradient.Color = NexoUI.Gradient end)
			else
				tracked[gradient] = nil
			end
		end
	end

	-- Library:SetColors(c1)  /  SetColors(c1, c2, c3)  /  SetColors({ ... })
	function NexoUI:SetColors(...)
		local colors = collect(...)
		if #colors == 0 then
			Util.warn("SetColors expects 1 to 5 colours (Color3, '#RRGGBB' or {r,g,b})")
			return NexoUI.Theme
		end
		local c1 = colors[1]
		local c2 = colors[2] or tint(c1, 0.28)
		local last = colors[#colors]
		local palette = {
			Name          = "Custom",
			Background    = shade(c1, 0.955),
			BackgroundAlt = shade(c1, 0.925),
			Panel         = shade(c1, 0.9),
			PanelAlt      = shade(c1, 0.85),
			Field         = shade(c1, 0.915),
			Border        = c1,
			Accent        = c1,
			AccentLight   = tint(c1, 0.22),
			AccentDark    = shade(last, 0.32),
			Text          = tint(c1, 0.93),
			SubText       = tint(shade(c1, 0.1), 0.7),
			MutedText     = mix(tint(c1, 0.45), Color3.fromRGB(150, 150, 150), 0.6),
			Button        = shade(c1, 0.885),
			ButtonHover   = shade(c1, 0.78),
			Toggle        = shade(c1, 0.9),
			ToggleOn      = c1,
			Knob          = tint(c1, 0.95),
			KnobOff       = shade(tint(c1, 0.35), 0.5),
			Slider        = shade(c1, 0.83),
			Tab           = shade(c1, 0.9),
			TabActive     = shade(c2, 0.28),
			Notification  = shade(c1, 0.94),
			Info          = c2,
			Shadow        = shade(c1, 0.22),
		}
		NexoUI.Colors = colors
		NexoUI.Gradient = sequence(colors)
		return NexoUI:SetTheme(palette)
	end
	NexoUI.SetPalette = NexoUI.SetColors

	function NexoUI:SetAccent(color) return NexoUI:SetColors(color) end
	function NexoUI:GetColors() return NexoUI.Colors or { NexoUI.Theme.Accent } end

	function NexoUI:AddColorTheme(name, ...)
		local current = Util.copy(NexoUI.Theme)
		local built = NexoUI:SetColors(...)
		local saved = Util.copy(built)
		saved.Name = tostring(name)
		NexoUI.Themes[tostring(name)] = saved
		NexoUI:SetTheme(current)
		return saved
	end

	-- Ready made colour panel: Window:CreateThemeTab()
	function Window:CreateThemeTab(config)
		config = typeof(config) == "table" and config or {}
		local tab = self:CreateTab({ Name = config.Name or "Theme", Icon = config.Icon })
		if not tab then return nil end
		local section = tab:CreateSection({ Name = config.SectionName or "Interface colours" })
		if not section then return tab end
		local chosen = {}
		local used = {}
		local current = NexoUI:GetColors()
		for i = 1, 5 do
			chosen[i] = current[i] or (i == 1 and NexoUI.Theme.Accent or nil)
			used[i] = current[i] ~= nil
		end
		used[1] = true
		local function apply()
			local list = {}
			for i = 1, 5 do
				if used[i] and chosen[i] then table.insert(list, chosen[i]) end
			end
			if #list > 0 then NexoUI:SetColors(list) end
		end
		for i = 1, 5 do
			Util.safe(function()
				section:CreateColorPicker({
					Name = i == 1 and "Primary colour" or ("Colour " .. i),
					Description = i == 1 and "Drives the whole interface" or "Part of the multi colour blend",
					Default = chosen[i] or NexoUI.Theme.Accent,
					Callback = function(color)
						chosen[i] = color
						if i == 1 then used[1] = true end
						apply()
					end,
				})
			end)
			if i > 1 then
				Util.safe(function()
					section:CreateToggle({
						Name = "Use colour " .. i,
						Default = used[i] == true,
						Callback = function(state)
							used[i] = state and true or false
							apply()
						end,
					})
				end)
			end
		end
		Util.safe(function()
			section:CreateButton({ Name = "Apply colours", Callback = apply })
		end)
		return tab
	end

	-- ------------------------------------------------------------------
	--  SCROLLBARS + BOUNDS
	-- ------------------------------------------------------------------
	local function polishScroll(frame)
		if typeof(frame) ~= "Instance" or not frame:IsA("ScrollingFrame") then return end
		pcall(function()
			if frame.ScrollBarThickness > 0 then frame.ScrollBarThickness = 4 end
			frame.ScrollBarImageTransparency = 0.3
			frame.ScrollBarImageColor3 = NexoUI.Theme.Accent
			frame.BorderSizePixel = 0
			frame.ElasticBehavior = Enum.ElasticBehavior.Never
			frame.ClipsDescendants = true
			frame.VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar
		end)
	end
	NexoUI.PolishScroll = polishScroll

	-- ------------------------------------------------------------------
	--  ONE UNIFIED SHELL  (every layer fades / scales as a single unit)
	-- ------------------------------------------------------------------
	local function makeShell(gui)
		local ok, group = pcall(Instance.new, "CanvasGroup")
		if ok and group then
			local built = pcall(function()
				group.Name = "Shell"
				group.BackgroundTransparency = 1
				group.BorderSizePixel = 0
				group.Size = UDim2.fromScale(1, 1)
				group.GroupTransparency = 0
				group.ZIndex = 1
				group.Parent = gui
			end)
			if built then return group, true end
			pcall(function() group:Destroy() end)
		end
		return Util.new("Frame", {
			Name = "Shell",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 1,
			Parent = gui,
		}), false
	end

	function Window:_Fade(alpha, duration)
		if self.ShellGroup and self.Shell then
			tw(self.Shell, duration, { GroupTransparency = alpha })
		else
			tw(self.Main, duration, { BackgroundTransparency = alpha >= 1 and 1 or (self.BackgroundAlpha or 0.22) })
			if self.Root then self.Root.Visible = alpha < 1 end
		end
	end

	function Window:Show()
		if NexoUI.Locked then return self end
		self.Visible = true
		if self.Shell then self.Shell.Visible = true end
		self.Root.Visible = true
		self:_Refresh()
		local target = self.Scale.Scale
		self.Scale.Scale = target * 0.96
		if self.ShellGroup then self.Shell.GroupTransparency = 1 end
		self:_Fade(0, Motion.Base)
		tw(self.Scale, Motion.Base, { Scale = target })
		task.delay(Motion.Base + 0.05, function()
			if self.Visible and self.Gui and self.Gui.Parent then self:_Refresh() end
		end)
		self:_SyncMini()
		self.OnToggle:Fire(true)
		return self
	end

	function Window:Hide()
		self.Visible = false
		local target = self.Scale.Scale
		self:_Fade(1, Motion.Base)
		tw(self.Scale, Motion.Base, { Scale = target * 0.96 })
		task.delay(Motion.Base + 0.03, function()
			if self.Visible or not self.Root then return end
			if self.Shell then self.Shell.Visible = false end
			self.Root.Visible = false
			self.Scale.Scale = target
			if self.ShellGroup then self.Shell.GroupTransparency = 0 end
		end)
		self:_SyncMini()
		self.OnToggle:Fire(false)
		return self
	end

	function Window:Toggle()
		if NexoUI.Locked then return self end
		if self.Visible then self:Hide() else self:Show() end
		return self
	end

	function Window:SetTransparency(alpha)
		self.BackgroundAlpha = math.clamp(tonumber(alpha) or 0.22, 0, 0.95)
		if self.Main then self.Main.BackgroundTransparency = self.BackgroundAlpha end
		if self.Sidebar then self.Sidebar.BackgroundTransparency = math.clamp(self.BackgroundAlpha + 0.32, 0, 0.96) end
		if self.TopBar then self.TopBar.BackgroundTransparency = math.clamp(self.BackgroundAlpha + 0.3, 0, 0.96) end
		return self
	end

	-- ------------------------------------------------------------------
	--  LAYOUT: top tab bar + left section rail
	-- ------------------------------------------------------------------
	function Window:_ApplyLayoutMode()
		local narrow = self.Narrow
		local width = narrow and 56 or self.SidebarWidth
		local top = self.TopBar and (self.TopBarHeight or 0) or 0
		tw(self.Sidebar, Motion.Base, {
			Position = UDim2.fromOffset(0, top),
			Size = UDim2.new(0, width, 1, -top),
		})
		if not self.Minimized then
			tw(self.Body, Motion.Base, {
				Position = UDim2.fromOffset(width, top),
				Size = UDim2.new(1, -width, 1, -top),
			})
		end
		if self.BrandText then self.BrandText.Visible = not narrow end
		if self.BrandSub then self.BrandSub.Visible = not narrow and self.Config.Subtitle ~= nil end
		if self.NavCaption then self.NavCaption.Visible = not narrow end
		for _, tab in ipairs(self.Tabs) do
			if tab._SetCompact then
				Util.safe(function() tab:_SetCompact(narrow and not self.TopBar) end)
			end
		end
		for _, entry in ipairs(self.NavEntries or {}) do
			if entry.Label then entry.Label.Visible = not narrow end
		end
		for _, row in ipairs(self.ColumnRows) do
			if row and row.Parent then NexoUI.LayoutColumns(row, narrow) end
		end
	end

	local function refreshNav(win)
		if not win.NavEntries then return end
		local order = 0
		for _, entry in ipairs(win.NavEntries) do
			if entry.Button and entry.Button.Parent then
				local alive = entry.Section and entry.Section.Frame and entry.Section.Frame.Parent ~= nil
				local on = alive and entry.Tab == win.ActiveTab
				entry.Button.Visible = on and true or false
				if on then
					order = order + 1
					entry.Button.LayoutOrder = order
				end
			end
		end
	end

	local function addNavEntry(win, tab, section)
		if not win or not win.SectionNav or not tab or not section then return end
		local theme = NexoUI.Theme
		local button = Util.new("TextButton", {
			Name = "Nav",
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundColor3 = theme.Tab,
			BackgroundTransparency = 1,
			Visible = win.ActiveTab == tab,
			LayoutOrder = #win.NavEntries + 1,
			ZIndex = LAYER.Content + 4,
			Parent = win.SectionNav,
		}, { Util.corner(8) })
		local dot = Util.new("Frame", {
			Name = "Dot",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 8, 0.5, 0),
			Size = UDim2.fromOffset(4, 4),
			BackgroundColor3 = theme.Accent,
			BackgroundTransparency = 0.3,
			ZIndex = LAYER.Content + 5,
			Parent = button,
		}, { Util.corner(999) })
		local label = Util.label({
			Name = "Label",
			Position = UDim2.fromOffset(18, 0),
			Size = UDim2.new(1, -24, 1, 0),
			Text = tostring(section.Name or "Section"),
			Font = FONT.Medium,
			TextSize = 11.5,
			TextColor3 = theme.SubText,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = LAYER.Content + 5,
			Parent = button,
		})
		local entry = { Button = button, Label = label, Dot = dot, Tab = tab, Section = section }
		table.insert(win.NavEntries, entry)

		win.Maid:Give(button.MouseEnter:Connect(function()
			tw(button, Motion.Fast, { BackgroundTransparency = 0.86 })
			tw(label, Motion.Fast, { TextColor3 = NexoUI.Theme.Text })
		end))
		win.Maid:Give(button.MouseLeave:Connect(function()
			tw(button, Motion.Fast, { BackgroundTransparency = 1 })
			tw(label, Motion.Fast, { TextColor3 = NexoUI.Theme.SubText })
		end))
		win.Maid:Give(button.Activated:Connect(function()
			win:SelectTab(tab)
			local page, frame = tab.Page, section.Frame
			if page and frame and frame.Parent then
				local offset = frame.AbsolutePosition.Y - page.AbsolutePosition.Y + page.CanvasPosition.Y - 6
				tw(page, Motion.Base, { CanvasPosition = Vector2.new(0, math.max(offset, 0)) })
			end
			tw(dot, Motion.Fast, { Size = UDim2.fromOffset(6, 6), BackgroundTransparency = 0 })
			task.delay(Motion.Fast, function()
				if dot.Parent then tw(dot, Motion.Fast, { Size = UDim2.fromOffset(4, 4), BackgroundTransparency = 0.3 }) end
			end)
		end))
		win.Maid:Give(Util.onTheme(function(t)
			if not button.Parent then return end
			button.BackgroundColor3 = t.Tab
			label.TextColor3 = t.SubText
			dot.BackgroundColor3 = t.Accent
		end))
		refreshNav(win)
		return entry
	end

	local function buildTopBar(win)
		local theme = NexoUI.Theme
		win.TopBarHeight = 30
		local bar = Util.new("Frame", {
			Name = "TopBar",
			Size = UDim2.new(1, 0, 0, win.TopBarHeight),
			BackgroundColor3 = theme.Panel,
			BackgroundTransparency = math.clamp((win.BackgroundAlpha or 0.22) + 0.3, 0, 0.96),
			ClipsDescendants = true,
			Active = true,
			ZIndex = LAYER.Header + 3,
			Parent = win.Main,
		})
		Util.new("Frame", {
			Name = "Line",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = theme.Border,
			BackgroundTransparency = 0.82,
			ZIndex = LAYER.Header + 5,
			Parent = bar,
		})
		win.TopBar = bar
		win:_BindDrag(bar)

		-- the old vertical rail becomes the horizontal tab strip
		local rail = win.TabList
		if rail then
			rail.Parent = bar
			rail.Position = UDim2.fromOffset(0, 0)
			rail.Size = UDim2.fromScale(1, 1)
			rail.ScrollingDirection = Enum.ScrollingDirection.X
			rail.AutomaticCanvasSize = Enum.AutomaticSize.X
			rail.CanvasSize = UDim2.new()
			rail.ScrollBarThickness = 0
			rail.ClipsDescendants = true
			rail.ZIndex = LAYER.Header + 4
			local list = rail:FindFirstChildOfClass("UIListLayout")
			if list then
				list.FillDirection = Enum.FillDirection.Horizontal
				list.VerticalAlignment = Enum.VerticalAlignment.Center
				list.Padding = UDim.new(0, 4)
			end
			local pad = rail:FindFirstChildOfClass("UIPadding")
			if pad then
				pad.PaddingTop = UDim.new(0, 0)
				pad.PaddingBottom = UDim.new(0, 0)
				pad.PaddingLeft = UDim.new(0, 6)
				pad.PaddingRight = UDim.new(0, 6)
			end
		end

		-- the left column keeps the categories / sections
		win.NavCaption = Util.label({
			Name = "NavCaption",
			Position = UDim2.fromOffset(10, 56),
			Size = UDim2.new(1, -20, 0, 12),
			Text = "SECTIONS",
			Font = FONT.Bold,
			TextSize = 9.5,
			TextColor3 = theme.MutedText,
			ZIndex = LAYER.Content + 3,
			Parent = win.Sidebar,
		})
		win.SectionNav = Util.new("ScrollingFrame", {
			Name = "SectionNav",
			Position = UDim2.fromOffset(0, 70),
			Size = UDim2.new(1, 0, 1, -94),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 4,
			ScrollBarImageColor3 = theme.Accent,
			ScrollBarImageTransparency = 0.35,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ElasticBehavior = Enum.ElasticBehavior.Never,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ClipsDescendants = true,
			ZIndex = LAYER.Content + 3,
			Parent = win.Sidebar,
		}, { Util.list(3), Util.pad(2, 8, 8, 8) })
		polishScroll(win.SectionNav)
		win.NavEntries = {}
		win.Maid:Give(win.OnTabChanged:Connect(function() refreshNav(win) end))
		win.Maid:Give(Util.onTheme(function(t)
			if not bar.Parent then return end
			bar.BackgroundColor3 = t.Panel
			if win.NavCaption then win.NavCaption.TextColor3 = t.MutedText end
			if win.SectionNav then win.SectionNav.ScrollBarImageColor3 = t.Accent end
		end))
	end

	-- ------------------------------------------------------------------
	--  MINIMISE  (header always stays painted - never a black box)
	-- ------------------------------------------------------------------
	function Window:Minimize(state)
		if state == nil then state = not self.Minimized end
		self.Minimized = state and true or false
		local small = self.Minimized
		local width = self.Narrow and 56 or self.SidebarWidth
		local top = self.TopBar and (self.TopBarHeight or 0) or 0

		-- the shell, the body and the header must always stay visible
		self.Main.Visible = true
		self.Main.BackgroundTransparency = self.BackgroundAlpha or 0.22
		self.Body.Visible = true
		self.Header.Visible = true
		self.Sidebar.Visible = not small
		self.Pages.Visible = not small
		if self.TopBar then self.TopBar.Visible = not small end
		if self.SubBarHolder then self.SubBarHolder.Visible = not small end
		if self.ResizeGrip then self.ResizeGrip.Visible = not small end

		if small then
			self.Body.Position = UDim2.fromOffset(0, 0)
			self.Body.Size = UDim2.new(1, 0, 1, 0)
		else
			self.Body.Position = UDim2.fromOffset(width, top)
			self.Body.Size = UDim2.new(1, -width, 1, -top)
		end

		local height = small and self.HeaderHeight or nil
		self:_Refresh()
		if height then
			tw(self.Root, Motion.Base, { Size = UDim2.fromOffset(self.BaseSize.X, height) })
		end
		if self.MinimizeIcon then
			tw(self.MinimizeIcon, Motion.Fast, { Rotation = small and 180 or 0 })
		end
		return self
	end

	-- ------------------------------------------------------------------
	--  MINI BUTTON: red orb, white laser ring, instant X toggle
	-- ------------------------------------------------------------------
	function Window:_SyncMini(instant)
		local parts = self.MiniParts
		if not parts or not parts.Root or not parts.Root.Parent then return end
		local open = self.Visible and true or false
		local dur = instant and 0 or Motion.Fast
		for _, bar in ipairs(parts.XBars) do
			tw(bar, dur, { BackgroundTransparency = open and 0 or 1, Rotation = bar:GetAttribute("Base") + (open and 0 or 45) })
		end
		if parts.Letter then tw(parts.Letter, dur, { TextTransparency = open and 1 or 0 }) end
		if parts.Ring then tw(parts.Ring, dur, { Transparency = open and 0.8 or 0.32 }) end
		if parts.Dot then tw(parts.Dot, dur, { BackgroundTransparency = open and 0.75 or 0 }) end
		if parts.Trail then tw(parts.Trail, dur, { BackgroundTransparency = open and 0.9 or 0.45 }) end
	end


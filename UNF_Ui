	local logoId = Util.image(config.Logo or config.Image)
	if logoId ~= "" then
		local img = Util.imageObject({ Image = logoId, Size = config.LogoSize or 46, Corner = 10, LayoutOrder = 1 }, 46)
		img.ZIndex = 4
		img.Parent = panel
	end
	Util.label({
		Size = UDim2.new(1, 0, 0, 24),
		Text = tostring(config.Title or "Loading"),
		Font = FONT.Black,
		TextSize = 18,
		TextColor3 = theme.Text,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 2,
		ZIndex = 4,
		Parent = panel,
	})
	local statusLabel = Util.label({
		Size = UDim2.new(1, 0, 0, 18),
		Text = tostring(config.Status or config.Subtitle or "Preparing..."),
		Font = FONT.Medium,
		TextSize = 12.5,
		TextColor3 = theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 3,
		ZIndex = 4,
		Parent = panel,
	})
	local track = Util.new("Frame", {
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = theme.Slider,
		LayoutOrder = 4,
		ZIndex = 4,
		Parent = panel,
	}, { Util.corner(999) })
	local fill = Util.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = theme.Accent,
		ZIndex = 5,
		Parent = track,
	}, { Util.corner(999) })
	Util.gradient(Util.cseq({ 0, theme.AccentDark }, { 1, theme.AccentLight }), 0).Parent = fill
	local percent = Util.label({
		Size = UDim2.new(1, 0, 0, 16),
		Text = "0%",
		Font = FONT.Bold,
		TextSize = 12,
		TextColor3 = theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 5,
		ZIndex = 4,
		Parent = panel,
	})

	local steps = config.Steps or {}
	local screen = { Gui = gui, Panel = panel, Progress = 0, StepIndex = 0, Steps = steps }

	function screen:SetProgress(alpha, text)
		alpha = math.clamp(tonumber(alpha) or 0, 0, 1)
		self.Progress = alpha
		Util.tween(fill, 0.25, { Size = UDim2.fromScale(alpha, 1) })
		percent.Text = tostring(math.floor(alpha * 100)) .. "%"
		if text then statusLabel.Text = tostring(text) end
		return self
	end
	function screen:SetStatus(text)
		statusLabel.Text = tostring(text or "")
		return self
	end
	function screen:SetTitle(text)
		panel:FindFirstChildWhichIsA("TextLabel").Text = tostring(text or "")
		return self
	end
	function screen:NextStep(text)
		self.StepIndex = self.StepIndex + 1
		local total = math.max(#self.Steps, self.StepIndex)
		local label = text or self.Steps[self.StepIndex]
		return self:SetProgress(self.StepIndex / total, label)
	end
	function screen:Finish(callback)
		self:SetProgress(1, config.FinishText or "Ready")
		task.delay(0.35, function()
			Util.tween(panel, 0.25, { Size = UDim2.fromOffset(panel.AbsoluteSize.X, 0) })
			task.delay(0.3, function()
				pcall(function() gui:Destroy() end)
				Util.safe(callback)
				Util.safe(config.OnFinish)
			end)
		end)
		return self
	end
	function screen:Destroy() pcall(function() gui:Destroy() end) end

	if config.Auto then
		task.spawn(function()
			local duration = tonumber(config.Duration) or 2
			local total = math.max(#steps, 1)
			for index = 1, total do
				task.wait(duration / total)
				if not gui.Parent then return end
				screen:NextStep()
			end
			screen:Finish()
		end)
	end
	return screen
end


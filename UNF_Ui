		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -12),
		Size = UDim2.fromOffset(238, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = LAYER.Toast,
		Parent = self.Gui,
	})
	local toastList = Util.list(10)
	toastList.VerticalAlignment = Enum.VerticalAlignment.Bottom
	toastList.HorizontalAlignment = Enum.HorizontalAlignment.Right
	toastList.Parent = self.ToastLayer

	-- resize grip ---------------------------------------------------------
	if config.Resizable ~= false then
		local grip = Util.new("TextButton", {
			Name = "Resize",
			Text = "",
			AutoButtonColor = false,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.fromScale(1, 1),
			Size = UDim2.fromOffset(18, 18),
			BackgroundTransparency = 1,
			ZIndex = LAYER.Header + 2,
			Parent = self.Main,
		})
		for i = 1, 2 do
			Util.new("Frame", {
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -4, 1, -4),
				Size = UDim2.fromOffset(i * 5, 1.6),
				Rotation = -45,
				BackgroundColor3 = theme.MutedText,
				BackgroundTransparency = 0.35,
				ZIndex = LAYER.Header + 2,
				Parent = grip,
			}, { Util.corner(1) })
		end
		local resizing, startPos, startSize = false, nil, nil
		self.ResizeGrip = grip
		self.Maid:Give(grip.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				resizing = true
				startPos = input.Position
				startSize = self.BaseSize
			end
		end))
		self.Maid:Give(UserInputService.InputChanged:Connect(function(input)
			if not resizing or not self.Gui.Parent then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then
				local delta = input.Position - startPos
				local scale = math.max(self.Scale.Scale, 0.05)
				self.BaseSize = Vector2.new(
					math.clamp(startSize.X + delta.X / scale, 360, 1600),
					math.clamp(startSize.Y + delta.Y / scale, 230, 1000)
				)
				self:_Refresh()
			end
		end))
		self.Maid:Give(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				resizing = false
			end
		end))
	end

	-- theme repaint hook for the shell
	self.Maid:Give(Util.onTheme(function(t)
		if not self.Main or not self.Main.Parent then return end
		self.Main.BackgroundColor3 = t.Background
		mainStroke.Color = t.Border
		mainGrad.Color = Util.cseq({ 0, t.BackgroundAlt }, { 0.5, t.Background }, { 1, t.BackgroundAlt })
		self.Sidebar.BackgroundColor3 = t.Panel
		self.BrandText.TextColor3 = t.Text
		self.BrandSub.TextColor3 = t.MutedText
		self.FooterLabel.TextColor3 = t.MutedText
		self.SearchBox.BackgroundColor3 = t.Field
		self.SearchBox.TextColor3 = t.Text
	end))

	-- dragging, responsiveness, keybind ------------------------------------
	self:_BindDrag(self.Brand)
	self:_BindDrag(self.Header)

	local pending = false
	self.Maid:Give(Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		if pending then return end
		pending = true
		task.delay(0.08, function()
			pending = false
			self:_Refresh()
		end)
	end))

	local toggleKey = config.ToggleKey
	if toggleKey == nil then toggleKey = Enum.KeyCode.RightControl end
	if typeof(toggleKey) == "EnumItem" then
		self.ToggleKey = toggleKey
		self.Maid:Give(UserInputService.InputBegan:Connect(function(input, processed)
			if processed then return end
			if input.KeyCode == self.ToggleKey then self:Toggle() end
		end))
	end

	-- floating mini button: reopens the window and can remove the interface
	if config.MiniButton ~= false then
		self:_BuildMiniButton()
	end

	table.insert(NexoUI.Windows, self)
	self:_Refresh()

	-- entrance animation
	self.Main.BackgroundTransparency = 1
	task.spawn(function()
		task.wait()
		self:_Refresh()
		local target = self.Scale.Scale
		self.Scale.Scale = target * 0.93
		Util.tween(self.Main, 0.26, { BackgroundTransparency = self.BackgroundAlpha or 0.22 })
		Util.tween(self.Scale, 0.42, { Scale = target }, Enum.EasingStyle.Back)
	end)

	return self
end

-- Floating launcher: click to show/hide, drag to move, red badge to remove.
function Window:_BuildMiniButton()
	local theme = NexoUI.Theme
	local vp = Camera.ViewportSize
	local mini = Util.new("TextButton", {
		Name = "Mini",

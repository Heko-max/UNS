		end)
	end
	catcher.Activated:Connect(close)
	self.ActivePopup = close

	for index, item in ipairs(items) do
		local row = Util.new("TextButton", {
			Name = tostring(item.Name or index),
			Text = "", AutoButtonColor = false,

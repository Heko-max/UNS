		Parent = card,
	})
	local rowList = Util.list(8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right)
	rowList.Parent = row

	local dialog = { Frame = card }
	local closed = false
	function dialog:Close()
		if closed then return end
		closed = true
		Util.tween(dim, 0.16, { BackgroundTransparency = 1 })
		Util.tween(card, 0.16, { Size = UDim2.fromOffset(card.AbsoluteSize.X * 0.95, card.AbsoluteSize.Y) })
		task.delay(0.18, function()
			pcall(function() card:Destroy() end)
			pcall(function() dim:Destroy() end)
		end)
		Util.safe(config.OnClose)
	end

	local buttons = config.Buttons
	if typeof(buttons) ~= "table" or #buttons == 0 then
		buttons = {
			{ Name = config.CancelText or "Cancel", Style = "Secondary", Callback = config.OnCancel },
			{ Name = config.ConfirmText or "Confirm", Style = "Primary", Callback = config.OnConfirm },
		}
	end
	for index, spec in ipairs(buttons) do
		local style = tostring(spec.Style or "Secondary"):lower()
		local primary = style == "primary"
		local danger = style == "danger"
		local btn = Util.new("TextButton", {
			Name = tostring(spec.Name or "OK"),
			Text = tostring(spec.Name or "OK"),
			AutoButtonColor = false,
			Font = FONT.Bold,
			TextSize = 12.5,
			TextColor3 = theme.Text,
			Size = UDim2.fromOffset(0, 34),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = danger and theme.Error or (primary and theme.ToggleOn or theme.Button),
			LayoutOrder = index,
			ZIndex = LAYER.Dialog + 3,
			Parent = row,
		}, { Util.corner(9), Util.pad(0, 16, 0, 16) })
		Util.stroke(theme.Border, primary and 0.55 or 0.85, 1).Parent = btn
		btn.Activated:Connect(function()
			Util.safe(spec.Callback, dialog)
			if spec.KeepOpen ~= true then dialog:Close() end
		end)
	end

	if config.DismissOnBackdrop ~= false then
		dim.Activated:Connect(function() dialog:Close() end)
	end
	return dialog
end

function Window:Confirm(config)
	config = typeof(config) == "table" and config or {}
	config.Buttons = config.Buttons or {
		{ Name = config.CancelText or "Cancel", Style = "Secondary", Callback = config.OnCancel },
		{ Name = config.ConfirmText or "Confirm", Style = "Primary", Callback = config.OnConfirm },
	}
	return self:Dialog(config)
end


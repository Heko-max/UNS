register("ProgressBar", function(container, config)
	local theme = NexoUI.Theme
	local self = NexoUI.NewComponent(container, config, {})
	local minv = tonumber(config.Min) or 0
	local maxv = tonumber(config.Max) or 100
	if maxv <= minv then maxv = minv + 1 end
	self.Value = math.clamp(tonumber(config.Default) or tonumber(config.Value) or 0, minv, maxv)

	local valueLabel = Util.label({
		Name = "Value",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(60, 17),
		Text = "",
		Font = FONT.Bold,
		TextSize = 12.5,
		TextColor3 = theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = LAYER.Content + 8,
		Parent = self.Frame,
	})
	local track = Util.new("Frame", {
		Name = "Track",
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = theme.Slider,
		LayoutOrder = 5,
		ZIndex = LAYER.Content + 7,
		Parent = self.Body,
	}, { Util.corner(999) })
	local fill = Util.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = theme.Accent,
		ZIndex = LAYER.Content + 8,
		Parent = track,
	}, { Util.corner(999) })
	local fillGrad = Util.gradient(Util.cseq({ 0, theme.AccentDark }, { 1, theme.AccentLight }), 0)
	fillGrad.Parent = fill

	self._set = function(value, silent)
		value = math.clamp(tonumber(value) or minv, minv, maxv)
		self.Value = value
		local alpha = (value - minv) / (maxv - minv)
		Util.tween(fill, 0.25, { Size = UDim2.fromScale(alpha, 1) })
		valueLabel.Text = config.ShowValue == false and "" or (config.Suffix and (tostring(math.floor(value)) .. config.Suffix) or (tostring(math.floor(alpha * 100)) .. "%"))
		if not silent then
			Util.safe(config.Callback, value)

				TextColor3 = WHITE,
				TextTransparency = 0.28,
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
				LineHeight = 1.22,
				ZIndex = LAYER.Toast + 5,
				Parent = textCol,
			})
		end

		local closeBtn = Util.new("TextButton", {
			Name = "Close",
			Text = "",
			AutoButtonColor = false,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.fromOffset(14, 14),
			BackgroundTransparency = 1,
			ZIndex = LAYER.Toast + 5,
			Parent = card,
		}, { Util.corner(999) })
		for i = 1, 2 do
			Util.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(9, 1.6),
				Rotation = i == 1 and 45 or -45,
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.25,
				ZIndex = LAYER.Toast + 6,
				Parent = closeBtn,
			}, { Util.corner(999) })
		end

		local bar = Util.new("Frame", {
			Name = "Timer",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 7),
			Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = RED,
			BackgroundTransparency = 0.15,
			ZIndex = LAYER.Toast + 5,
			Parent = card,
		}, { Util.corner(999) })

		local window = self
		local toast = { Frame = holder, Card = card, Type = tostring(config.Type or "Info") }
		local closed = false
		function toast:Close()
			if closed then return end
			closed = true
			tw(card, Motion.Base, { Position = UDim2.fromScale(1.15, 0), BackgroundTransparency = 1 })
			task.delay(Motion.Base + 0.04, function() pcall(function() holder:Destroy() end) end)
			for i, n in ipairs(window.Notifications) do
				if n == toast then table.remove(window.Notifications, i) break end
			end
			Util.safe(config.OnClose)
		end

		closeBtn.Activated:Connect(function() toast:Close() end)
		if typeof(config.Callback) == "function" then
			local hit = Util.new("TextButton", {
				Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1), ZIndex = LAYER.Toast + 3, Parent = card,
			})
			hit.Activated:Connect(function()
				Util.safe(config.Callback, toast)
				toast:Close()
			end)
		end

		tw(card, Motion.Slow, { Position = UDim2.fromScale(0, 0) })
		if duration > 0 then
			Util.tween(bar, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
			task.delay(duration + 0.05, function() toast:Close() end)
		else
			bar.Visible = false
		end

		table.insert(self.Notifications, toast)
		return toast
	end

	-- ------------------------------------------------------------------
	--  KEY SYSTEM: modal, fully blocking, rounded
	-- ------------------------------------------------------------------
	function NexoUI:KeySystem(config)
		config = typeof(config) == "table" and config or {}
		local keys = {}
		for _, key in ipairs(config.Keys or {}) do table.insert(keys, tostring(key)) end
		if config.Key then table.insert(keys, tostring(config.Key)) end
		local fileName = tostring(config.FileName or "NexoUI_key.txt")
		local saveKey = config.SaveKey ~= false
		local attemptsLeft = tonumber(config.Attempts) or 5
		local unlocks = config.Unlocks or "default"

		local function validate(input)
			input = tostring(input or "")
			if input == "" then return false end
			if typeof(config.Validate) == "function" then
				local ok, res = pcall(config.Validate, input)
				if ok and res then return true end
				if ok then return false end
			end
			for _, key in ipairs(keys) do
				if input == key then return true end
			end
			return false
		end

		-- freeze every existing interface while the gate is up
		NexoUI.Locked = true
		local frozen = {}
		for _, win in ipairs(NexoUI.Windows) do
			frozen[win] = win.Visible
			if win.Shell then win.Shell.Visible = false end
			if win.Root then win.Root.Visible = false end
			if win.Mini then win.Mini.Visible = false end
		end
		local function thaw()
			NexoUI.Locked = false
			for _, win in ipairs(NexoUI.Windows) do
				local wasVisible = frozen[win]
				if win.Mini then win.Mini.Visible = true end
				if wasVisible ~= false then
					if win.Shell then win.Shell.Visible = true end
					if win.Root then win.Root.Visible = true end
					Util.safe(function() win:Show() end)
				else
					Util.safe(function() win:_SyncMini(true) end)
				end
			end
		end

		local theme = NexoUI.Theme
		local resolved, result = false, false
		local gui = NexoUI.StandaloneGui("NexoKeySystem", 2000000)

		-- modal blocker: swallows every click and keystroke behind the panel
		local blocker = Util.new("TextButton", {
			Name = "Blocker",

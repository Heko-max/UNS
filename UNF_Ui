	}, { Util.corner(999) })
	local miniStroke = Util.stroke(theme.Border, 0.42, 1.4)
	miniStroke.Parent = mini
	local chip = Util.new("Frame", {
		Name = "Chip",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(32, 32),
		BackgroundColor3 = theme.TabActive,
		ZIndex = LAYER.Toast + 11,
		Parent = mini,
	}, { Util.corner(11) })
	local chipGrad = Util.gradient(Util.cseq({ 0, theme.AccentLight }, { 1, theme.AccentDark }), 150)
	chipGrad.Parent = chip
	local chipText = Util.label({
		Size = UDim2.fromScale(1, 1),
		Text = self.Name:sub(1, 1):upper(),
		Font = FONT.Black,
		TextSize = 17,
		TextColor3 = theme.Text,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = LAYER.Toast + 12,
		Parent = chip,
	})
	local kill = Util.new("TextButton", {
		Name = "Remove",
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -1, 0, 1),
		Size = UDim2.fromOffset(19, 19),
		BackgroundColor3 = theme.Error,
		ZIndex = LAYER.Toast + 13,
		Parent = mini,
	}, { Util.corner(999) })
	for i = 1, 2 do
		Util.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(9, 1.8),
			Rotation = i == 1 and 45 or -45,
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = LAYER.Toast + 14,
			Parent = kill,
		}, { Util.corner(1) })
	end

	self.Maid:Give(Util.onTheme(function(t)
		if not mini.Parent then return end
		mini.BackgroundColor3 = t.Tab
		miniStroke.Color = t.Border
		chip.BackgroundColor3 = t.TabActive
		chipGrad.Color = Util.cseq({ 0, t.AccentLight }, { 1, t.AccentDark })
		chipText.TextColor3 = t.Text
		kill.BackgroundColor3 = t.Error
	end))

	-- drag vs click detection so moving the button never toggles the window
	local dragging, moved, startInput, startPos = false, false, nil, nil
	self.Maid:Give(mini.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging, moved = true, false
			startInput = input.Position
			startPos = mini.Position
		end
	end))
	self.Maid:Give(UserInputService.InputChanged:Connect(function(input)
		if not dragging or not mini.Parent then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - startInput
			if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then moved = true end
			local v = Camera.ViewportSize
			mini.Position = UDim2.fromOffset(
				math.clamp(startPos.X.Offset + delta.X, 6, math.max(6, v.X - 58)),
				math.clamp(startPos.Y.Offset + delta.Y, 6, math.max(6, v.Y - 58))
			)
		end
	end))
	self.Maid:Give(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
	self.Maid:Give(mini.Activated:Connect(function()
		if moved then moved = false return end
		self:Toggle()
	end))
	self.Maid:Give(mini.MouseEnter:Connect(function()
		Util.tween(mini, 0.14, { BackgroundColor3 = NexoUI.Theme.ButtonHover })
	end))
	self.Maid:Give(mini.MouseLeave:Connect(function()
		Util.tween(mini, 0.16, { BackgroundColor3 = NexoUI.Theme.Tab })
	end))
	self.Maid:Give(kill.Activated:Connect(function()
		Util.tween(mini, 0.14, { Size = UDim2.fromOffset(8, 8) })
		task.delay(0.16, function() self:Destroy() end)
	end))
	self.Mini = mini
	return mini
end

-- =====================================================================
--  TABS
-- =====================================================================
-- Tab methods are declared once on a shared table. They only ever touch
-- `self`, so every tab and every window keeps its own state.
local TabMethods = {}
local Tab = {}
Tab.__index = function(self, key)
	local method = TabMethods[key]
	if method then return method end
	return Container.__index(self, key)
end
NexoUI.TabClass = Tab
NexoUI.TabMethods = TabMethods

function TabMethods:Select()
	if self.Window then self.Window:SelectTab(self) end
	return self
end

function TabMethods:SetName(name)
	self.Name = tostring(name)
	self.Label.Text = self.Name
	self.Button.Name = self.Name
	return self
end

function TabMethods:SetIcon(image)
	if self.Icon and self.Icon:IsA("ImageLabel") then
		self.Icon.Image = Util.image(image)
		self.Icon.Visible = self.Icon.Image ~= ""
	end
	return self
end

function TabMethods:SetVisible(visible)
	self.UserVisible = visible ~= false
	self.Button.Visible = self.UserVisible
	local window = self.Window
	if not self.UserVisible and window and window.ActiveTab == self then
		for _, other in ipairs(window.Tabs) do
			if other ~= self and other.UserVisible then
				window:SelectTab(other)
				break
			end
		end
	end
	return self
end

function TabMethods:Destroy()
	local window = self.Window
	self:Clear()
	for _, sub in ipairs(table.clone(self.SubTabs)) do
		pcall(function() sub:Destroy() end)
	end
	self.Maid:Clean()
	pcall(function() self.Button:Destroy() end)
	pcall(function() self.Page:Destroy() end)
	if self.SubBar then pcall(function() self.SubBar:Destroy() end) end
	if window then
		for i, t in ipairs(window.Tabs) do
			if t == self then table.remove(window.Tabs, i) break end
		end
		if window.ActiveTab == self then
			window.ActiveTab = nil
			if window.Tabs[1] then window:SelectTab(window.Tabs[1]) end
		end
	end
	self.Destroyed = true
end

-- Tab:CreateSubTab{ Name = "Roll", Icon = "rbxassetid://..." }
function TabMethods:CreateSubTab(config)
	if typeof(config) ~= "table" then config = { Name = tostring(config or "Sub") } end
	local tab = self
	local window = self.Window
	local theme = NexoUI.Theme

	if not tab.SubBar then
		tab.SubBar = Util.new("ScrollingFrame", {
			Name = tab.Name .. "SubBar",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 0,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.X,
			ScrollingDirection = Enum.ScrollingDirection.X,
			ElasticBehavior = Enum.ElasticBehavior.Never,
			Visible = window.ActiveTab == tab,
			ZIndex = LAYER.Header,
			Parent = window.SubBarHolder,
		})
		local barList = Util.list(8, Enum.FillDirection.Horizontal)
		barList.VerticalAlignment = Enum.VerticalAlignment.Center
		barList.Parent = tab.SubBar
	end

	local sub = {}
	sub.Name = tostring(config.Name or ("Sub " .. (#tab.SubTabs + 1)))
	sub.Config = config
	sub.Maid = Maid.new()
	sub.Parent = tab
	sub.Tab = tab

	local pill = Util.new("TextButton", {
		Name = sub.Name,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = theme.Tab,
		BackgroundTransparency = 0.35,
		LayoutOrder = #tab.SubTabs + 1,
		ZIndex = LAYER.Header + 1,
		Parent = tab.SubBar,
	}, { Util.corner(10), Util.pad(0, 15, 0, 15) })
	local pillGrad = Util.gradient(Util.cseq({ 0, theme.TabActive }, { 1, theme.AccentDark }), 0)
	pillGrad.Parent = pill
	pillGrad.Enabled = false

	local pillRow = Util.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		ZIndex = LAYER.Header + 2,
		Parent = pill,
	})
	local pillList = Util.list(7, Enum.FillDirection.Horizontal)
	pillList.VerticalAlignment = Enum.VerticalAlignment.Center
	pillList.Parent = pillRow

	local subIcon = Util.image(config.Icon or config.Image)
	if subIcon ~= "" then
		local img = Util.imageObject({ Image = subIcon, Size = config.IconSize or 16 }, 16)
		img.ZIndex = LAYER.Header + 2
		img.Parent = pillRow
		sub.IconImage = img
	end
	local pillLabel = Util.label({
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = sub.Name,
		Font = FONT.Bold,
		TextSize = 13,
		TextColor3 = theme.SubText,
		ZIndex = LAYER.Header + 2,
		Parent = pillRow,
	})

	local holder = Util.new("Frame", {
		Name = sub.Name .. "Content",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = #tab.SubTabs == 0,
		LayoutOrder = 100 + #tab.SubTabs,
		ZIndex = LAYER.Content + 3,
		Parent = tab.Page,
	}, { Util.list(14) })

	sub.Button = pill
	sub.Label = pillLabel
	sub.Gradient = pillGrad
	sub.Frame = holder
	NexoUI.MakeContainer(sub, window, holder)

	function sub:Select()
		for _, other in ipairs(tab.SubTabs) do
			local active = other == self
			local t = NexoUI.Theme
			other.Active = active
			other.Frame.Visible = active
			other.Gradient.Enabled = active
			Util.tween(other.Button, 0.16, { BackgroundTransparency = active and 0 or 0.35 })
			Util.tween(other.Label, 0.16, { TextColor3 = active and t.Text or t.SubText })
		end
		Util.safe(config.Callback, self)
		return self
	end
	function sub:SetName(name)
		self.Name = tostring(name)
		pillLabel.Text = self.Name
		return self
	end
	function sub:SetIcon(image)
		if self.IconImage then
			self.IconImage.Image = Util.image(image)
			self.IconImage.Visible = self.IconImage.Image ~= ""
		end
		return self
	end
	function sub:SetVisible(visible)
		pill.Visible = visible ~= false
		if visible == false and self.Active then
			for _, other in ipairs(tab.SubTabs) do
				if other ~= self and other.Button.Visible then other:Select() break end
			end
		end
		return self
	end
	function sub:Destroy()
		self:Clear()
		self.Maid:Clean()
		pcall(function() pill:Destroy() end)
		pcall(function() holder:Destroy() end)
		for i, s in ipairs(tab.SubTabs) do
			if s == self then table.remove(tab.SubTabs, i) break end
		end
	end

	sub.Maid:Give(pill.Activated:Connect(function() sub:Select() end))
	sub.Maid:Give(pill.MouseEnter:Connect(function()
		if not sub.Active then Util.tween(pill, 0.14, { BackgroundTransparency = 0.15 }) end
	end))
	sub.Maid:Give(pill.MouseLeave:Connect(function()
		if not sub.Active then Util.tween(pill, 0.16, { BackgroundTransparency = 0.35 }) end
	end))
	sub.Maid:Give(Util.onTheme(function(t)
		if not pill.Parent then return end
		pill.BackgroundColor3 = t.Tab
		pillGrad.Color = Util.cseq({ 0, t.TabActive }, { 1, t.AccentDark })
		pillLabel.TextColor3 = sub.Active and t.Text or t.SubText
	end))

	table.insert(tab.SubTabs, sub)
	if #tab.SubTabs == 1 then sub:Select() end
	tab.SubBar.Visible = window.ActiveTab == tab
	return sub
end

-- Window:CreateTab{ Name = "Main", Icon = "rbxassetid://..." }
function Window:CreateTab(config)
	if typeof(config) ~= "table" then config = { Name = tostring(config or "Tab") } end
	local window = self
	local theme = NexoUI.Theme
	local tab = setmetatable({}, Tab)
	tab.Config = config
	tab.Name = tostring(config.Name or ("Tab " .. (#self.Tabs + 1)))
	tab.Description = config.Description
	tab.SubTabs = {}
	tab.Sections = {}
	tab.Maid = Maid.new()
	tab.UserVisible = true
	tab.Active = false

	local button = Util.new("TextButton", {
		Name = tab.Name,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = theme.Tab,
		BackgroundTransparency = 1,
		LayoutOrder = #self.Tabs + 1,
		ZIndex = LAYER.Content + 4,
		Parent = self.TabList,
	}, { Util.corner(9) })
	local stroke = Util.stroke(theme.Border, 1, 1)
	stroke.Parent = button
	local grad = Util.gradient(
		Util.cseq({ 0, theme.TabActive }, { 1, theme.AccentDark }), 0,
		NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.28), NumberSequenceKeypoint.new(1, 0.88) })
	)
	grad.Parent = button

	local iconId = Util.image(config.Icon or config.Image)
	local icon
	if iconId ~= "" then
		icon = Util.imageObject({ Image = iconId, Size = config.IconSize or 20, Color = config.IconColor }, 20)
		icon.AnchorPoint = Vector2.new(0, 0.5)
		icon.Position = UDim2.new(0, 9, 0.5, 0)
		icon.ZIndex = LAYER.Content + 5
		icon.Parent = button
	else
		icon = Util.new("Frame", {
			Name = "Dot",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 11, 0.5, 0),
			Size = UDim2.fromOffset(6, 6),
			BackgroundColor3 = theme.MutedText,
			ZIndex = LAYER.Content + 5,
			Parent = button,
		}, { Util.corner(999) })
	end

	local label = Util.label({
		Name = "Label",
		Position = UDim2.fromOffset(30, 0),
		Size = UDim2.new(1, -38, 1, 0),
		Text = tab.Name,
		Font = FONT.Bold,
		TextSize = 12,
		TextColor3 = theme.SubText,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = LAYER.Content + 5,
		Parent = button,
	})

	local page = Util.new("ScrollingFrame", {
		Name = tab.Name:gsub("%s", "") .. "Page",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = theme.Accent,
		ScrollBarImageTransparency = 0.35,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ElasticBehavior = Enum.ElasticBehavior.Never,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = LAYER.Content + 3,
		Parent = self.Pages,
	}, { Util.list(8), Util.pad(6, 14, 14, 12) })

	tab.Button = button
	tab.Icon = icon
	tab.Label = label
	tab.Page = page
	tab.Window = window
	NexoUI.MakeContainer(tab, window, page)
	tab.Tab = tab -- sections created directly on the tab register here

	-- per instance visual state helpers
	function tab:_Paint(active, instant)
		local t = NexoUI.Theme
		self.Active = active and true or false
		local dur = instant and 0 or 0.16
		Util.tween(button, dur, { BackgroundTransparency = self.Active and 0 or 1 })
		Util.tween(label, dur, { TextColor3 = self.Active and t.Text or t.SubText })
		stroke.Transparency = self.Active and 0.45 or 1
		if icon:IsA("ImageLabel") then
			Util.tween(icon, dur, { ImageColor3 = self.Active and t.Text or t.MutedText })
		else
			Util.tween(icon, dur, { BackgroundColor3 = self.Active and t.Accent or t.MutedText })
		end
	end

	function tab:_SetCompact(compact)
		label.Visible = not compact
		if compact then
			icon.AnchorPoint = Vector2.new(0.5, 0.5)
			icon.Position = UDim2.fromScale(0.5, 0.5)
		else
			icon.AnchorPoint = Vector2.new(0, 0.5)
			icon.Position = UDim2.new(0, icon:IsA("ImageLabel") and 9 or 11, 0.5, 0)
		end
	end

	tab.Maid:Give(button.MouseEnter:Connect(function()
		if not tab.Active then Util.tween(button, 0.14, { BackgroundTransparency = 0.86 }) end
	end))
	tab.Maid:Give(button.MouseLeave:Connect(function()
		if not tab.Active then Util.tween(button, 0.16, { BackgroundTransparency = 1 }) end
	end))
	tab.Maid:Give(button.Activated:Connect(function() window:SelectTab(tab) end))
	tab.Maid:Give(Util.onTheme(function(t)
		if not button.Parent then return end
		button.BackgroundColor3 = t.Tab
		stroke.Color = t.Border
		grad.Color = Util.cseq({ 0, t.TabActive }, { 1, t.AccentDark })
		page.ScrollBarImageColor3 = t.Accent
		tab:_Paint(tab.Active, true)
	end))

	tab:_Paint(false, true)
	tab:_SetCompact(self.Narrow == true)
	table.insert(self.Tabs, tab)
	if #self.Tabs == 1 or config.Default then self:SelectTab(tab) end
	return tab
end

function Window:GetTab(name)
	for _, tab in ipairs(self.Tabs) do
		if tab.Name == name then return tab end
	end
end


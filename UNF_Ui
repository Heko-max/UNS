function NexoUI:Changelog(config)
	config = typeof(config) == "table" and config or {}
	local theme = NexoUI.Theme
	local version = tostring(config.Version or NexoUI.Version)
	local stateFile = tostring(config.FileName or "NexoUI_changelog.txt")

	if config.ShowOnce then
		local seen
		if typeof(readfile) == "function" then
			local exists = true
			if typeof(isfile) == "function" then
				local ok, found = pcall(isfile, stateFile)
				exists = ok and found
			end
			if exists then
				local ok, value = pcall(readfile, stateFile)
				if ok then seen = value end
			end
		else
			seen = NexoUI._seenChangelog
		end
		if seen == version then return nil end
	end

	local gui = standaloneGui("NexoChangelog", 999997)
	local panel = overlayPanel(gui, 430, 420)
	Util.pad(18, 20, 16, 20).Parent = panel
	local list = Util.list(10)
	list.Parent = panel

	Util.label({
		Size = UDim2.new(1, 0, 0, 24),
		Text = tostring(config.Title or ("What's new  -  " .. version)),
		Font = FONT.Black,
		TextSize = 17,
		TextColor3 = theme.Text,
		LayoutOrder = 1,
		ZIndex = 4,
		Parent = panel,
	})
	if config.Subtitle then
		Util.label({
			Size = UDim2.new(1, 0, 0, 16),
			Text = tostring(config.Subtitle),
			Font = FONT.Regular,
			TextSize = 12,
			TextColor3 = theme.MutedText,
			LayoutOrder = 2,
			ZIndex = 4,
			Parent = panel,
		})
	end

	local scroller = Util.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -104),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ElasticBehavior = Enum.ElasticBehavior.Never,
		LayoutOrder = 3,
		ZIndex = 4,
		Parent = panel,
	}, { Util.list(10), Util.pad(2, 2, 8, 2) })

	local TAGS = { added = "Success", new = "Success", fixed = "Info",
		improved = "Info", changed = "Warning", removed = "Error" }

	local entries = config.Entries or config.Versions or {}
	for index, entry in ipairs(entries) do

register("ProfileManager", function(container, config)
	local host = Util.new("Frame", {
		Name = "ProfileManager",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,

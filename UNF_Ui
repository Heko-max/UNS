			BackgroundTransparency = 0.6,
			LayoutOrder = index,
			ZIndex = LAYER.Popup + 2,
			Parent = panel,
		}, { Util.corner(8), Util.pad(0, 10, 0, 10) })
		local itemIcon = Util.image(item.Icon or item.Image)
		local textInset = 0
		if itemIcon ~= "" then
			local img = Util.imageObject({ Image = itemIcon, Size = 16 }, 16)
			img.AnchorPoint = Vector2.new(0, 0.5)
			img.Position = UDim2.new(0, 0, 0.5, 0)

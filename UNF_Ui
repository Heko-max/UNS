register("Slider", function(container, config)
	local theme = NexoUI.Theme
	local self = NexoUI.NewComponent(container, config, {})
	local minv = tonumber(config.Min) or tonumber(config.Minimum) or 0
	local maxv = tonumber(config.Max) or tonumber(config.Maximum) or 100
	if maxv <= minv then maxv = minv + 1 end
	local step = tonumber(config.Increment) or tonumber(config.Step) or 1
	local places = Util.decimals(step)
	local suffix = config.Suffix and tostring(config.Suffix) or ""
	self.Value = math.clamp(tonumber(config.Default) or tonumber(config.Value) or minv, minv, maxv)

	local readout = Util.label({
		Name = "Readout",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(74, 18),
		Text = "",
		Font = FONT.Bold,
		TextSize = 12.5,
		TextColor3 = theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Visible = config.ShowValue ~= false,
		ZIndex = LAYER.Content + 8,
		Parent = self.Frame,
	})
	local track = Util.new("Frame", {
		Name = "Track",
		Size = UDim2.new(1, 0, 0, 7),
		BackgroundColor3 = theme.Slider,
		LayoutOrder = 5,
		ZIndex = LAYER.Content + 7,
		Parent = self.Body,
	}, { Util.corner(999) })
	local fill = Util.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = theme.Accent,
		ZIndex = LAYER.Content + 8,
		Parent = track,
	}, { Util.corner(999) })
	local fillGrad = Util.gradient(Util.cseq({ 0, theme.AccentDark }, { 1, theme.AccentLight }), 0)
	fillGrad.Parent = fill
	local knob = Util.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(15, 15),
		BackgroundColor3 = theme.Knob,
		ZIndex = LAYER.Content + 9,
		Parent = track,
	}, { Util.corner(999) })
	-- generous invisible hit area so the slider is easy to grab on touch
	local hit = Util.new("TextButton", {
		Name = "Hit",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(-10, -9),
		Size = UDim2.new(1, 20, 1, 18),
		ZIndex = LAYER.Content + 10,
		Parent = track,
	})
	self.Control = track

	self._set = function(value, silent)
		value = math.clamp(Util.round(tonumber(value) or minv, step), minv, maxv)
		self.Value = value
		local alpha = (value - minv) / (maxv - minv)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
		readout.Text = string.format("%." .. places .. "f%s", value, suffix)
		if not silent then
			Util.safe(config.Callback, value, self)
			self.Changed:Fire(value)
		end
	end
	self._set(self.Value, true)

	local dragging = false
	local function apply(x)
		local size = math.max(track.AbsoluteSize.X, 1)
		self._set(minv + ((x - track.AbsolutePosition.X) / size) * (maxv - minv))
	end
	self.Maid:Give(hit.InputBegan:Connect(function(input)
		if not self.Enabled then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			Util.tween(knob, 0.12, { Size = UDim2.fromOffset(19, 19) })
			apply(input.Position.X)
		end
	end))
	self.Maid:Give(UserInputService.InputChanged:Connect(function(input)
		if not dragging or not track.Parent then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			apply(input.Position.X)
		end
	end))
	self.Maid:Give(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then Util.tween(knob, 0.14, { Size = UDim2.fromOffset(15, 15) }) end
			dragging = false
		end
	end))
	self.Maid:Give(Util.onTheme(function(t)
		if not track.Parent then return end
		track.BackgroundColor3 = t.Slider
		fill.BackgroundColor3 = t.Accent
		fillGrad.Color = Util.cseq({ 0, t.AccentDark }, { 1, t.AccentLight })
		knob.BackgroundColor3 = t.Knob
		readout.TextColor3 = t.Accent
	end))
	return self
end)

-- Shared popup helper: opens a floating panel above everything, anchored to a
-- control, flipped up when there is no room below, closed on outside click.
function NexoUI.OpenPopup(window, anchor, height, builder)
	if not window or not window.PopupLayer then return end
	if window.ActivePopup then window.ActivePopup() end
	local theme = NexoUI.Theme
	local catcher = Util.new("TextButton", {
		Name = "PopupCatcher",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = LAYER.Popup,
		Parent = window.PopupLayer,
	})
	local vp = Camera.ViewportSize
	local pos = anchor.AbsolutePosition
	local size = anchor.AbsoluteSize
	local below = pos.Y + size.Y + 6
	local flip = (below + height) > (vp.Y - 10)
	local panel = Util.new("Frame", {
		Name = "Popup",
		Position = UDim2.fromOffset(
			math.clamp(pos.X, 6, math.max(6, vp.X - size.X - 6)),
			flip and math.max(6, pos.Y - height - 6) or below
		),
		Size = UDim2.fromOffset(size.X, 0),
		BackgroundColor3 = theme.PanelAlt,
		ClipsDescendants = true,
		ZIndex = LAYER.Popup + 1,
		Parent = window.PopupLayer,
	}, { Util.corner(11) })
	Util.stroke(theme.Border, 0.55, 1.2).Parent = panel
	Util.tween(panel, 0.18, { Size = UDim2.fromOffset(size.X, height) })

	local closed = false
	local function close()
		if closed then return end
		closed = true
		window.ActivePopup = nil
		Util.tween(panel, 0.14, { Size = UDim2.fromOffset(size.X, 0) })
		task.delay(0.16, function()
			pcall(function() panel:Destroy() end)
			pcall(function() catcher:Destroy() end)
		end)
	end
	catcher.Activated:Connect(close)
	window.ActivePopup = close
	if builder then builder(panel, close) end
	return panel, close
end

register("Dropdown", function(container, config)
	local theme = NexoUI.Theme
	local self = NexoUI.NewComponent(container, config, {})
	local multi = config.Multi == true or config.MultiSelect == true
	self.Multi = multi
	self.Options = {}
	for _, option in ipairs(config.Options or config.Items or {}) do
		table.insert(self.Options, tostring(option))
	end
	self.Value = multi and {} or nil

	local control = Util.new("TextButton", {
		Name = "Control",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundColor3 = theme.Panel,
		LayoutOrder = 5,
		ZIndex = LAYER.Content + 7,
		Parent = self.Body,
	}, { Util.corner(10), Util.pad(0, 34, 0, 12) })
	local controlStroke = Util.stroke(theme.Border, 0.82, 1)
	controlStroke.Parent = control
	local display = Util.label({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		Font = FONT.Medium,
		TextSize = 13,
		TextColor3 = theme.SubText,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = LAYER.Content + 8,
		Parent = control,
	})
	local chev = Util.new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(11, 11),
		BackgroundTransparency = 1,
		ZIndex = LAYER.Content + 8,
		Parent = control,
	})
	for i = 1, 2 do
		Util.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(i == 1 and 0.28 or 0.72, 0.5),
			Size = UDim2.fromOffset(8, 1.8),
			Rotation = i == 1 and 45 or -45,
			BackgroundColor3 = theme.SubText,
			ZIndex = LAYER.Content + 8,
			Parent = chev,
		}, { Util.corner(1) })
	end
	self.Control = control

	local placeholder = tostring(config.Placeholder or "Select...")
	local function refreshDisplay()
		if multi then
			display.Text = (#self.Value > 0) and table.concat(self.Value, ", ") or placeholder
		else
			display.Text = self.Value and tostring(self.Value) or placeholder
		end
	end

	self._set = function(value, silent)
		if multi then
			local list = {}
			if typeof(value) == "table" then
				for _, v in ipairs(value) do
					if table.find(self.Options, tostring(v)) then table.insert(list, tostring(v)) end
				end
			elseif value ~= nil and table.find(self.Options, tostring(value)) then
				list = { tostring(value) }
			end
			self.Value = list
		else
			if value == nil then
				self.Value = nil
			elseif table.find(self.Options, tostring(value)) then
				self.Value = tostring(value)
			else
				Util.warn("dropdown '" .. tostring(self.Name) .. "' has no option '" .. tostring(value) .. "'")
			end
		end
		refreshDisplay()
		if not silent then
			Util.safe(config.Callback, self.Value, self)
			self.Changed:Fire(self.Value)
		end
	end

	function self:Refresh(options, keepSelection)
		self.Options = {}
		for _, option in ipairs(options or {}) do table.insert(self.Options, tostring(option)) end
		if not keepSelection then
			self.Value = multi and {} or nil
		elseif multi then
			local kept = {}
			for _, v in ipairs(self.Value) do
				if table.find(self.Options, v) then table.insert(kept, v) end
			end
			self.Value = kept
		elseif self.Value and not table.find(self.Options, self.Value) then
			self.Value = nil
		end
		refreshDisplay()
		return self
	end
	function self:AddOption(option)
		option = tostring(option)
		if not table.find(self.Options, option) then table.insert(self.Options, option) end
		return self
	end
	function self:RemoveOption(option)
		option = tostring(option)
		local index = table.find(self.Options, option)
		if index then table.remove(self.Options, index) end
		if multi then
			local at = table.find(self.Value, option)
			if at then table.remove(self.Value, at) end
		elseif self.Value == option then
			self.Value = nil
		end
		refreshDisplay()
		return self
	end
	function self:Clear()
		self._set(multi and {} or nil)
		return self
	end
	function self:GetOptions() return table.clone(self.Options) end

	-- menu ------------------------------------------------------------------
	local function openMenu()
		if not self.Enabled then return end
		local searchable = config.Search == true or config.Searchable == true or #self.Options > 8
		local rowH, searchH = 32, searchable and 36 or 0
		local listH = math.min(#self.Options * (rowH + 4) + 8, 208)
		Util.tween(chev, 0.18, { Rotation = 180 })
		NexoUI.OpenPopup(self.Window, control, listH + searchH, function(panel, close)
			local t = NexoUI.Theme
			local filterText = ""
			local scroller = Util.new("ScrollingFrame", {
				Position = UDim2.fromOffset(0, searchH),
				Size = UDim2.new(1, 0, 1, -searchH),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 3,
				ScrollBarImageColor3 = t.Accent,
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ElasticBehavior = Enum.ElasticBehavior.Never,
				ZIndex = LAYER.Popup + 2,
				Parent = panel,
			}, { Util.list(4), Util.pad(4, 4, 4, 4) })

			local function build()
				for _, child in ipairs(scroller:GetChildren()) do
					if child:IsA("TextButton") then child:Destroy() end
				end
				for index, option in ipairs(self.Options) do
					if filterText == "" or option:lower():find(filterText, 1, true) then
						local selected = multi and (table.find(self.Value, option) ~= nil) or (self.Value == option)
						local row = Util.new("TextButton", {
							Name = option,
							Text = "",
							AutoButtonColor = false,
							Size = UDim2.new(1, 0, 0, rowH),
							BackgroundColor3 = selected and t.TabActive or t.Field,
							BackgroundTransparency = selected and 0.15 or 0.55,
							LayoutOrder = index,
							ZIndex = LAYER.Popup + 3,
							Parent = scroller,
						}, { Util.corner(8), Util.pad(0, 10, 0, 10) })
						Util.label({
							Size = UDim2.fromScale(1, 1),
							Text = option,
							Font = selected and FONT.Bold or FONT.Medium,
							TextSize = 12.5,
							TextColor3 = selected and t.Text or t.SubText,
							TextTruncate = Enum.TextTruncate.AtEnd,
							ZIndex = LAYER.Popup + 4,
							Parent = row,
						})
						row.Activated:Connect(function()
							if multi then
								local at = table.find(self.Value, option)
								if at then table.remove(self.Value, at) else table.insert(self.Value, option) end
								refreshDisplay()
								Util.safe(config.Callback, self.Value, self)
								self.Changed:Fire(self.Value)
								build()
							else
								self._set(option)
								close()
							end
						end)
					end
				end
			end

			if searchable then
				local box = Util.new("TextBox", {
					Size = UDim2.new(1, -8, 0, 30),
					Position = UDim2.fromOffset(4, 4),
					BackgroundColor3 = t.Field,
					Text = "",
					PlaceholderText = "Search options...",
					PlaceholderColor3 = t.MutedText,
					TextColor3 = t.Text,
					Font = FONT.Medium,
					TextSize = 12.5,
					TextXAlignment = Enum.TextXAlignment.Left,
					ClearTextOnFocus = false,
					ZIndex = LAYER.Popup + 3,
					Parent = panel,
				}, { Util.corner(8), Util.pad(0, 8, 0, 8) })
				box:GetPropertyChangedSignal("Text"):Connect(function()
					filterText = box.Text:lower()
					build()
				end)
			end
			build()
		end)
	end

	self.Maid:Give(control.Activated:Connect(function()
		if self.Window and self.Window.ActivePopup then
			self.Window.ActivePopup()
			Util.tween(chev, 0.18, { Rotation = 0 })
			return
		end
		openMenu()
	end))
	self.Maid:Give(control.MouseEnter:Connect(function()
		Util.tween(controlStroke, 0.14, { Transparency = 0.5 })
	end))
	self.Maid:Give(control.MouseLeave:Connect(function()
		Util.tween(controlStroke, 0.16, { Transparency = 0.82 })
	end))
	self.Maid:Give(Util.onTheme(function(t)
		if not control.Parent then return end
		control.BackgroundColor3 = t.Panel
		controlStroke.Color = t.Border
		display.TextColor3 = t.SubText
	end))

	local default = config.Default or config.Value
	if default ~= nil then self._set(default, true) else refreshDisplay() end
	return self
end)

register("Input", function(container, config)
	local theme = NexoUI.Theme
	local self = NexoUI.NewComponent(container, config, {})
	local numeric = config.Numeric == true or config.NumbersOnly == true
	local maxLen = tonumber(config.MaxLength) or 0
	self.Value = tostring(config.Default or config.Text or "")

	local box = Util.new("TextBox", {
		Name = "Box",
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundColor3 = theme.Panel,
		Text = self.Value,
		PlaceholderText = tostring(config.Placeholder or ""),
		PlaceholderColor3 = theme.MutedText,
		TextColor3 = theme.Text,
		Font = FONT.Medium,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = config.ClearOnFocus == true,
		ClipsDescendants = true,
		LayoutOrder = 5,
		ZIndex = LAYER.Content + 7,
		Parent = self.Body,
	}, { Util.corner(10), Util.pad(0, 12, 0, 12) })
	local boxStroke = Util.stroke(theme.Border, 0.82, 1)
	boxStroke.Parent = box
	self.Control = box

	local function sanitize(text)
		if numeric then
			text = text:gsub("[^%d%.%-]", "")
			local number = tonumber(text)
			if number then
				if config.Min then number = math.max(number, tonumber(config.Min)) end
				if config.Max then number = math.min(number, tonumber(config.Max)) end
				text = tostring(number)
			end
		end
		if maxLen > 0 and #text > maxLen then text = text:sub(1, maxLen) end
		if typeof(config.Validate) == "function" then
			local ok, result = pcall(config.Validate, text)
			if ok and typeof(result) == "string" then text = result end
			if ok and result == false then text = self.Value end
		end
		return text
	end

	self._set = function(value, silent)
		local text = sanitize(tostring(value or ""))
		self.Value = text
		box.Text = text
		if not silent then
			Util.safe(config.Callback, text, self)
			self.Changed:Fire(text)
		end
	end
	function self:ClearText() self._set("") return self end

	self.Maid:Give(box.Focused:Connect(function()
		Util.tween(boxStroke, 0.14, { Transparency = 0.35 })
	end))
	self.Maid:Give(box.FocusLost:Connect(function(enter)
		Util.tween(boxStroke, 0.16, { Transparency = 0.82 })
		self._set(box.Text)
		if enter then Util.safe(config.OnEnter, self.Value, self) end
	end))
	self.Maid:Give(Util.onTheme(function(t)
		if not box.Parent then return end
		box.BackgroundColor3 = t.Panel
		box.TextColor3 = t.Text
		box.PlaceholderColor3 = t.MutedText
		boxStroke.Color = t.Border
	end))
	return self
end)


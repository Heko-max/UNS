--  27. COMMAND PALETTE / GLOBAL SEARCH
-- =====================================================================
NexoUI.Commands = {}

function NexoUI:RegisterCommand(config)
	if typeof(config) ~= "table" or typeof(config.Callback) ~= "function" then
		Util.warn("RegisterCommand needs { Name, Callback }")
		return nil
	end
	local command = {
		Name = tostring(config.Name or "Command"),
		Description = config.Description and tostring(config.Description) or nil,
		Keywords = config.Keywords,
		Icon = config.Icon,
		Callback = config.Callback,
	}
	table.insert(NexoUI.Commands, command)
	return command
end

function NexoUI:UnregisterCommand(nameOrCommand)
	for index, command in ipairs(NexoUI.Commands) do
		if command == nameOrCommand or command.Name == nameOrCommand then
			table.remove(NexoUI.Commands, index)
			return true
		end
	end
	return false
end

local function collectTargets()
	local results = {}
	for _, command in ipairs(NexoUI.Commands) do
		table.insert(results, {
			Label = command.Name,
			Sub = command.Description or "Command",
			Search = (command.Name .. " " .. tostring(command.Description or "")
				.. " " .. tostring(command.Keywords or "")):lower(),
			Run = command.Callback,
		})
	end
	local function walk(container, window, tab)
		for _, child in ipairs(container.Children or {}) do
			if child.IsContainer then
				if child.Name then
					table.insert(results, {
						Label = tostring(child.Name),
						Sub = "Section in " .. tostring(tab and tab.Name or window.Name),
						Search = tostring(child.Name):lower(),
						Run = function()
							if tab then window:SelectTab(tab) end
							window:Show()
						end,
					})
				end
				walk(child, window, tab)
			elseif child.Name then
				table.insert(results, {
					Label = tostring(child.Name),
					Sub = tostring(child.Type or "Component") .. " in " .. tostring(tab and tab.Name or window.Name),
					Search = (tostring(child.Name) .. " " .. tostring(child.Description or "")):lower(),
					Run = function()
						if tab then window:SelectTab(tab) end
						window:Show()
						if child.Type == "Toggle" or child.Type == "Switch" or child.Type == "Checkbox" then
							child:Set(not child:Get())
						elseif child.Type == "Button" and child.Config and child.Config.Callback then
							Util.safe(child.Config.Callback, child)
						end
					end,
				})
			end
		end
	end
	for _, window in ipairs(NexoUI.Windows) do
		for _, tab in ipairs(window.Tabs) do
			table.insert(results, {
				Label = tab.Name,
				Sub = "Tab in " .. window.Name,
				Search = tostring(tab.Name):lower(),
				Run = function() window:Show() window:SelectTab(tab) end,
			})
			walk(tab, window, tab)
			for _, sub in ipairs(tab.SubTabs or {}) do walk(sub, window, tab) end
		end
	end
	return results
end

function NexoUI:CloseCommandPalette()
	if NexoUI._palette then
		pcall(function() NexoUI._palette:Destroy() end)
		NexoUI._palette = nil
	end
end

function NexoUI:OpenCommandPalette()
	if NexoUI._palette then
		NexoUI:CloseCommandPalette()
		return
	end
	local theme = NexoUI.Theme
	local gui = standaloneGui("NexoPalette", 999995)
	NexoUI._palette = gui
	local dim = Util.new("TextButton", {
		Text = "", AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		ZIndex = 1,
		Parent = gui,
	})
	Util.tween(dim, 0.18, { BackgroundTransparency = 0.5 })
	dim.Activated:Connect(function() NexoUI:CloseCommandPalette() end)

	local vp = Camera.ViewportSize
	local width = math.min(460, vp.X - 40)
	local panel = Util.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, math.min(110, vp.Y * 0.12)),
		Size = UDim2.fromOffset(width, 330),
		BackgroundColor3 = theme.Background,
		ClipsDescendants = true,
		ZIndex = 2,
		Parent = gui,
	}, { Util.corner(14), Util.pad(12, 12, 12, 12), Util.list(8) })
	Util.stroke(theme.Accent, 0.6, 1.3).Parent = panel
	Util.gradient(Util.cseq({ 0, theme.PanelAlt }, { 1, theme.Background }), 160).Parent = panel

	local box = Util.new("TextBox", {
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundColor3 = theme.Field,
		Text = "",
		PlaceholderText = "Search tabs, sections, components and commands...",
		PlaceholderColor3 = theme.MutedText,
		TextColor3 = theme.Text,
		Font = FONT.Medium,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		LayoutOrder = 1,
		ZIndex = 3,
		Parent = panel,
	}, { Util.corner(10), Util.pad(0, 12, 0, 12) })
	local scroller = Util.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -46),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = theme.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ElasticBehavior = Enum.ElasticBehavior.Never,
		LayoutOrder = 2,
		ZIndex = 3,
		Parent = panel,
	}, { Util.list(5) })

	local targets = collectTargets()
	local shown, selected = {}, 1

	local function render()
		for _, child in ipairs(scroller:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		for index, item in ipairs(shown) do
			local active = index == selected
			local row = Util.new("TextButton", {
				Text = "", AutoButtonColor = false,
				Size = UDim2.new(1, 0, 0, 40),
				BackgroundColor3 = active and theme.TabActive or theme.Field,
				BackgroundTransparency = active and 0.1 or 0.6,
				LayoutOrder = index,
				ZIndex = 4,
				Parent = scroller,
			}, { Util.corner(9), Util.pad(0, 12, 0, 12) })
			Util.label({
				Position = UDim2.fromOffset(0, 5),
				Size = UDim2.new(1, 0, 0, 16),
				Text = item.Label,
				Font = FONT.Bold,
				TextSize = 13,
				TextColor3 = theme.Text,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 5,
				Parent = row,
			})
			Util.label({
				Position = UDim2.fromOffset(0, 20),
				Size = UDim2.new(1, 0, 0, 14),
				Text = item.Sub,
				Font = FONT.Regular,
				TextSize = 11,
				TextColor3 = theme.MutedText,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 5,
				Parent = row,
			})
			row.Activated:Connect(function()
				Util.safe(item.Run)
				NexoUI:CloseCommandPalette()
			end)
		end
	end

	local function filter()
		local query = box.Text:lower()
		shown = {}
		for _, item in ipairs(targets) do
			if query == "" or item.Search:find(query, 1, true) then
				table.insert(shown, item)
				if #shown >= 40 then break end
			end
		end
		selected = 1
		render()
	end
	box:GetPropertyChangedSignal("Text"):Connect(filter)
	filter()
	task.defer(function() pcall(function() box:CaptureFocus() end) end)

	local connection
	connection = UserInputService.InputBegan:Connect(function(input)
		if not gui.Parent then connection:Disconnect() return end
		if input.KeyCode == Enum.KeyCode.Escape then
			NexoUI:CloseCommandPalette()
		elseif input.KeyCode == Enum.KeyCode.Down then
			selected = math.min(selected + 1, math.max(#shown, 1))
			render()
		elseif input.KeyCode == Enum.KeyCode.Up then
			selected = math.max(selected - 1, 1)
			render()
		elseif input.KeyCode == Enum.KeyCode.Return then
			local item = shown[selected]
			if item then
				Util.safe(item.Run)
				NexoUI:CloseCommandPalette()
			end
		end
	end)
	return gui
end


				Size = UDim2.fromOffset(5, 5),
				BackgroundColor3 = tag and theme[TAGS[tag] or "Info"] or theme.MutedText,
				ZIndex = 7,
				Parent = line,
			}, { Util.corner(999) })
			Util.label({
				Position = UDim2.fromOffset(14, 0),
				Size = UDim2.new(1, -14, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Text = tag and ("[" .. tag:upper() .. "] " .. text) or text,
				Font = FONT.Regular,
				TextSize = 12.5,
				TextColor3 = theme.SubText,
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
				LineHeight = 1.25,
				ZIndex = 7,
				Parent = line,
			})
		end
	end

	local buttonRow = Util.new("Frame", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		LayoutOrder = 4,
		ZIndex = 4,
		Parent = panel,
	})
	local buttonList = Util.list(8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right)
	buttonList.Parent = buttonRow

	local changelog = { Gui = gui, Panel = panel }
	function changelog:Close()
		Util.tween(panel, 0.2, { Size = UDim2.fromOffset(panel.AbsoluteSize.X, 0) })
		task.delay(0.24, function() pcall(function() gui:Destroy() end) end)
		if config.ShowOnce then
			if typeof(writefile) == "function" then
				pcall(writefile, stateFile, version)
			else
				NexoUI._seenChangelog = version
			end
		end
		Util.safe(config.OnClose)
	end

	if config.CopyButton ~= false then
		local copyButton = Util.new("TextButton", {
			Text = "Copy",
			AutoButtonColor = false,
			Font = FONT.Bold,
			TextSize = 12.5,
			TextColor3 = theme.Text,
			Size = UDim2.fromOffset(78, 34),
			BackgroundColor3 = theme.Button,
			LayoutOrder = 1,
			ZIndex = 5,
			Parent = buttonRow,
		}, { Util.corner(9) })
		Util.stroke(theme.Border, 0.85, 1).Parent = copyButton
		copyButton.Activated:Connect(function()
			local lines = {}
			for _, entry in ipairs(entries) do
				table.insert(lines, tostring(entry.Version or entry.Name or ""))
				for _, change in ipairs(entry.Changes or entry.Notes or {}) do
					local text = typeof(change) == "table" and tostring(change.Text or change[1] or "") or tostring(change)
					table.insert(lines, "  - " .. text)
				end
			end
			NexoUI:CopyWithToast(table.concat(lines, "\n"), "Changelog")
		end)
	end
	local okButton = Util.new("TextButton", {
		Text = tostring(config.ButtonText or "Continue"),
		AutoButtonColor = false,
		Font = FONT.Bold,
		TextSize = 12.5,
		TextColor3 = theme.Text,
		Size = UDim2.fromOffset(110, 34),
		BackgroundColor3 = theme.ToggleOn,
		LayoutOrder = 2,
		ZIndex = 5,
		Parent = buttonRow,
	}, { Util.corner(9) })
	Util.stroke(theme.Border, 0.5, 1).Parent = okButton
	okButton.Activated:Connect(function() changelog:Close() end)
	return changelog
end

-- =====================================================================
--  19. COMPONENT GROUPING
--  A group is a named bag of components. Groups can be purely logical
--  (created on demand) or visual (a real container in the page).
-- =====================================================================
NexoUI.GroupRegistry = {}

local GroupMethods = {}

function GroupMethods:Add(component)
	if not component then return self end
	local members = self.Members or self.Children
	if not table.find(members, component) then table.insert(members, component) end
	component.Groups = component.Groups or {}
	if not table.find(component.Groups, self.Name) then
		table.insert(component.Groups, self.Name)
	end
	return self
end

function GroupMethods:Remove(component)
	local members = self.Members or self.Children
	local index = table.find(members, component)
	if index then table.remove(members, index) end
	return self
end

function GroupMethods:Members_()
	local members = self.Members or self.Children
	local alive = {}
	for _, component in ipairs(members) do
		if component and not component.Destroyed then table.insert(alive, component) end
	end
	return alive
end

function GroupMethods:ForEach(fn)
	if typeof(fn) ~= "function" then return self end
	for _, component in ipairs(self:Members_()) do Util.safe(fn, component) end
	return self
end

function GroupMethods:SetVisible(visible)
	if self.Frame then
		self.Frame.Visible = visible ~= false
		self.UserVisible = visible ~= false
	else
		self:ForEach(function(component)
			if component.SetVisible then component:SetVisible(visible) end
		end)
	end
	return self
end

function GroupMethods:SetEnabled(state)
	self:ForEach(function(component)
		if component.SetEnabled then component:SetEnabled(state) end
	end)
	return self
end

function GroupMethods:Get()
	local values = {}
	for _, component in ipairs(self:Members_()) do
		if component.Name and component.Get then values[component.Name] = component:Get() end
	end
	return values
end

function GroupMethods:Set(values)
	if typeof(values) ~= "table" then return self end
	for _, component in ipairs(self:Members_()) do
		if component.Name ~= nil and values[component.Name] ~= nil and component.Set then
			component:Set(values[component.Name])
		end
	end
	return self
end

function GroupMethods:Reset()
	self:ForEach(function(component)
		if component.DefaultValue ~= nil and component.Set then
			component:Set(component.DefaultValue)
		end
	end)
	return self
end

function GroupMethods:Count() return #self:Members_() end

function GroupMethods:DestroyMembers()
	for _, component in ipairs(self:Members_()) do
		pcall(function() component:Destroy() end)
	end
	local members = self.Members or self.Children
	table.clear(members)
	return self
end

-- Logical group lookup / creation.
function NexoUI:Group(name)
	name = tostring(name)
	local group = NexoUI.GroupRegistry[name]
	if group then return group end
	group = { Name = name, Members = {}, IsGroup = true }
	for key, fn in pairs(GroupMethods) do group[key] = fn end
	group.GetMembers = GroupMethods.Members_
	NexoUI.GroupRegistry[name] = group
	return group
end

function NexoUI:ListGroups()
	local names = {}
	for name in pairs(NexoUI.GroupRegistry) do table.insert(names, name) end
	table.sort(names)
	return names
end

-- Visual group: a real container that is also registered as a group.
function ContainerMethods:CreateGroup(config)
	if typeof(config) ~= "table" then config = { Name = tostring(config or "Group") } end
	local frame = Util.new("Frame", {
		Name = "Group_" .. tostring(config.Name or "Group"),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = tonumber(config.Order) or (#self.Children + 1),
		ZIndex = LAYER.Content + 3,
		Parent = self.Content,
	}, { Util.list(tonumber(config.Spacing) or 10) })
	local group = NexoUI.MakeContainer({
		Name = tostring(config.Name or "Group"),
		Frame = frame,
		Tab = self.Tab,
		Config = config,
		IsGroup = true,
	}, self.Window, frame)
	for key, fn in pairs(GroupMethods) do group[key] = fn end
	group.GetMembers = GroupMethods.Members_
	group.Destroy = function(this)
		this:Clear()
		pcall(function() frame:Destroy() end)
		NexoUI.GroupRegistry[this.Name] = nil
	end
	NexoUI.GroupRegistry[group.Name] = group
	table.insert(self.Children, group)
	return group
end

-- =====================================================================
--  20. COMPONENT CLONING
-- =====================================================================
local function mergeConfig(base, overrides)
	local out = {}
	if typeof(base) == "table" then
		for key, value in pairs(base) do out[key] = value end
	end
	if typeof(overrides) == "table" then
		for key, value in pairs(overrides) do out[key] = value end
	end
	out.Flag = overrides and overrides.Flag or nil
	return out
end

function NexoUI.ComponentClass:Clone(target, overrides)
	if not target or not target.IsContainer then
		Util.warn("Clone needs a target container")
		return nil
	end
	if not self.Type then
		Util.warn("this component cannot be cloned")
		return nil
	end
	local config = mergeConfig(self.Config, overrides)
	if config.Default == nil and self.Value ~= nil and typeof(self.Value) ~= "table" then
		config.Default = self.Value
	end
	return NexoUI.Build(target, self.Type, config)
end

-- Clones a whole container (section, group or column) into another container.
function ContainerMethods:Clone(target, overrides)
	if not target or not target.IsContainer then
		Util.warn("Clone needs a target container")
		return nil
	end
	local copy
	if self.Config and self.Body then
		copy = target:CreateSection(mergeConfig(self.Config, overrides))
	else
		copy = target:CreateGroup(mergeConfig(self.Config or { Name = self.Name }, overrides))
	end
	for _, child in ipairs(self.Children) do
		if child.IsContainer then
			Util.safe(function() child:Clone(copy) end)
		elseif child.Clone then
			Util.safe(function() child:Clone(copy) end)
		end
	end
	return copy
end

function NexoUI:CloneComponent(component, target, overrides)
	if not component or not component.Clone then return nil end
	return component:Clone(target, overrides)
end

-- =====================================================================
--  21. GLOBAL NOTIFICATION QUEUE MANAGER
--  Window:Notify now goes through a single queue so bursts of toasts
--  never overlap and never spam more than MaxVisible at a time.
-- =====================================================================
local Notifications = {
	MaxVisible = 4,
	Queue = {},
	Active = {},
	History = {},
	HistoryLimit = 50,
	Paused = false,
	Muted = false,
}
NexoUI.NotificationManager = Notifications
Notifications.Changed = Signal.new()

local rawNotify = Window.Notify
Window.RawNotify = rawNotify

function Notifications:_pump()
	while not self.Paused and #self.Active < self.MaxVisible and #self.Queue > 0 do
		local entry = table.remove(self.Queue, 1)
		if entry.Cancelled then
			-- skip
		elseif not entry.Window or not entry.Window.Gui or not entry.Window.Gui.Parent then
			-- window is gone, drop it
		else
			local config = {}
			for key, value in pairs(entry.Config) do config[key] = value end
			config.Max = 99
			config.OnClose = function()
				for index, active in ipairs(self.Active) do
					if active == entry then table.remove(self.Active, index) break end
				end
				Util.safe(entry.Config.OnClose)
				self.Changed:Fire("closed", entry)
				task.defer(function() self:_pump() end)
			end
			local ok, toast = pcall(rawNotify, entry.Window, config)
			if ok and toast then
				entry.Toast = toast
				table.insert(self.Active, entry)
				self.Changed:Fire("shown", entry)
			end
		end
	end
end

function Notifications:Push(window, config)
	if typeof(config) ~= "table" then config = { Title = tostring(config or "") } end
	local entry = {
		Window = window,
		Config = config,
		Priority = tonumber(config.Priority) or 0,
		Id = config.Id and tostring(config.Id) or nil,
		Time = os.time(),
	}
	if self.Muted then return { Close = function() end, Cancelled = true } end
	if entry.Id then
		for _, queued in ipairs(self.Queue) do
			if queued.Id == entry.Id then return queued end
		end
		for _, active in ipairs(self.Active) do
			if active.Id == entry.Id then return active end
		end
	end

	table.insert(self.History, 1, {
		Title = config.Title, Content = config.Content or config.Description,
		Type = config.Type, Time = entry.Time,
	})
	while #self.History > self.HistoryLimit do table.remove(self.History) end

	table.insert(self.Queue, entry)
	table.sort(self.Queue, function(a, b)
		if a.Priority == b.Priority then return a.Time < b.Time end
		return a.Priority > b.Priority
	end)
	function entry:Close()
		self.Cancelled = true
		if self.Toast then self.Toast:Close() end
	end
	self:_pump()
	self.Changed:Fire("queued", entry)
	return entry
end

function Notifications:SetMaxVisible(count)
	self.MaxVisible = math.max(1, math.floor(tonumber(count) or 4))
	self:_pump()
	return self
end
function Notifications:Pause() self.Paused = true return self end
function Notifications:Resume() self.Paused = false self:_pump() return self end
function Notifications:Mute(state) self.Muted = state ~= false return self end
function Notifications:Pending() return #self.Queue end
function Notifications:VisibleCount() return #self.Active end
function Notifications:GetHistory() return table.clone(self.History) end
function Notifications:Clear()
	table.clear(self.Queue)
	for _, entry in ipairs(table.clone(self.Active)) do
		if entry.Toast then pcall(function() entry.Toast:Close() end) end
	end
	table.clear(self.Active)
	return self
end

function Window:Notify(config)
	return Notifications:Push(self, config)
end

-- =====================================================================
--  22. PROFILES / MULTI CONFIG SWITCHING
-- =====================================================================
local Profiles = {
	Active = "default",
	Store = {},
	Folder = "NexoUI",
	AutoSave = false,
}
NexoUI.Profiles = Profiles
Profiles.Changed = Signal.new()

local function fsReady()
	return typeof(writefile) == "function" and typeof(readfile) == "function"
end

local function ensureFolder(path)
	if typeof(makefolder) ~= "function" then return end
	if typeof(isfolder) == "function" then
		local ok, exists = pcall(isfolder, path)
		if ok and exists then return end
	end
	pcall(makefolder, path)
end

function Profiles:_path(name)
	return self.Folder .. "/" .. tostring(name) .. ".json"
end

function Profiles:Save(name)
	name = tostring(name or self.Active)
	local data = NexoUI:GetConfig()
	self.Store[name] = data
	if fsReady() then
		ensureFolder(self.Folder)
		local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
		if ok then pcall(writefile, self:_path(name), encoded) end
	end
	self.Changed:Fire("save", name)
	NexoUI.FireHook("ProfileSaved", name)
	return true
end

function Profiles:Load(name)
	name = tostring(name or self.Active)
	local data = self.Store[name]
	if not data and fsReady() then
		local path = self:_path(name)
		local exists = true
		if typeof(isfile) == "function" then
			local ok, found = pcall(isfile, path)
			exists = ok and found
		end
		if exists then
			local ok, contents = pcall(readfile, path)
			if ok then
				local decoded, parsed = pcall(function() return HttpService:JSONDecode(contents) end)
				if decoded then data = parsed end
			end
		end
	end
	if not data then
		Util.warn("profile '" .. name .. "' was not found")
		return false
	end
	self.Store[name] = data
	self.Active = name
	NexoUI:LoadConfig(data)
	self.Changed:Fire("load", name)
	NexoUI.FireHook("ProfileLoaded", name)
	return true
end

function Profiles:Delete(name)
	name = tostring(name)
	self.Store[name] = nil
	if typeof(delfile) == "function" then pcall(delfile, self:_path(name)) end
	self.Changed:Fire("delete", name)
	return true
end

function Profiles:List()
	local names, seen = {}, {}
	for name in pairs(self.Store) do
		if not seen[name] then table.insert(names, name) seen[name] = true end
	end
	if typeof(listfiles) == "function" then
		local ok, files = pcall(listfiles, self.Folder)
		if ok and typeof(files) == "table" then
			for _, path in ipairs(files) do
				local name = tostring(path):match("([^/\\]+)%.json$")
				if name and not seen[name] then table.insert(names, name) seen[name] = true end
			end
		end
	end
	if #names == 0 then table.insert(names, "default") end
	table.sort(names)
	return names
end

function Profiles:Switch(name)
	if self.AutoSave then self:Save(self.Active) end
	return self:Load(name)
end

function Profiles:GetActive() return self.Active end
function Profiles:SetAutoSave(state) self.AutoSave = state ~= false return self end

function Profiles:Reset()
	NexoUI:ResetValues()
	self.Changed:Fire("reset", self.Active)
	return self
end

function NexoUI:SaveProfile(name) return Profiles:Save(name) end
function NexoUI:LoadProfile(name) return Profiles:Load(name) end
function NexoUI:DeleteProfile(name) return Profiles:Delete(name) end
function NexoUI:ListProfiles() return Profiles:List() end
function NexoUI:SwitchProfile(name) return Profiles:Switch(name) end
function NexoUI:GetActiveProfile() return Profiles:GetActive() end


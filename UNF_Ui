	})
	self.Value = Util.color(config.Default or config.Color, Color3.fromRGB(255, 42, 58))
	self.Alpha = tonumber(config.Transparency) or 0
	local h, s, v = self.Value:ToHSV()

	local swatch = Util.new("TextButton", {
		Name = "Swatch",
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(46, 28),

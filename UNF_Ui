		dropdown:Refresh(Profiles:List(), true)
		dropdown:Set(Profiles:GetActive(), true)
	end
	columns[1]:CreateButton({
		Name = "Save profile",
		Callback = function()
			local name = nameBox:Get()
			if name == "" then name = dropdown:Get() or Profiles:GetActive() end
			Profiles:Save(name)
			refresh()
			if self.Window then
				self.Window:Notify({ Title = "Profile saved", Content = name, Type = "Success", Duration = 3 })
			end
		end,
	})
	columns[2]:CreateButton({
		Name = "Load profile",
		Callback = function()
			local name = dropdown:Get()
			if not name then return end
			local ok = Profiles:Switch(name)
			if self.Window then
				self.Window:Notify({
					Title = ok and "Profile loaded" or "Profile missing",
					Content = name, Type = ok and "Success" or "Error", Duration = 3,
				})
			end
		end,
	})
	columns[1]:CreateButton({
		Name = "Delete profile",
		Callback = function()
			local name = dropdown:Get()
			if not name then return end
			Profiles:Delete(name)
			refresh()
		end,
	})
	columns[2]:CreateButton({
		Name = "Reset values",
		Callback = function()
			NexoUI:ResetValues()
			if self.Window then
				self.Window:Notify({ Title = "Values reset", Type = "Info", Duration = 3 })
			end
		end,
	})

	self.Dropdown = dropdown
	self.Refresh = function() refresh() return self end
	self.Destroy = function(this)
		inner:Clear()
		this.Maid:Clean()
		pcall(function() host:Destroy() end)
	end
	return self
end)


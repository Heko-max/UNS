-- =====================================================================
--  15. BUILD PIPELINE WRAPPER
--  Adds access gating, groups, copy buttons, keybind registration,
--  default tracking and lifecycle hooks to every component.
-- =====================================================================
local coreBuild = NexoUI.Build
function NexoUI.Build(container, name, config)
	local component = coreBuild(container, name, config)
	if not component then return nil end
	config = typeof(config) == "table" and config or {}
	component.DefaultValue = config.Default
	if config.Copyable == true then
		Util.safe(attachCopyButton, component, config)
	end
	Util.safe(function() Access:Attach(component, config) end)
	if config.Group then
		Util.safe(function() NexoUI:Group(config.Group):Add(component) end)
	end
	if component.Type == "Keybind" then
		Util.safe(function() NexoUI.Keybinds:Track(component) end)
	end
	NexoUI.FireHook("ComponentCreated", component, container)
	return component
end

-- Sections and tabs can be gated too.
local coreSection = ContainerMethods.CreateSection
function ContainerMethods:CreateSection(config)
	local section = coreSection(self, config)
	if section and typeof(config) == "table" then
		Util.safe(function() Access:Attach(section, config) end)
	end
	NexoUI.FireHook("SectionCreated", section, self)
	return section
end

local coreTab = Window.CreateTab
function Window:CreateTab(config)
	local tab = coreTab(self, config)
	if tab and typeof(config) == "table" then
		Util.safe(function() Access:Attach(tab, config, tab.Button) end)
	end
	NexoUI.FireHook("TabCreated", tab, self)
	return tab
end


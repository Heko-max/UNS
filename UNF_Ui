-- =====================================================================
--  24. RESPONSIVE BREAKPOINT MANAGER
-- =====================================================================
NexoUI.Breakpoints = { Mobile = 0, Tablet = 640, Laptop = 1024, Desktop = 1440 }
NexoUI.Responsive = { Current = nil, Changed = Signal.new() }

local function computeBreakpoint(width)
	local best, bestValue = "Mobile", -math.huge
	for name, threshold in pairs(NexoUI.Breakpoints) do
		local value = tonumber(threshold) or 0
		if width >= value and value >= bestValue then
			best, bestValue = name, value
		end
	end
	return best
end

function NexoUI:GetBreakpoint()
	return NexoUI.Responsive.Current or computeBreakpoint(Camera.ViewportSize.X)
end

function NexoUI:GetViewportClass()
	local vp = Camera.ViewportSize
	return {
		Breakpoint = NexoUI:GetBreakpoint(),
		Width = vp.X,
		Height = vp.Y,
		Aspect = vp.X / math.max(vp.Y, 1),
		Touch = Util.isMobile(),
	}
end

function NexoUI:SetBreakpoints(table_)
	if typeof(table_) ~= "table" then return self end
	for name, value in pairs(table_) do
		NexoUI.Breakpoints[tostring(name)] = tonumber(value) or 0
	end
	NexoUI.Responsive.Current = nil
	NexoUI.EvaluateBreakpoint()
	return self
end

function NexoUI:OnBreakpoint(fn)
	if typeof(fn) ~= "function" then return function() end end
	local connection = NexoUI.Responsive.Changed:Connect(fn)
	Util.safe(fn, NexoUI:GetBreakpoint(), Camera.ViewportSize)
	return connection
end

function Window:OnBreakpoint(fn)
	return NexoUI:OnBreakpoint(fn)
end

function NexoUI.EvaluateBreakpoint()
	local vp = Camera.ViewportSize
	local name = computeBreakpoint(vp.X)
	if name ~= NexoUI.Responsive.Current then
		NexoUI.Responsive.Current = name
		NexoUI.Responsive.Changed:Fire(name, vp)
		NexoUI.FireHook("BreakpointChanged", name, vp)
	end
	return name
end

do
	local scheduled = false
	Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		if scheduled then return end
		scheduled = true
		task.delay(0.08, function()
			scheduled = false
			NexoUI.EvaluateBreakpoint()
		end)
	end)

-- ---------------------------------------------------------------- 2. util
local Util = {}
NexoUI.Util = Util

function Util.warn(...)
	warn("[NexoUI]", ...)
end

-- Runs a user supplied callback. A broken callback must never break the UI.
function Util.safe(fn, ...)
	if typeof(fn) ~= "function" then return false end
	local ok, err = pcall(fn, ...)
	if not ok then Util.warn("callback error: " .. tostring(err)) end
	return ok
end

-- Shallow copy of a dictionary.
function Util.copy(t)
	local out = {}
	if typeof(t) == "table" then
		for k, v in pairs(t) do out[k] = v end
	end
	return out
end

-- Reads a config value with a type check and a safe default.
function Util.opt(cfg, key, expected, default)
	local v = cfg[key]
	if v == nil then return default end
	if expected and typeof(v) ~= expected then
		Util.warn(("'%s' should be a %s, got %s - using default"):format(tostring(key), expected, typeof(v)))
		return default
	end
	return v
end

-- Instance factory. Properties first, Parent last (one reflow instead of many).
function Util.new(class, props, children)
	local ok, inst = pcall(Instance.new, class)
	if not ok or not inst then
		Util.warn("cannot create instance of class " .. tostring(class))
		return nil
	end
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
		inst.AutoLocalize = false
	end
	local parent
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then
				parent = v
			else
				local set = pcall(function() inst[k] = v end)
				if not set then
					Util.warn(("cannot set %s.%s"):format(class, tostring(k)))
				end
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			if child then child.Parent = inst end
		end
	end
	if parent then inst.Parent = parent end
	return inst
end

function Util.tween(inst, dur, goal, style, dir)
	if not inst or not inst.Parent then return end
	local info = TweenInfo.new(dur or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
	local ok, t = pcall(TweenService.Create, TweenService, inst, info, goal)
	if ok and t then t:Play() return t end
end

-- ------- layout helpers (used everywhere so layout stays consistent) -------
function Util.corner(radius)
	return Util.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function Util.stroke(color, transparency, thickness)
	return Util.new("UIStroke", {
		Color = color or Color3.new(1, 1, 1),
		Transparency = transparency or 0.6,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Util.gradient(colors, rotation, transparency)
	return Util.new("UIGradient", {
		Color = colors,
		Rotation = rotation or 0,
		Transparency = transparency or NumberSequence.new(0),
	})
end

-- ColorSequence from a list of {position, Color3} pairs.
function Util.cseq(...)
	local points = {}
	for _, p in ipairs({ ... }) do
		table.insert(points, ColorSequenceKeypoint.new(p[1], p[2]))
	end
	return ColorSequence.new(points)
end

function Util.pad(top, right, bottom, left)
	return Util.new("UIPadding", {
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or top or 0),
		PaddingBottom = UDim.new(0, bottom or top or 0),
		PaddingLeft = UDim.new(0, left or right or top or 0),
	})
end

function Util.list(padding, direction, align, sort)
	return Util.new("UIListLayout", {
		Padding = UDim.new(0, padding or 0),
		FillDirection = direction or Enum.FillDirection.Vertical,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		SortOrder = sort or Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Top,
	})
end

function Util.grid(cellW, cellH, padX, padY)
	return Util.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(cellW, cellH),
		CellPadding = UDim2.fromOffset(padX or 8, padY or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

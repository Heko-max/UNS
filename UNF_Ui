-- =====================================================================
--  11. CONFIG + PUBLIC API
-- =====================================================================
local function serialize(value)
	local t = typeof(value)
	if t == "Color3" then
		return { __type = "Color3", math.floor(value.R * 255 + 0.5), math.floor(value.G * 255 + 0.5), math.floor(value.B * 255 + 0.5) }
	elseif t == "EnumItem" then
		return { __type = "KeyCode", value.Name }
	elseif t == "table" then
		local out = {}
		for i, v in ipairs(value) do out[i] = serialize(v) end
		return out
	end
	return value
end

local function deserialize(value)
	if typeof(value) == "table" then
		if value.__type == "Color3" then
			return Color3.fromRGB(value[1] or 0, value[2] or 0, value[3] or 0)
		elseif value.__type == "KeyCode" then
			return Enum.KeyCode[value[1]] or nil
		end
		local out = {}
		for i, v in ipairs(value) do out[i] = deserialize(v) end
		return out
	end
	return value
end

-- Returns { flag = value } for every component created with a Flag.
function NexoUI:GetConfig()
	local data = {}
	for flag, component in pairs(NexoUI.Flags) do
		if component and not component.Destroyed then
			data[flag] = serialize(component:Get())
		end
	end
	return data
end

function NexoUI:LoadConfig(data)
	if typeof(data) ~= "table" then
		Util.warn("LoadConfig expects a table")
		return false
	end
	for flag, value in pairs(data) do
		local component = NexoUI.Flags[flag]
		if component and not component.Destroyed then
			Util.safe(function() component:Set(deserialize(value)) end)
		end
	end
	return true
end

-- Optional file persistence. Only works where writefile/readfile exist.
function NexoUI:SaveConfigToFile(path)
	local write = writefile
	if typeof(write) ~= "function" then
		Util.warn("file saving is not available in this environment")
		return false
	end
	local ok, encoded = pcall(function()
		return HttpService:JSONEncode(NexoUI:GetConfig())
	end)
	if not ok then
		Util.warn("could not encode config: " .. tostring(encoded))
		return false
	end
	local wrote = pcall(write, tostring(path or "NexoUI.json"), encoded)
	return wrote
end

function NexoUI:LoadConfigFromFile(path)
	local read = readfile
	local exists = isfile
	path = tostring(path or "NexoUI.json")
	if typeof(read) ~= "function" then return false end
	if typeof(exists) == "function" then
		local ok, found = pcall(exists, path)
		if not ok or not found then return false end
	end
	local ok, contents = pcall(read, path)
	if not ok then return false end
	local decoded, data = pcall(function() return HttpService:JSONDecode(contents) end)
	if not decoded then return false end
	return NexoUI:LoadConfig(data)
end

function NexoUI:GetFlag(flag)
	local component = NexoUI.Flags[tostring(flag)]
	if component then return component:Get() end
end

function NexoUI:SetFlag(flag, value)
	local component = NexoUI.Flags[tostring(flag)]
	if component then component:Set(value) end
	return self
end

-- Convenience: notify through the most recently created window.
function NexoUI:Notify(config)
	local window = NexoUI.Windows[#NexoUI.Windows]
	if not window then
		Util.warn("Notify called before any window was created")
		return
	end
	return window:Notify(config)
end

function NexoUI:GetWindow(index)
	return NexoUI.Windows[index or #NexoUI.Windows]
end

function NexoUI:DestroyAll()
	for _, window in ipairs(table.clone(NexoUI.Windows)) do
		pcall(function() window:Destroy() end)
	end
	table.clear(NexoUI.Flags)
end

function NexoUI:ListComponents()
	local names = {}
	for name in pairs(NexoUI.Components) do table.insert(names, name) end
	table.sort(names)
	return names
end

-- =====================================================================
--  12. HOOKS + BUILD PIPELINE EXTENSIONS
--  Everything below plugs into the core without modifying it, so the
--  base component code stays small and these systems stay optional.
-- =====================================================================
NexoUI.Hooks = {}

function NexoUI:Hook(event, fn)
	if typeof(event) ~= "string" or typeof(fn) ~= "function" then
		Util.warn("Hook expects (string, function)")
		return function() end
	end
	NexoUI.Hooks[event] = NexoUI.Hooks[event] or {}
	table.insert(NexoUI.Hooks[event], fn)
	return function()
		local list = NexoUI.Hooks[event]
		if not list then return end
		for i, f in ipairs(list) do
			if f == fn then table.remove(list, i) break end
		end
	end
end

function NexoUI.FireHook(event, ...)
	local list = NexoUI.Hooks[event]
	if not list then return end
	for _, fn in ipairs(list) do Util.safe(fn, ...) end
end

-- Standalone overlay ScreenGui (key system, splash, loading, palette...)
local function standaloneGui(name, order)
	local parent
	if typeof(gethui) == "function" then
		local ok, hidden = pcall(gethui)
		if ok and hidden then parent = hidden end
	end
	if not parent then
		local ok, playerGui = pcall(function()
			return LocalPlayer:FindFirstChildOfClass("PlayerGui")
				or LocalPlayer:WaitForChild("PlayerGui", 5)
		end)
		if ok then parent = playerGui end
	end
	if not parent then
		local ok, core = pcall(function() return game:GetService("CoreGui") end)
		if ok then parent = core end
	end
	local gui = Util.new("ScreenGui", {
		Name = name or "NexoOverlay",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = order or 999999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = parent,
	})
	if typeof(syn) == "table" and typeof(syn.protect_gui) == "function" then
		pcall(syn.protect_gui, gui)
	end
	return gui
end
NexoUI.StandaloneGui = standaloneGui


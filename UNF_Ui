-- =====================================================================
--  25. KEYBIND CONFLICT MANAGER
-- =====================================================================
local Keybinds = {
	Registry = {},
	Reserved = {},
	AllowConflicts = false,
	_applying = false,
}
NexoUI.Keybinds = Keybinds
Keybinds.Changed = Signal.new()

local function keyName(key)
	if typeof(key) == "EnumItem" then return key.Name end
	return nil
end

function Keybinds:Reserve(key, label)
	local name = keyName(key)
	if not name then return self end
	self.Reserved[name] = tostring(label or "reserved")
	return self
end

function Keybinds:Owner(key, ignore)
	local name = keyName(key)
	if not name then return nil end
	if self.Reserved[name] then return self.Reserved[name] end
	for _, entry in ipairs(self.Registry) do
		if entry.Component ~= ignore and keyName(entry.Key) == name then
			return entry.Component.Name or "keybind"
		end
	end
	return nil
end

function Keybinds:IsTaken(key, ignore)
	return self:Owner(key, ignore) ~= nil
end

function Keybinds:_entry(component)
	for _, entry in ipairs(self.Registry) do
		if entry.Component == component then return entry end
	end
	return nil
end

function Keybinds:Track(component)
	if self:_entry(component) then return end
	local entry = { Component = component, Key = component.Value }
	table.insert(self.Registry, entry)
	component.Maid:Give(component.Changed:Connect(function(value)
		if self._applying then return end
		if typeof(value) ~= "EnumItem" then
			entry.Key = nil
			return
		end
		local owner = self:Owner(value, component)
		if owner and not self.AllowConflicts then
			local window = component.Window or NexoUI.Windows[#NexoUI.Windows]
			if window then
				window:Notify({
					Title = "Keybind conflict",
					Content = value.Name .. " is already used by " .. owner,
					Type = "Warning",
					Duration = 4,
				})
			end
			Util.safe(component.Config and component.Config.OnConflict, value, owner)
			self._applying = true
			component:Set(entry.Key, true)
			self._applying = false
			self.Changed:Fire("rejected", component, value, owner)
			return
		end
		entry.Key = value
		self.Changed:Fire("bound", component, value)
	end))
	component.Maid:Give(function() self:Unregister(component) end)
	return entry
end

function Keybinds:Unregister(component)
	for index, entry in ipairs(self.Registry) do
		if entry.Component == component then
			table.remove(self.Registry, index)
			return true
		end
	end
	return false
end

function Keybinds:List()
	local out = {}
	for _, entry in ipairs(self.Registry) do
		if entry.Component and not entry.Component.Destroyed then
			table.insert(out, {
				Name = entry.Component.Name,
				Key = entry.Key and entry.Key.Name or "None",
			})
		end
	end
	return out
end

function Keybinds:GetConflicts()
	local byKey, conflicts = {}, {}
	for _, entry in ipairs(self.Registry) do
		local name = keyName(entry.Key)
		if name then
			byKey[name] = byKey[name] or {}
			table.insert(byKey[name], entry.Component.Name or "keybind")
		end
	end
	for name, owners in pairs(byKey) do
		if #owners > 1 or self.Reserved[name] then
			if self.Reserved[name] then table.insert(owners, self.Reserved[name]) end
			if #owners > 1 then
				table.insert(conflicts, { Key = name, Owners = owners })
			end
		end
	end
	table.sort(conflicts, function(a, b) return a.Key < b.Key end)
	return conflicts
end

function Keybinds:SetAllowConflicts(state)
	self.AllowConflicts = state == true
	return self
end

function NexoUI:GetKeybinds() return Keybinds:List() end
function NexoUI:GetKeybindConflicts() return Keybinds:GetConflicts() end
function NexoUI:ReserveKey(key, label) return Keybinds:Reserve(key, label) end

-- =====================================================================
--  26. UI RESET / RESTORE
-- =====================================================================
NexoUI.RestorePoints = {}

function NexoUI:CreateRestorePoint(name)
	name = tostring(name or "auto")
	local snapshot = { Theme = NexoUI.Theme.Name, Values = NexoUI:GetConfig(), Windows = {} }
	for _, window in ipairs(NexoUI.Windows) do
		if window.Root and window.Root.Parent then
			table.insert(snapshot.Windows, {
				Window = window,
				Position = window.Root.Position,
				Size = window.BaseSize,
				Visible = window.Visible,
				Minimized = window.Minimized,
				Tab = window.ActiveTab and window.ActiveTab.Name or nil,
			})
		end
	end
	NexoUI.RestorePoints[name] = snapshot
	return snapshot
end

function NexoUI:Restore(name)
	local snapshot = NexoUI.RestorePoints[tostring(name or "auto")]
	if not snapshot then
		Util.warn("restore point '" .. tostring(name) .. "' does not exist")
		return false
	end
	if snapshot.Theme then NexoUI:ApplyPreset(snapshot.Theme) end
	for _, state in ipairs(snapshot.Windows) do
		local window = state.Window
		if window and window.Root and window.Root.Parent then
			window.BaseSize = state.Size
			window.Root.Position = state.Position
			if state.Minimized ~= window.Minimized then window:Minimize(state.Minimized) end
			if state.Visible then window:Show() else window:Hide() end
			if state.Tab then
				local tab = window:GetTab(state.Tab)
				if tab then window:SelectTab(tab) end
			end
			window:_Refresh()
		end
	end
	NexoUI:LoadConfig(snapshot.Values)
	return true
end

function NexoUI:ListRestorePoints()
	local names = {}
	for name in pairs(NexoUI.RestorePoints) do table.insert(names, name) end
	table.sort(names)
	return names
end

function NexoUI:DeleteRestorePoint(name)
	NexoUI.RestorePoints[tostring(name)] = nil
	return true
end

-- Puts every component back to the value it was created with.
function NexoUI:ResetValues()
	for _, component in pairs(NexoUI.Flags) do
		if component and not component.Destroyed and component.DefaultValue ~= nil then
			Util.safe(function() component:Set(component.DefaultValue) end)
		end
	end
	NexoUI.FireHook("ValuesReset")
	return self
end

-- Recovers windows that were dragged off screen or badly resized.
function Window:ResetLayout()
	self.BaseSize = self.DefaultSize or self.BaseSize
	self.Root.Position = UDim2.fromScale(0.5, 0.5)
	self.Root.AnchorPoint = Vector2.new(0.5, 0.5)
	self:Show()
	if self.Minimized then self:Minimize(false) end
	self:_Refresh()
	return self
end

function NexoUI:ResetUI()
	for _, window in ipairs(NexoUI.Windows) do
		Util.safe(function() window:ResetLayout() end)
	end
	return self
end


-- =====================================================================
--  13. ACCESS CONTROL - keys, permissions, feature unlocks
--  Features 2, 3 and 4 all resolve through one gate evaluator so a
--  component can require any combination of them.
-- =====================================================================
local Access = {
	Keys = {},
	Permissions = {},
	Features = {},
	Role = nil,
	Gates = {},
	Keyless = true,
}
Access.Changed = Signal.new()
NexoUI.Access = Access

local function nameList(value)
	local out = {}
	if value == nil then return out end
	if typeof(value) == "table" then
		for key, item in pairs(value) do
			if typeof(key) == "string" and item == true then
				table.insert(out, key)
			elseif typeof(item) == "string" then
				table.insert(out, item)
			end
		end
	elseif value == true then
		table.insert(out, "default")
	else
		table.insert(out, tostring(value))
	end
	return out
end

function Access:HasKey(name)
	return self.Keys[tostring(name == true and "default" or name)] == true
end

function Access:UnlockKey(name, silent)
	name = tostring(name == true and "default" or name)
	self.Keys[name] = true
	self.Keyless = false
	self:Refresh()
	self.Changed:Fire("key", name, true)
	NexoUI.FireHook("KeyUnlocked", name)
	if not silent then
		local window = NexoUI.Windows[#NexoUI.Windows]
		if window then
			window:Notify({ Title = "Access granted", Content = "Unlocked: " .. name, Type = "Success", Duration = 4 })
		end
	end
	return self
end

function Access:LockKey(name)
	self.Keys[tostring(name)] = nil
	self:Refresh()
	self.Changed:Fire("key", tostring(name), false)
	return self
end

function Access:GetKeys()
	local out = {}
	for key in pairs(self.Keys) do table.insert(out, key) end
	table.sort(out)
	return out
end

function Access:SetPermissions(list)
	self.Permissions = {}
	for _, name in ipairs(nameList(list)) do self.Permissions[name] = true end
	self:Refresh()
	self.Changed:Fire("permissions", self:GetPermissions(), true)
	return self
end

function Access:AddPermission(name)
	self.Permissions[tostring(name)] = true
	self:Refresh()
	self.Changed:Fire("permission", tostring(name), true)
	return self
end

function Access:RemovePermission(name)
	self.Permissions[tostring(name)] = nil
	self:Refresh()
	self.Changed:Fire("permission", tostring(name), false)
	return self
end

function Access:HasPermission(name)
	return self.Permissions[tostring(name)] == true
end

function Access:GetPermissions()
	local out = {}
	for name in pairs(self.Permissions) do table.insert(out, name) end
	table.sort(out)
	return out
end

-- A role is a permission that also reads nicely in the UI.
function Access:SetRole(role, permissions)
	self.Role = role and tostring(role) or nil
	self.Permissions = {}
	if self.Role then self.Permissions[self.Role] = true end
	for _, name in ipairs(nameList(permissions)) do self.Permissions[name] = true end
	self:Refresh()
	self.Changed:Fire("role", self.Role, true)
	return self
end

function Access:GetRole() return self.Role end

function Access:RegisterFeature(id, info)
	id = tostring(id)
	info = typeof(info) == "table" and info or {}
	self.Features[id] = {
		Id = id,
		Name = tostring(info.Name or id),
		Description = info.Description,
		Unlocked = info.Unlocked == true or info.Default == true,
		RequiresKey = info.RequiresKey,
		RequiresPermission = info.RequiresPermission,
	}
	self:Refresh()
	return self.Features[id]
end

function Access:IsFeatureUnlocked(id)
	local feature = self.Features[tostring(id)]
	if not feature then return false end
	if feature.Unlocked then return true end
	if feature.RequiresKey and self:HasKey(feature.RequiresKey) then return true end
	if feature.RequiresPermission and self:HasPermission(feature.RequiresPermission) then return true end
	return false
end

function Access:UnlockFeature(id, silent)
	id = tostring(id)
	if not self.Features[id] then self:RegisterFeature(id, {}) end
	self.Features[id].Unlocked = true
	self:Refresh()
	self.Changed:Fire("feature", id, true)
	NexoUI.FireHook("FeatureUnlocked", id)
	if not silent then
		local window = NexoUI.Windows[#NexoUI.Windows]
		if window then
			window:Notify({
				Title = "Feature unlocked",
				Content = self.Features[id].Name,
				Type = "Success",
				Duration = 4,
			})
		end
	end
	return self
end

function Access:LockFeature(id)
	local feature = self.Features[tostring(id)]
	if feature then feature.Unlocked = false end
	self:Refresh()
	self.Changed:Fire("feature", tostring(id), false)
	return self
end

function Access:ListFeatures()
	local out = {}
	for id, feature in pairs(self.Features) do
		table.insert(out, {
			Id = id,
			Name = feature.Name,
			Description = feature.Description,
			Unlocked = self:IsFeatureUnlocked(id),
		})
	end
	table.sort(out, function(a, b) return a.Name < b.Name end)
	return out
end

-- Returns allowed, reason
function Access:Evaluate(spec)
	if typeof(spec) ~= "table" then return true end
	if spec.Locked == true then return false, tostring(spec.LockedReason or "Locked") end
	for _, key in ipairs(nameList(spec.RequireKey or spec.RequiresKey)) do
		if not self:HasKey(key) then
			return false, "Requires key: " .. key
		end
	end
	local permissions = nameList(spec.Permission or spec.Permissions or spec.RequirePermission)
	if #permissions > 0 then
		local ok = false
		for _, name in ipairs(permissions) do
			if self:HasPermission(name) then ok = true break end
		end
		if not ok then
			return false, "Requires role: " .. table.concat(permissions, " or ")
		end
	end
	for _, id in ipairs(nameList(spec.Feature or spec.RequireFeature)) do
		if not self:IsFeatureUnlocked(id) then
			local feature = self.Features[id]
			return false, "Locked feature: " .. ((feature and feature.Name) or id)
		end
	end
	return true
end

local function buildLockOverlay(target, reason, spec, object)
	local theme = NexoUI.Theme
	local base = (target.ZIndex or 1) + 40
	local overlay = Util.new("TextButton", {
		Name = "NexoLock",
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = theme.Background,
		BackgroundTransparency = 0.45,
		ZIndex = base,
		Parent = target,
	}, { Util.corner(12) })
	local badge = Util.new("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(58, 22),
		BackgroundColor3 = theme.Error,
		BackgroundTransparency = 0.15,
		ZIndex = base + 1,
		Parent = overlay,
	}, { Util.corner(999) })
	Util.label({
		Size = UDim2.fromScale(1, 1),
		Text = "LOCKED",
		Font = FONT.Black,
		TextSize = 10,
		TextColor3 = Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = base + 2,
		Parent = badge,
	})
	overlay.Activated:Connect(function()
		local window = (object and object.Window) or NexoUI.Windows[#NexoUI.Windows]
		if window then
			window:Notify({
				Title = spec.LockedTitle or "Locked",
				Content = reason,
				Type = "Warning",
				Duration = 4,
			})
		end
		Util.safe(spec.OnLockedClick, reason, object)
	end)
	return overlay
end

-- Registers an object (component, section or tab) as gated content.
function Access:Attach(object, spec, targetFrame)
	if typeof(spec) ~= "table" then return object end
	local gated = spec.RequireKey or spec.RequiresKey or spec.Permission or spec.Permissions
		or spec.RequirePermission or spec.Feature or spec.RequireFeature or spec.Locked
	if not gated then return object end
	local target = targetFrame or object.Frame or object.Button
	if not target then return object end
	local gate = { Object = object, Spec = spec, Target = target, Overlay = nil }
	table.insert(self.Gates, gate)
	object.Gate = gate
	self:_apply(gate)
	return object
end

function Access:_apply(gate)
	local target = gate.Target
	if not target or not target.Parent then return end
	local allowed, reason = self:Evaluate(gate.Spec)
	if allowed then
		if gate.Overlay then
			pcall(function() gate.Overlay:Destroy() end)
			gate.Overlay = nil
		end
		if gate.Spec.HideWhenLocked and gate.Object.UserVisible ~= false then
			target.Visible = true
		end
		gate.Locked = false
	else
		gate.Locked = true
		gate.Reason = reason
		if gate.Spec.HideWhenLocked then
			target.Visible = false
		else
			target.Visible = gate.Object.UserVisible ~= false
			if not gate.Overlay then
				gate.Overlay = buildLockOverlay(target, reason, gate.Spec, gate.Object)
			end
		end
	end
end

function Access:Refresh()
	for index = #self.Gates, 1, -1 do
		local gate = self.Gates[index]
		if not gate.Target or not gate.Target.Parent then
			table.remove(self.Gates, index)
		else
			self:_apply(gate)
		end
	end
	return self
end

function Access:IsLocked(object)
	return object and object.Gate and object.Gate.Locked == true
end

-- Public shortcuts
function NexoUI:UnlockKey(name, silent) return Access:UnlockKey(name, silent) end
function NexoUI:LockKey(name) return Access:LockKey(name) end
function NexoUI:HasKey(name) return Access:HasKey(name) end
function NexoUI:SetPermissions(list) return Access:SetPermissions(list) end
function NexoUI:AddPermission(name) return Access:AddPermission(name) end
function NexoUI:RemovePermission(name) return Access:RemovePermission(name) end
function NexoUI:HasPermission(name) return Access:HasPermission(name) end

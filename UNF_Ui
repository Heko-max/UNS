-- Re-flows a column row between side-by-side and stacked layouts.
function NexoUI.LayoutColumns(row, narrow)
	if not row or not row.Parent then return end
	local count = row:GetAttribute("Columns") or 2
	local gap = row:GetAttribute("Gap") or 14
	local list = row:FindFirstChildOfClass("UIListLayout")
	if not list then return end
	list.FillDirection = narrow and Enum.FillDirection.Vertical or Enum.FillDirection.Horizontal
	for _, child in ipairs(row:GetChildren()) do
		if child:IsA("Frame") and child.Name:match("^Column") then
			if narrow then
				child.Size = UDim2.new(1, 0, 0, 0)
			else
				child.Size = UDim2.new(1 / count, -(gap * (count - 1) / count), 0, 0)
			end
		end
	end
end

-- Tab:CreateColumns(2) -> { column1, column2 }  (each is a full container)
function ContainerMethods:CreateColumns(config)
	local count, gap = 2, 14
	if typeof(config) == "number" then
		count = config
	elseif typeof(config) == "table" then
		count = tonumber(config.Count) or tonumber(config[1]) or 2
		gap = tonumber(config.Gap) or 14
	end
	count = math.clamp(math.floor(count), 1, 4)

	local row = Util.new("Frame", {
		Name = "ColumnRow",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = #self.Children + 1,
		ZIndex = LAYER.Content + 3,
		Parent = self.Content,
	})
	row:SetAttribute("Columns", count)
	row:SetAttribute("Gap", gap)
	local list = Util.list(gap, Enum.FillDirection.Horizontal)
	list.Parent = row

	local columns = {}
	for i = 1, count do
		local frame = Util.new("Frame", {
			Name = "Column" .. i,
			Size = UDim2.new(1 / count, -(gap * (count - 1) / count), 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = i,
			ZIndex = LAYER.Content + 3,
			Parent = row,
		}, { Util.list(14) })
		local column = NexoUI.MakeContainer({ Name = "Column" .. i, Frame = frame, Tab = self.Tab }, self.Window, frame)
		function column:Destroy()
			self:Clear()
			pcall(function() frame:Destroy() end)
		end
		columns[i] = column
	end

	if self.Window then
		table.insert(self.Window.ColumnRows, row)
		NexoUI.LayoutColumns(row, self.Window.Narrow == true)
	end
	return columns, row
end

-- Tab:CreateSection{ Name = "Settings", Collapsible = true }
function ContainerMethods:CreateSection(config)
	if typeof(config) ~= "table" then config = { Name = tostring(config or "Section") } end
	local theme = NexoUI.Theme
	local section = {}
	section.Name = tostring(config.Name or "Section")
	section.Config = config
	section.Maid = Maid.new()
	section.UserVisible = true
	section.Collapsed = config.Collapsed == true
	section.Tab = self.Tab

	local frame = Util.new("Frame", {
		Name = "Section_" .. section.Name,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.Panel,
		LayoutOrder = tonumber(config.Order) or (#self.Children + 1),
		ZIndex = LAYER.Content + 3,
		Parent = self.Content,
	}, { Util.corner(11), Util.list(0) })
	local stroke = Util.stroke(theme.Border, 0.86, 1)
	stroke.Parent = frame
	local grad = Util.gradient(Util.cseq({ 0, theme.PanelAlt }, { 1, theme.Background }), 155)
	grad.Parent = frame

	-- header (also the collapse toggle when Collapsible is on)
	local header = Util.new(config.Collapsible and "TextButton" or "Frame", {
		Name = "Header",
		Text = config.Collapsible and "" or nil,
		AutoButtonColor = config.Collapsible and false or nil,
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		ZIndex = LAYER.Content + 4,
		Parent = frame,
	}, { Util.pad(0, 11, 0, 11) })

	local headerRow = Util.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = LAYER.Content + 4,
		Parent = header,
	})
	local hList = Util.list(9, Enum.FillDirection.Horizontal)
	hList.VerticalAlignment = Enum.VerticalAlignment.Center
	hList.Parent = headerRow

	local sIcon = Util.image(config.Icon or config.Image)
	if sIcon ~= "" then
		local img = Util.imageObject({
			Image = sIcon,
			Size = config.IconSize or 18,
			Color = config.IconColor or theme.Accent,
			LayoutOrder = 1,
		}, 18)
		img.ZIndex = LAYER.Content + 5
		img.Parent = headerRow
		section.IconImage = img
	end
	local title = Util.label({
		Name = "Title",
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = section.Name,
		Font = FONT.Bold,
		TextSize = 12.5,
		TextColor3 = theme.Text,
		LayoutOrder = 2,
		ZIndex = LAYER.Content + 5,
		Parent = headerRow,
	})

	local chevron
	if config.Collapsible then
		chevron = Util.new("Frame", {
			Name = "Chevron",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1,
			Rotation = section.Collapsed and -90 or 0,
			ZIndex = LAYER.Content + 5,
			Parent = header,
		})
		for i = 1, 2 do
			Util.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(i == 1 and 0.28 or 0.72, 0.5),
				Size = UDim2.fromOffset(9, 1.8),
				Rotation = i == 1 and 45 or -45,
				BackgroundColor3 = theme.SubText,
				ZIndex = LAYER.Content + 5,
				Parent = chevron,
			}, { Util.corner(1) })
		end
	end

	local divider = Util.new("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, -32, 0, 1),
		Position = UDim2.fromOffset(16, 0),
		BackgroundColor3 = theme.Border,
		BackgroundTransparency = 0.9,
		LayoutOrder = 2,
		ZIndex = LAYER.Content + 4,
		Parent = frame,
	})

	local body = Util.new("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = not section.Collapsed,
		LayoutOrder = 3,
		ZIndex = LAYER.Content + 4,
		Parent = frame,
	}, {
		Util.list(tonumber(config.Spacing) or 10),
		Util.pad(14, tonumber(config.Padding) or 14, 16, tonumber(config.Padding) or 14),
	})

	section.Frame = frame
	section.Header = header
	section.Title = title
	section.Body = body
	NexoUI.MakeContainer(section, self.Window, body)

	function section:SetCollapsed(state)
		if state == nil then state = not self.Collapsed end
		self.Collapsed = state and true or false
		body.Visible = not self.Collapsed
		divider.Visible = not self.Collapsed
		if chevron then Util.tween(chevron, 0.18, { Rotation = self.Collapsed and -90 or 0 }) end
		return self
	end
	function section:SetName(name)
		self.Name = tostring(name)
		title.Text = self.Name
		return self
	end
	function section:SetIcon(image)
		if self.IconImage then
			self.IconImage.Image = Util.image(image)
			self.IconImage.Visible = self.IconImage.Image ~= ""
		end
		return self
	end
	function section:SetVisible(visible)
		self.UserVisible = visible ~= false
		frame.Visible = self.UserVisible
		return self
	end
	function section:Destroy()
		self:Clear()
		self.Maid:Clean()
		pcall(function() frame:Destroy() end)
		if self.Tab and self.Tab.Sections then
			for i, s in ipairs(self.Tab.Sections) do
				if s == self then table.remove(self.Tab.Sections, i) break end
			end
		end
	end

	if config.Collapsible then
		section.Maid:Give(header.Activated:Connect(function() section:SetCollapsed() end))
	end
	section.Maid:Give(Util.onTheme(function(t)
		if not frame.Parent then return end
		frame.BackgroundColor3 = t.Panel
		stroke.Color = t.Border
		grad.Color = Util.cseq({ 0, t.PanelAlt }, { 1, t.Background })
		title.TextColor3 = t.Text
		divider.BackgroundColor3 = t.Border
	end))

	table.insert(self.Children, section)
	if section.Tab and section.Tab.Sections then table.insert(section.Tab.Sections, section) end
	return section
end


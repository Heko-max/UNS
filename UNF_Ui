local Component = {}
Component.__index = Component
NexoUI.ComponentClass = Component

function Component:SetVisible(visible)
	self.UserVisible = visible ~= false
	if self.Frame then self.Frame.Visible = self.UserVisible end
	return self
end

function Component:SetName(text)
	self.Name = tostring(text or "")
	if self.Title then self.Title.Text = self.Name end
	return self
end
Component.SetText = Component.SetName

function Component:SetDescription(text)
	self.Description = text and tostring(text) or nil
	if self.Desc then
		self.Desc.Text = self.Description or ""
		self.Desc.Visible = self.Description ~= nil and self.Description ~= ""
	end
	return self
end

function Component:SetEnabled(state)
	self.Enabled = state ~= false
	local fade = self.Enabled and 0 or 0.55
	if self.Title then Util.tween(self.Title, 0.15, { TextTransparency = fade }) end
	if self.Desc then Util.tween(self.Desc, 0.15, { TextTransparency = fade == 0 and 0 or 0.7 }) end
	if self.Control then Util.tween(self.Control, 0.15, { BackgroundTransparency = self.Enabled and 0 or 0.6 }) end
	return self
end
function Component:Enable() return self:SetEnabled(true) end
function Component:Disable() return self:SetEnabled(false) end

function Component:SetImage(image)
	if self.ImageObject then
		self.ImageObject.Image = Util.image(image)
		self.ImageObject.Visible = self.ImageObject.Image ~= ""
	end
	return self
end
Component.SetIcon = Component.SetImage

function Component:SetTooltip(text)
	self.Tooltip = text and tostring(text) or nil
	return self
end

function Component:Get() return self.Value end
Component.GetValue = Component.Get

function Component:Set(value, silent)
	if self._set then self._set(value, silent) end
	return self
end
Component.SetValue = Component.Set

function Component:OnChanged(fn)
	if not self.Changed then self.Changed = Signal.new() end
	return self.Changed:Connect(fn)
end

function Component:GetInstance() return self.Frame end

function Component:Destroy()
	if self.Changed then self.Changed:Destroy() end
	if self.Maid then self.Maid:Clean() end
	if self.Frame then pcall(function() self.Frame:Destroy() end) end
	if self.Flag then NexoUI.Flags[self.Flag] = nil end
	local parent = self.Container
	if parent and parent.Children then
		for i, c in ipairs(parent.Children) do
			if c == self then table.remove(parent.Children, i) break end
		end
	end
	local window = self.Window
	if window and window.Searchable then
		for i, c in ipairs(window.Searchable) do
			if c == self then table.remove(window.Searchable, i) break end
		end
	end
	self.Destroyed = true
end

-- Builds the standard row used by nearly every component. The row can never
-- overlap: the text body is sized around the reserved control width, and the
-- row grows automatically with its content.
-- opts = { Class = "Frame"|"TextButton", Reserve = <px>, Interactive = bool }
function NexoUI.NewComponent(container, config, opts)
	opts = opts or {}
	local theme = NexoUI.Theme
	local self = setmetatable({}, Component)
	self.Container = container
	self.Window = container.Window
	self.Config = config
	self.Name = config.Name and tostring(config.Name) or nil
	self.Description = config.Description and tostring(config.Description) or nil
	self.Tooltip = config.Tooltip and tostring(config.Tooltip) or nil
	self.Enabled = config.Enabled ~= false
	self.UserVisible = config.Visible ~= false
	self.Maid = Maid.new()
	self.Changed = Signal.new()

	local imageId = Util.image(config.Image or config.Icon)
	local imagePos = tostring(config.ImagePosition or config.IconPosition or "Left"):lower()
	local imageSize = config.ImageSize or config.IconSize or 22
	local imageW = typeof(imageSize) == "number" and imageSize or 22

	local reserve = tonumber(opts.Reserve) or 0
	local leftInset = 0
	if imageId ~= "" and imagePos == "left" then leftInset = imageW + 12 end
	if imageId ~= "" and imagePos == "right" then reserve = reserve + imageW + 10 end

	local frame = Util.new(opts.Class or "Frame", {
		Name = (self.Name or "Item"):gsub("%s", ""),
		Text = opts.Class == "TextButton" and "" or nil,
		AutoButtonColor = opts.Class == "TextButton" and false or nil,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.Field,
		BackgroundTransparency = opts.Flat and 1 or 0.25,
		Visible = self.UserVisible,
		LayoutOrder = tonumber(config.Order) or (#container.Children + 1),
		ZIndex = LAYER.Content + 5,
		Parent = container.Content,
	}, { Util.corner(10), Util.pad(7, 10, 7, 10), Util.minSize(0, 32) })
	local stroke = Util.stroke(theme.Border, 0.92, 1)
	stroke.Parent = frame

	if imageId ~= "" and (imagePos == "left" or imagePos == "right") then
		local img = Util.imageObject({
			Image = imageId, Size = imageSize, Transparency = config.ImageTransparency,
			Color = config.ImageColor, ScaleType = config.ImageScaleType,
			Corner = config.ImageCorner,
		}, 22)
		img.AnchorPoint = Vector2.new(imagePos == "left" and 0 or 1, 0.5)
		img.Position = UDim2.new(imagePos == "left" and 0 or 1, 0, 0.5, 0)
		img.ZIndex = LAYER.Content + 6
		img.Parent = frame
		self.ImageObject = img
	end

	local body = Util.new("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(leftInset, 0),
		Size = UDim2.new(1, -(leftInset + (reserve > 0 and reserve + 12 or 0)), 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = LAYER.Content + 6,
		Parent = frame,
	}, { Util.list(4) })

	if imageId ~= "" and (imagePos == "top" or imagePos == "above" or imagePos == "bottom" or imagePos == "below") then
		local img = Util.imageObject({
			Image = imageId, Size = imageSize, Transparency = config.ImageTransparency,
			Color = config.ImageColor, ScaleType = config.ImageScaleType,
			Corner = config.ImageCorner,
			LayoutOrder = (imagePos == "top" or imagePos == "above") and 0 or 9,
		}, 22)
		img.ZIndex = LAYER.Content + 6
		img.Parent = body
		self.ImageObject = img
	end

	if self.Name then
		self.Title = Util.label({
			Name = "Title",
			Size = UDim2.new(1, 0, 0, 17),
			Text = self.Name,
			Font = FONT.Bold,
			TextSize = 13.5,
			TextColor3 = theme.Text,
			TextTruncate = Enum.TextTruncate.AtEnd,
			LayoutOrder = 1,
			ZIndex = LAYER.Content + 7,
			Parent = body,
		})
	end
	if self.Description then
		self.Desc = Util.label({
			Name = "Description",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = self.Description,
			Font = FONT.Regular,
			TextSize = 12,
			TextColor3 = theme.MutedText,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			LineHeight = 1.25,
			LayoutOrder = 2,
			ZIndex = LAYER.Content + 7,
			Parent = body,
		})
	end

	local right
	if (tonumber(opts.Reserve) or 0) > 0 then
		right = Util.new("Frame", {
			Name = "Control",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, self.ImageObject and imagePos == "right" and -(imageW + 10) or 0, 0.5, 0),
			Size = UDim2.fromOffset(opts.Reserve, opts.ControlHeight or 28),
			BackgroundTransparency = 1,
			ZIndex = LAYER.Content + 7,
			Parent = frame,
		})
	end

	self.Frame = frame
	self.Body = body
	self.Right = right
	self.Stroke = stroke

	self.Maid:Give(Util.onTheme(function(t)
		if not frame.Parent then return end
		frame.BackgroundColor3 = t.Field
		stroke.Color = t.Border
		if self.Title then self.Title.TextColor3 = t.Text end
		if self.Desc then self.Desc.TextColor3 = t.MutedText end
	end))

	-- tooltip + hover feedback
	if frame:IsA("GuiButton") or self.Tooltip then
		self.Maid:Give(frame.MouseEnter:Connect(function()
			if self.Tooltip and NexoUI.ShowTooltip then
				NexoUI.ShowTooltip(self.Window, frame, self.Tooltip)
			end
			if opts.Interactive and self.Enabled then
				Util.tween(frame, 0.14, { BackgroundTransparency = 0.02 })
				Util.tween(stroke, 0.14, { Transparency = 0.6 })
			end
		end))
		self.Maid:Give(frame.MouseLeave:Connect(function()
			if NexoUI.HideTooltip then NexoUI.HideTooltip(self.Window) end
			if opts.Interactive then
				Util.tween(frame, 0.16, { BackgroundTransparency = opts.Flat and 1 or 0.25 })
				Util.tween(stroke, 0.16, { Transparency = 0.92 })
			end
		end))
	end

	if config.Enabled == false then self:SetEnabled(false) end
	return self
end


-- Theme hooks: each widget registers a repaint closure instead of hard coding
-- colours, which also covers gradients and strokes.
local themeHooks = {}
local hookCounter = 0

function Util.onTheme(fn)
	if typeof(fn) ~= "function" then return function() end end
	hookCounter = hookCounter + 1
	local id = hookCounter
	themeHooks[id] = fn
	Util.safe(fn, NexoUI.Theme)
	return function() themeHooks[id] = nil end
end

function NexoUI.ApplyTheme()
	for id, fn in pairs(themeHooks) do
		local ok = Util.safe(fn, NexoUI.Theme)
		if not ok then themeHooks[id] = nil end
	end
end

-- Library:SetTheme("Midnight") or Library:SetTheme({ Accent = Color3.new(...) })
function NexoUI:SetTheme(theme)
	local base
	if typeof(theme) == "string" then
		local preset = THEMES[theme]
		if not preset then
			Util.warn("unknown theme '" .. theme .. "'")
			return NexoUI.Theme
		end
		base = Util.copy(preset)
	elseif typeof(theme) == "table" then
		base = Util.copy(NexoUI.Theme)
		for k, v in pairs(theme) do
			if k == "Name" then
				base.Name = tostring(v)
			else
				base[k] = Util.color(v, base[k])
			end
		end
	else
		Util.warn("SetTheme expects a theme name or a table")
		return NexoUI.Theme
	end
	NexoUI.Theme = base
	NexoUI.ApplyTheme()
	return base
end

-- Registers a brand new named theme that SetTheme can use later.
function NexoUI:AddTheme(name, palette)
	if typeof(name) ~= "string" or typeof(palette) ~= "table" then
		Util.warn("AddTheme(name, palette) expects a string and a table")
		return
	end
	local merged = Util.copy(THEMES.NEXO)
	for k, v in pairs(palette) do
		if k == "Name" then merged.Name = tostring(v) else merged[k] = Util.color(v, merged[k]) end
	end
	merged.Name = merged.Name or name
	THEMES[name] = merged
	return merged
end

-- ---------------------------------------------------------------- 6. registry
-- Components register themselves into NexoUI.Components. Any container
-- (Tab, Section, Column) then exposes them automatically as :CreateX(config),
-- so new components can be added later without touching the containers.
local ContainerMethods = {}
local Container = {}
Container.__index = function(self, key)
	local method = ContainerMethods[key]
	if method then return method end
	local name = typeof(key) == "string" and key:match("^Create(%a[%w_]*)$") or nil
	if name and NexoUI.Components[name] then
		return function(container, config)
			return NexoUI.Build(container, name, config)
		end
	end
	return nil
end
NexoUI.Container = Container
NexoUI.ContainerMethods = ContainerMethods

-- Turns any table into a container that can spawn components.
function NexoUI.MakeContainer(object, window, contentFrame)
	object.Window = window
	object.Content = contentFrame
	object.Children = {}
	object.IsContainer = true
	-- Keep a more specific metatable (for example Tab) when one already exists;
	-- those metatables chain into Container.__index themselves.
	if getmetatable(object) == nil then setmetatable(object, Container) end
	return object
end

function NexoUI:RegisterComponent(name, builder)
	if typeof(name) ~= "string" or typeof(builder) ~= "function" then
		Util.warn("RegisterComponent(name, builder) expects a string and a function")
		return
	end
	NexoUI.Components[name] = builder
	return builder
end

-- Central component factory: validates, builds, indexes for search, and never
-- lets one broken component take down the whole interface.
function NexoUI.Build(container, name, config)
	local builder = NexoUI.Components[name]
	if not builder then
		Util.warn("unknown component '" .. tostring(name) .. "'")
		return nil
	end
	if typeof(config) ~= "table" then config = {} end
	local ok, component = pcall(builder, container, config)
	if not ok then
		Util.warn(("failed to create %s: %s"):format(name, tostring(component)))
		return nil
	end
	if component then
		component.Type = name
		table.insert(container.Children, component)
		if container.Window then container.Window:_Index(component) end
		if config.Flag and component.Get then
			component.Flag = tostring(config.Flag)
			NexoUI.Flags[component.Flag] = component
		end
	end
	return component
end

-- Removes every child component of a container (used by Clear / Destroy).
function ContainerMethods:Clear()
	for _, child in ipairs(table.clone(self.Children)) do
		if child.Destroy then pcall(function() child:Destroy() end) end
	end
	table.clear(self.Children)
	return self
end

function ContainerMethods:GetChildren()
	return table.clone(self.Children)
end

-- ---------------------------------------------------------------- 7. window
local Window = {}
Window.__index = Window
NexoUI.WindowClass = Window

-- Picks the safest place to parent the ScreenGui: executor hidden ui, then
-- PlayerGui, then CoreGui. Works in exploits and in normal LocalScripts.
local function guiParent()
	local hidden = rawget(getfenv(0), "gethui")
	if typeof(hidden) == "function" then
		local ok, holder = pcall(hidden)
		if ok and holder then return holder end
	end
	if LocalPlayer then
		local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if pg then return pg end
	end
	local ok, core = pcall(function() return game:GetService("CoreGui") end)
	if ok and core then return core end
	return nil
end

-- Clears a previous build of the same window name (re-running a script).
local function purgeExisting(name)
	local holders = {}
	local hidden = rawget(getfenv(0), "gethui")
	if typeof(hidden) == "function" then
		local ok, holder = pcall(hidden)
		if ok and holder then table.insert(holders, holder) end
	end
	if LocalPlayer then
		local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
		if pg then table.insert(holders, pg) end
	end
	local ok, core = pcall(function() return game:GetService("CoreGui") end)
	if ok and core then table.insert(holders, core) end
	for _, holder in ipairs(holders) do
		for _, child in ipairs(holder:GetChildren()) do
			if child:IsA("ScreenGui") and child.Name == name then
				pcall(function() child:Destroy() end)
			end
		end
	end
end

-- Keeps a frame fully inside the viewport.
local function clampToScreen(frame, scale)
	if not frame or not frame.Parent then return end
	local vp = Camera.ViewportSize
	local size = frame.AbsoluteSize
	local halfX, halfY = size.X * 0.5, size.Y * 0.5
	local minX = math.min(halfX, vp.X * 0.5)
	local minY = math.min(halfY, vp.Y * 0.5)
	local pos = frame.Position
	frame.Position = UDim2.new(
		0, math.clamp(pos.X.Scale * vp.X + pos.X.Offset, minX, math.max(minX, vp.X - halfX)),
		0, math.clamp(pos.Y.Scale * vp.Y + pos.Y.Offset, minY, math.max(minY, vp.Y - halfY))
	)
end

-- Mouse + touch dragging that never swallows clicks meant for controls.
function Window:_BindDrag(handle)
	if not handle then return end
	local dragging, startPos, startInput = false, nil, nil
	self.Maid:Give(handle.InputBegan:Connect(function(input)
		if not self.Config.Draggable then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			startInput = input.Position
			startPos = self.Root.Position
		end
	end))
	self.Maid:Give(UserInputService.InputChanged:Connect(function(input)
		if not dragging or not self.Gui.Parent then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - startInput
			local vp = Camera.ViewportSize
			local half = self.Root.AbsoluteSize * 0.5
			local hx = math.min(half.X, vp.X * 0.5)
			local hy = math.min(half.Y, vp.Y * 0.5)
			self.Root.Position = UDim2.new(
				0, math.clamp(startPos.X.Scale * vp.X + startPos.X.Offset + delta.X, hx, math.max(hx, vp.X - hx)),
				0, math.clamp(startPos.Y.Scale * vp.Y + startPos.Y.Offset + delta.Y, hy, math.max(hy, vp.Y - hy))
			)
		end
	end))
	self.Maid:Give(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
end

-- Responsive pass: chooses narrow/wide layout then fits the window on screen.
function Window:_Refresh()
	if not self.Gui or not self.Gui.Parent then return end
	local vp = Camera.ViewportSize
	local narrow = vp.X < 760 or (vp.X / math.max(vp.Y, 1)) < 1.15
	if narrow ~= self.Narrow then
		self.Narrow = narrow
		self:_ApplyLayoutMode()
	end
	local base = self.BaseSize
	local scale = math.clamp(
		math.min(vp.X * 0.94 / base.X, vp.Y * 0.94 / base.Y),
		0.4, 1.2
	)
	self.Scale.Scale = scale
	local height = math.min(base.Y, (vp.Y * 0.96) / scale)
	self.Root.Size = UDim2.fromOffset(base.X, self.Minimized and self.HeaderHeight or height)
	clampToScreen(self.Root, scale)
	self.OnResize:Fire(vp, scale, narrow)
end

-- Switches between the full sidebar and the compact icon rail.
function Window:_ApplyLayoutMode()
	local narrow = self.Narrow
	local width = narrow and 62 or self.SidebarWidth
	Util.tween(self.Sidebar, 0.22, { Size = UDim2.new(0, width, 1, 0) })
	Util.tween(self.Body, 0.22, { Position = UDim2.fromOffset(width, 0), Size = UDim2.new(1, -width, 1, 0) })
	if self.BrandText then self.BrandText.Visible = not narrow end
	if self.BrandSub then self.BrandSub.Visible = not narrow end
	for _, tab in ipairs(self.Tabs) do
		tab:_SetCompact(narrow)
	end
	for _, row in ipairs(self.ColumnRows) do
		if row and row.Parent then
			NexoUI.LayoutColumns(row, narrow)
		end
	end
end

-- Search index: every component registers its searchable text here.
function Window:_Index(component)
	if not component or not component.Frame then return end
	table.insert(self.Searchable, component)
end

function Window:Search(query)
	query = tostring(query or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
	self.SearchQuery = query
	for _, component in ipairs(self.Searchable) do
		if component.Frame and component.Frame.Parent then
			if query == "" then
				component.Frame.Visible = component.UserVisible ~= false
			else
				local haystack = (tostring(component.Name or "") .. " " .. tostring(component.Description or "")):lower()
				component.Frame.Visible = haystack:find(query, 1, true) ~= nil
			end
		end
	end
	-- Hide sections that ended up with no visible children.
	for _, tab in ipairs(self.Tabs) do
		for _, section in ipairs(tab.Sections) do
			if section.Frame and section.Frame.Parent then
				if query == "" then
					section.Frame.Visible = section.UserVisible ~= false
				else
					local any = false
					for _, child in ipairs(section.Children) do
						if child.Frame and child.Frame.Visible then any = true break end
					end
					section.Frame.Visible = any
				end
			end
		end
	end
	return self
end

function Window:SelectTab(target)
	local tab = target
	if typeof(target) == "string" then
		for _, t in ipairs(self.Tabs) do
			if t.Name == target then tab = t break end
		end
	elseif typeof(target) == "number" then
		tab = self.Tabs[target]
	end
	if typeof(tab) ~= "table" or not tab.Page then return self end
	for _, other in ipairs(self.Tabs) do
		local active = other == tab
		other.Page.Visible = active
		if other.SubBar then other.SubBar.Visible = active and #other.SubTabs > 0 end
		other:_Paint(active)
	end
	self.ActiveTab = tab
	Util.safe(tab.Config.Callback, tab)
	self.OnTabChanged:Fire(tab)
	return self
end

function Window:Show()
	self.Visible = true
	self.Root.Visible = true
	self:_Refresh()
	local target = self.Scale.Scale
	self.Scale.Scale = target * 0.94
	Util.tween(self.Main, 0.2, { BackgroundTransparency = 0 })
	Util.tween(self.Scale, 0.32, { Scale = target }, Enum.EasingStyle.Back)
	task.delay(0.36, function()
		if self.Visible then self:_Refresh() end
	end)
	self.OnToggle:Fire(true)
	return self
end

function Window:Hide()
	self.Visible = false
	local target = self.Scale.Scale
	Util.tween(self.Main, 0.16, { BackgroundTransparency = 1 })
	Util.tween(self.Scale, 0.18, { Scale = target * 0.92 })
	task.delay(0.2, function()
		if not self.Visible and self.Root then
			self.Root.Visible = false
			self.Scale.Scale = target
		end
	end)
	self.OnToggle:Fire(false)
	return self
end

function Window:Toggle()
	if self.Visible then self:Hide() else self:Show() end
	return self
end

-- Collapses to the title bar, keeping every control alive underneath.
function Window:Minimize(state)
	if state == nil then state = not self.Minimized end
	self.Minimized = state and true or false
	self.Body.Visible = not self.Minimized
	self.Sidebar.Visible = not self.Minimized
	self:_Refresh()
	if self.MinimizeIcon then
		Util.tween(self.MinimizeIcon, 0.18, { Rotation = self.Minimized and 180 or 0 })
	end
	return self
end

function Window:SetTitle(text)
	self.Name = tostring(text or self.Name)
	if self.BrandText then self.BrandText.Text = self.Name end
	return self
end

function Window:SetSubtitle(text)
	if self.BrandSub then
		self.BrandSub.Text = tostring(text or "")
		self.BrandSub.Visible = self.BrandSub.Text ~= "" and not self.Narrow
	end
	return self
end

function Window:Destroy()
	for _, tab in ipairs(table.clone(self.Tabs)) do
		pcall(function() tab:Destroy() end)
	end
	self.OnToggle:Destroy()
	self.OnResize:Destroy()
	self.OnTabChanged:Destroy()
	self.Maid:Clean()
	if self.Gui then pcall(function() self.Gui:Destroy() end) end
	for i, w in ipairs(NexoUI.Windows) do
		if w == self then table.remove(NexoUI.Windows, i) break end
	end
	self.Destroyed = true
end

-- ------- flexible image factory (used by logos, icons and Image elements) ---
-- Accepts: Image/Icon id, Size (number|UDim2|Vector2), Transparency, Color,
-- ScaleType ("Fit"/"Stretch"/"Crop"/"Slice"), Corner, Rounded, Visible.
function Util.imageObject(cfg, fallbackSize)
	cfg = cfg or {}
	local id = Util.image(cfg.Image or cfg.Icon or cfg.Id)
	local size = cfg.Size or fallbackSize or 20
	local udim
	if typeof(size) == "UDim2" then udim = size
	elseif typeof(size) == "Vector2" then udim = UDim2.fromOffset(size.X, size.Y)
	elseif typeof(size) == "number" then udim = UDim2.fromOffset(size, size)
	else udim = UDim2.fromOffset(20, 20) end

	local scaleType = Enum.ScaleType.Fit
	local st = tostring(cfg.ScaleType or "Fit"):lower()
	if st == "stretch" then scaleType = Enum.ScaleType.Stretch
	elseif st == "crop" then scaleType = Enum.ScaleType.Crop
	elseif st == "slice" then scaleType = Enum.ScaleType.Slice end

	local image = Util.new("ImageLabel", {
		Name = "Image",
		BackgroundTransparency = 1,
		Size = udim,
		Image = id,
		ImageTransparency = tonumber(cfg.Transparency) or 0,
		ScaleType = scaleType,
		Visible = cfg.Visible ~= false and id ~= "",
		LayoutOrder = cfg.LayoutOrder or 0,
	})
	if cfg.Color then image.ImageColor3 = Util.color(cfg.Color, Color3.new(1, 1, 1)) end
	local radius = cfg.Corner or cfg.CornerRadius or cfg.Rounded
	if radius then
		Util.corner(radius == true and 8 or radius).Parent = image
	end
	if cfg.Padding then Util.pad(cfg.Padding).Parent = image end
	return image
end

-- Direction + alignment for a text/image pair. "Left" means image before text.
local function resolvePlacement(position)
	local p = tostring(position or "Left"):lower()
	if p == "right" or p == "after" then
		return Enum.FillDirection.Horizontal, 2, Enum.HorizontalAlignment.Left
	elseif p == "top" or p == "above" then
		return Enum.FillDirection.Vertical, 0, Enum.HorizontalAlignment.Left
	elseif p == "bottom" or p == "below" then
		return Enum.FillDirection.Vertical, 2, Enum.HorizontalAlignment.Left
	elseif p == "center" or p == "centre" then
		return Enum.FillDirection.Horizontal, 0, Enum.HorizontalAlignment.Center
	end
	return Enum.FillDirection.Horizontal, 0, Enum.HorizontalAlignment.Left
end
NexoUI.ResolvePlacement = resolvePlacement

-- Small square icon button drawn from frames (no external assets required).
local function glyphButton(parent, kind, order)
	local theme = NexoUI.Theme
	local btn = Util.new("TextButton", {
		Name = kind,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = theme.Button,
		BackgroundTransparency = 0.25,
		Size = UDim2.fromOffset(32, 32),
		LayoutOrder = order or 0,
		Parent = parent,
	}, { Util.corner(10) })
	local stroke = Util.stroke(theme.Border, 0.78, 1)
	stroke.Parent = btn
	local marks = {}
	if kind == "Close" then
		for i = 1, 2 do
			marks[i] = Util.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(13, 2),
				Rotation = i == 1 and 45 or -45,
				BackgroundColor3 = theme.Text,
				Parent = btn,
			}, { Util.corner(1) })
		end
	elseif kind == "Minimize" then
		marks[1] = Util.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(13, 2),
			BackgroundColor3 = theme.Text,
			Parent = btn,
		}, { Util.corner(1) })
	elseif kind == "Search" then
		marks[1] = Util.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.44, 0.44),
			Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1,
			Parent = btn,
		}, { Util.corner(999), Util.stroke(theme.Text, 0, 1.6) })
		marks[2] = Util.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.68, 0.7),
			Size = UDim2.fromOffset(6, 1.8),
			Rotation = 45,
			BackgroundColor3 = theme.Text,
			Parent = btn,
		}, { Util.corner(1) })
	end
	Util.onTheme(function(t)
		if not btn.Parent then return end
		btn.BackgroundColor3 = t.Button
		stroke.Color = t.Border
		for _, m in ipairs(marks) do
			if m.BackgroundTransparency < 1 then m.BackgroundColor3 = t.Text end
			local s = m:FindFirstChildOfClass("UIStroke")
			if s then s.Color = t.Text end
		end
	end)
	btn.MouseEnter:Connect(function()
		Util.tween(btn, 0.14, { BackgroundColor3 = NexoUI.Theme.ButtonHover, BackgroundTransparency = 0 })
	end)
	btn.MouseLeave:Connect(function()
		Util.tween(btn, 0.16, { BackgroundColor3 = NexoUI.Theme.Button, BackgroundTransparency = 0.25 })
	end)
	return btn, marks
end
NexoUI.GlyphButton = glyphButton

-- =====================================================================
--  Library:CreateWindow{...}
-- =====================================================================
function NexoUI:CreateWindow(config)
	if typeof(config) ~= "table" then config = {} end
	local theme = NexoUI.Theme
	if config.Theme then theme = NexoUI:SetTheme(config.Theme) end

	local self = setmetatable({}, Window)
	self.Config = config
	self.Name = tostring(config.Name or config.Title or "NEXO")
	self.Tabs = {}
	self.Sections = {}
	self.ColumnRows = {}
	self.Searchable = {}
	self.Notifications = {}
	self.Maid = Maid.new()
	self.Visible = true
	self.Minimized = false
	self.Narrow = nil
	self.HeaderHeight = 38
	self.BackgroundAlpha = math.clamp(tonumber(config.Transparency) or 0.22, 0, 0.92)
	self.SidebarWidth = math.clamp(tonumber(config.SidebarWidth) or 148, 104, 260)
	self.OnToggle = Signal.new()
	self.OnResize = Signal.new()
	self.OnTabChanged = Signal.new()
	config.Draggable = config.Draggable ~= false

	local size = config.Size
	local baseW, baseH = 580, 392
	if typeof(size) == "UDim2" then
		baseW, baseH = size.X.Offset, size.Y.Offset
	elseif typeof(size) == "Vector2" then
		baseW, baseH = size.X, size.Y
	end
	self.BaseSize = Vector2.new(math.max(baseW, 360), math.max(baseH, 240))

	local guiName = tostring(config.GuiName or "NexoUI")
	purgeExisting(guiName)
	local parent = guiParent()
	if not parent then
		Util.warn("no safe place to parent the interface")
		return nil
	end

	self.Gui = Util.new("ScreenGui", {
		Name = guiName,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = tonumber(config.DisplayOrder) or 9999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = parent,
	})
	self.Maid:Give(self.Gui)

	-- root: holds the scale + position of the whole window
	self.Root = Util.new("Frame", {
		Name = "Root",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = config.Position or UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(self.BaseSize.X, self.BaseSize.Y),
		BackgroundTransparency = 1,
		ZIndex = LAYER.Content,
		Parent = self.Gui,
	})
	self.Scale = Util.new("UIScale", { Scale = 1, Parent = self.Root })

	-- soft outer glow (purely decorative, two cheap rounded frames)
	for i, spec in ipairs({ { 10, 0.955 }, { 20, 0.982 } }) do
		Util.new("Frame", {
			Name = "Glow" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, spec[1] * 2, 1, spec[1] * 2),
			BackgroundColor3 = theme.Shadow,
			BackgroundTransparency = spec[2],
			ZIndex = LAYER.Content,
			Parent = self.Root,
		}, { Util.corner(16 + spec[1]) })
	end

	self.Main = Util.new("Frame", {
		Name = "Main",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = theme.Background,
		BackgroundTransparency = self.BackgroundAlpha,
		ClipsDescendants = true,
		Active = true,
		ZIndex = LAYER.Content + 1,
		Parent = self.Root,
	}, { Util.corner(13) })
	local mainStroke = Util.stroke(theme.Border, 0.64, 1.4)
	mainStroke.Parent = self.Main
	local mainGrad = Util.gradient(Util.cseq(
		{ 0, theme.BackgroundAlt }, { 0.5, theme.Background }, { 1, theme.BackgroundAlt }
	), 160)
	mainGrad.Parent = self.Main

	-- sidebar ------------------------------------------------------------
	self.Sidebar = Util.new("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, self.SidebarWidth, 1, 0),
		BackgroundColor3 = theme.Panel,
		BackgroundTransparency = 0.6,
		ZIndex = LAYER.Content + 2,
		Parent = self.Main,
	})
	Util.new("Frame", {
		Name = "Divider",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 1, 1, 0),
		BackgroundColor3 = theme.Border,
		BackgroundTransparency = 0.86,
		ZIndex = LAYER.Content + 3,
		Parent = self.Sidebar,
	})

	-- brand / logo block (fully configurable, also the drag handle)
	self.Brand = Util.new("Frame", {
		Name = "Brand",
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundTransparency = 1,
		Active = true,
		ZIndex = LAYER.Content + 3,
		Parent = self.Sidebar,
	}, { Util.pad(9, 10, 5, 10) })

	local logoCfg = config.Logo
	if typeof(logoCfg) ~= "table" then
		logoCfg = { Image = config.Logo or config.Icon, Position = config.LogoPosition, Size = config.LogoSize }
	end
	local dir, logoOrder, hAlign = resolvePlacement(logoCfg.Position or "Left")
	local brandList = Util.list(logoCfg.Spacing or 10, dir, hAlign)
	brandList.VerticalAlignment = Enum.VerticalAlignment.Center
	brandList.Parent = self.Brand

	local logoSize = logoCfg.Size or 26
	self.LogoEnabled = logoCfg.Enabled ~= false
	local logoId = Util.image(logoCfg.Image)
	if logoId ~= "" then
		self.Logo = Util.imageObject({
			Image = logoId,
			Size = logoSize,
			Transparency = logoCfg.Transparency,
			Color = logoCfg.Color,
			ScaleType = logoCfg.ScaleType,
			Corner = logoCfg.Corner or 8,
			LayoutOrder = logoOrder,
		}, 26)
		self.Logo.Parent = self.Brand
	else
		-- generated fallback tile using the first letter of the window name
		local side = typeof(logoSize) == "number" and logoSize or 26
		self.Logo = Util.new("Frame", {
			Name = "Logo",
			Size = UDim2.fromOffset(side, side),
			BackgroundColor3 = theme.TabActive,
			LayoutOrder = logoOrder,
			Parent = self.Brand,
		}, {
			Util.corner(8),
			Util.gradient(Util.cseq({ 0, theme.AccentLight }, { 1, theme.AccentDark }), 145),
			Util.label({
				Size = UDim2.fromScale(1, 1),
				Text = self.Name:sub(1, 1):upper(),
				Font = FONT.Black,
				TextSize = math.floor(side * 0.55),
				TextColor3 = theme.Text,
				TextXAlignment = Enum.TextXAlignment.Center,
			}),
		})
	end
	self.Logo.Visible = self.LogoEnabled

	local textStack = Util.new("Frame", {
		Name = "BrandText",
		Size = UDim2.new(1, -(typeof(logoSize) == "number" and logoSize or 26) - 10, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = logoOrder == 0 and 1 or 1,
		Parent = self.Brand,
	}, { Util.list(2) })
	if dir == Enum.FillDirection.Vertical then
		textStack.Size = UDim2.new(1, 0, 0, 0)
	end
	self.BrandText = Util.label({
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 16),
		Text = self.Name,
		Font = FONT.Black,
		TextSize = 14,
		TextColor3 = theme.Text,
		Parent = textStack,
	})
	self.BrandSub = Util.label({
		Name = "Subtitle",
		Size = UDim2.new(1, 0, 0, 12),
		Text = tostring(config.Subtitle or ""),
		Font = FONT.Medium,
		TextSize = 10,
		TextColor3 = theme.MutedText,
		Visible = config.Subtitle ~= nil,
		Parent = textStack,
	})

	-- tab rail: scrolls when there are more tabs than space
	self.TabList = Util.new("ScrollingFrame", {
		Name = "TabList",
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 1, -92),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = theme.Accent,
		ScrollBarImageTransparency = 0.5,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ElasticBehavior = Enum.ElasticBehavior.Never,
		ZIndex = LAYER.Content + 3,
		Parent = self.Sidebar,
	}, { Util.list(4), Util.pad(4, 8, 8, 8) })

	self.Footer = Util.new("Frame", {
		Name = "Footer",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -6),
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		ZIndex = LAYER.Content + 3,
		Parent = self.Sidebar,
	}, { Util.pad(0, 10, 0, 10) })
	self.FooterLabel = Util.label({
		Size = UDim2.fromScale(1, 1),
		Text = tostring(config.Footer or ("v" .. NexoUI.Version)),
		Font = FONT.Medium,
		TextSize = 9.5,
		TextColor3 = theme.MutedText,
		Parent = self.Footer,
	})

	-- body ---------------------------------------------------------------
	self.Body = Util.new("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(self.SidebarWidth, 0),
		Size = UDim2.new(1, -self.SidebarWidth, 1, 0),
		BackgroundTransparency = 1,
		ZIndex = LAYER.Content + 2,
		Parent = self.Main,
	})

	self.Header = Util.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, self.HeaderHeight),
		BackgroundTransparency = 1,
		Active = true,
		ZIndex = LAYER.Header,
		Parent = self.Body,
	}, { Util.pad(6, 8, 6, 8) })

	-- window controls, right aligned, never overlapping the sub tab rail
	local controls = Util.new("Frame", {
		Name = "Controls",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(0, 24),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		ZIndex = LAYER.Header + 1,
		Parent = self.Header,
	}, { Util.list(6, Enum.FillDirection.Horizontal) })
	local cList = controls:FindFirstChildOfClass("UIListLayout")
	if cList then cList.VerticalAlignment = Enum.VerticalAlignment.Center end

	self.SearchBox = Util.new("TextBox", {
		Name = "SearchBox",
		Size = UDim2.fromOffset(0, 24),
		BackgroundColor3 = theme.Field,
		Text = "",
		PlaceholderText = "Search...",
		PlaceholderColor3 = theme.MutedText,
		TextColor3 = theme.Text,
		Font = FONT.Medium,
		TextSize = 11.5,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Visible = false,
		LayoutOrder = 0,
		ZIndex = LAYER.Header + 1,
		Parent = controls,
	}, { Util.corner(8), Util.pad(0, 8, 0, 8) })
	Util.stroke(theme.Border, 0.78, 1).Parent = self.SearchBox

	if config.Search ~= false then
		local searchBtn = glyphButton(controls, "Search", 1)
		self.Maid:Give(searchBtn.Activated:Connect(function()
			local open = not self.SearchBox.Visible
			self.SearchBox.Visible = true
			Util.tween(self.SearchBox, 0.2, { Size = UDim2.fromOffset(open and 132 or 0, 24) })
			if open then
				self.SearchBox:CaptureFocus()
			else
				self.SearchBox.Text = ""
				self:Search("")
				task.delay(0.2, function() self.SearchBox.Visible = false end)
			end
		end))
		self.Maid:Give(self.SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
			self:Search(self.SearchBox.Text)
		end))

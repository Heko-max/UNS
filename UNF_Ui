		Name = "ProfileManagerHost", Frame = host, Tab = container.Tab,
	}, container.Window, host)

	local self = setmetatable({
		Container = container, Window = container.Window, Config = config,
		Maid = Maid.new(), Changed = Signal.new(), UserVisible = true, Enabled = true,
		Frame = host, Name = config.Name or "Profiles", Inner = inner,
	}, NexoUI.ComponentClass)

	local dropdown = inner:CreateDropdown({
		Name = config.Name or "Profile",
		Description = config.Description or "Save, load and switch configuration profiles",
		Options = Profiles:List(),
		Default = Profiles:GetActive(),
		Placeholder = "Select profile",

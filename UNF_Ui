local register = function(name, builder) NexoUI:RegisterComponent(name, builder) end

register("Button", function(container, config)
	local self = NexoUI.NewComponent(container, config, {
		Class = "TextButton", Interactive = true, Reserve = 0,
	})
	local frame = self.Frame
	self.Maid:Give(frame.Activated:Connect(function()
		if not self.Enabled then return end
		Util.tween(frame, 0.08, { BackgroundTransparency = 0.35 })
		task.delay(0.09, function()
			if frame.Parent then Util.tween(frame, 0.12, { BackgroundTransparency = 0.02 }) end
		end)
		Util.safe(config.Callback, self)
		self.Changed:Fire(true)
	end))
	return self
end)


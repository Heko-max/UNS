register("Keybind", function(container, config)
	local theme = NexoUI.Theme
	local self = NexoUI.NewComponent(container, config, {
		Reserve = 94, ControlHeight = 30, Interactive = true,
	})
	local mode = tostring(config.Mode or "Toggle"):lower()
	self.Value = typeof(config.Default) == "EnumItem" and config.Default
		or (typeof(config.Key) == "EnumItem" and config.Key or nil)

	local button = Util.new("TextButton", {
		Name = "Bind",
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(94, 30),
		BackgroundColor3 = theme.Panel,
		ZIndex = LAYER.Content + 8,
		Parent = self.Right,
	}, { Util.corner(9) })
	local bStroke = Util.stroke(theme.Border, 0.78, 1)
	bStroke.Parent = button
	local label = Util.label({
		Size = UDim2.fromScale(1, 1),
		Text = "None",
		Font = FONT.Bold,
		TextSize = 12,
		TextColor3 = theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = LAYER.Content + 9,
		Parent = button,
	})
	self.Control = button

	local listening = false
	self._set = function(value, silent)
		if value ~= nil and typeof(value) ~= "EnumItem" then
			Util.warn("keybind expects an Enum.KeyCode")
			return
		end
		self.Value = value
		label.Text = value and value.Name or "None"
		if not silent then
			Util.safe(config.OnChanged, value, self)
			self.Changed:Fire(value)
		end
	end
	self._set(self.Value, true)
	function self:ClearKey() self._set(nil) return self end

	self.Maid:Give(button.Activated:Connect(function()
		if not self.Enabled then return end
		listening = true
		label.Text = "..."
		Util.tween(bStroke, 0.14, { Transparency = 0.3 })
	end))
	self.Maid:Give(UserInputService.InputBegan:Connect(function(input, processed)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				Util.tween(bStroke, 0.16, { Transparency = 0.78 })
				if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
					self._set(nil)
				else
					self._set(input.KeyCode)
				end
			end
			return
		end
		if processed or not self.Enabled or not self.Value then return end
		if input.KeyCode == self.Value then
			if mode == "hold" then
				Util.safe(config.Callback, true, self)
			else
				Util.safe(config.Callback, true, self)
			end
			self.Changed:Fire(true)
		end
	end))
	self.Maid:Give(UserInputService.InputEnded:Connect(function(input)
		if mode == "hold" and self.Value and input.KeyCode == self.Value then
			Util.safe(config.Callback, false, self)
			self.Changed:Fire(false)
		end
	end))
	self.Maid:Give(Util.onTheme(function(t)
		if not button.Parent then return end
		button.BackgroundColor3 = t.Panel
		bStroke.Color = t.Border
		label.TextColor3 = t.SubText
	end))
	return self
end)

register("ColorPicker", function(container, config)

function NexoUI:KeySystem(config)
	config = typeof(config) == "table" and config or {}
	local theme = NexoUI.Theme
	local keys = {}
	for _, key in ipairs(config.Keys or {}) do table.insert(keys, tostring(key)) end
	if config.Key then table.insert(keys, tostring(config.Key)) end
	local fileName = tostring(config.FileName or "NexoUI_key.txt")
	local saveKey = config.SaveKey ~= false
	local attemptsLeft = tonumber(config.Attempts) or 5
	local unlocks = config.Unlocks or "default"

	local function validate(input)
		input = tostring(input or "")
		if input == "" then return false end
		if typeof(config.Validate) == "function" then
			local ok, result = pcall(config.Validate, input)
			if ok and result then return true end
			if ok then return false end
		end
		for _, key in ipairs(keys) do
			if input == key then return true end
		end
		return false
	end

	local resolved, result = false, false
	local gui = standaloneGui("NexoKeySystem", 1000000)
	local panel = overlayPanel(gui, 380, 330)
	Util.pad(20, 22, 20, 22).Parent = panel
	local list = Util.list(12)
	list.Parent = panel

	local logoId = Util.image(config.Logo or config.Image or config.Icon)
	if logoId ~= "" then
		local img = Util.imageObject({ Image = logoId, Size = config.LogoSize or 54, Corner = 12, LayoutOrder = 1 }, 54)
		img.ZIndex = 4
		img.Parent = panel
	end
	Util.label({
		Size = UDim2.new(1, 0, 0, 24),
		Text = tostring(config.Title or "NEXO  ACCESS"),
		Font = FONT.Black,
		TextSize = 19,
		TextColor3 = theme.Text,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 2,
		ZIndex = 4,
		Parent = panel,
	})
	Util.label({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = tostring(config.Note or config.Subtitle or "Enter your access key to continue."),
		Font = FONT.Regular,
		TextSize = 12.5,
		TextColor3 = theme.SubText,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		LineHeight = 1.3,
		LayoutOrder = 3,
		ZIndex = 4,
		Parent = panel,
	})

	local box = Util.new("TextBox", {
		Name = "KeyInput",
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundColor3 = theme.Field,
		Text = "",
		PlaceholderText = tostring(config.Placeholder or "Paste key here"),
		PlaceholderColor3 = theme.MutedText,
		TextColor3 = theme.Text,
		Font = FONT.Medium,
		TextSize = 13.5,
		ClearTextOnFocus = false,
		LayoutOrder = 4,
		ZIndex = 4,
		Parent = panel,
	}, { Util.corner(11), Util.pad(0, 14, 0, 14) })
	local boxStroke = Util.stroke(theme.Border, 0.6, 1.2)
	boxStroke.Parent = box

	local status = Util.label({
		Size = UDim2.new(1, 0, 0, 16),
		Text = "",
		Font = FONT.Medium,
		TextSize = 12,
		TextColor3 = theme.Error,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 5,
		ZIndex = 4,
		Parent = panel,
	})

	local row = Util.new("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		LayoutOrder = 6,
		ZIndex = 4,
		Parent = panel,
	})
	local rowList = Util.list(8, Enum.FillDirection.Horizontal)
	rowList.Parent = row

	local function makeButton(text, primary, order, width)
		local button = Util.new("TextButton", {
			Name = text,
			Text = text,
			AutoButtonColor = false,
			Font = FONT.Bold,
			TextSize = 13,
			TextColor3 = theme.Text,
			Size = UDim2.new(width, 0, 1, 0),
			BackgroundColor3 = primary and theme.ToggleOn or theme.Button,
			LayoutOrder = order,
			ZIndex = 5,
			Parent = row,
		}, { Util.corner(10) })
		Util.stroke(theme.Border, primary and 0.5 or 0.85, 1).Parent = button
		button.MouseEnter:Connect(function()
			Util.tween(button, 0.14, { BackgroundColor3 = primary and theme.AccentLight or theme.ButtonHover })
		end)
		button.MouseLeave:Connect(function()
			Util.tween(button, 0.16, { BackgroundColor3 = primary and theme.ToggleOn or theme.Button })
		end)
		return button
	end

	local hasLink = config.GetKeyLink ~= nil
	local checkWidth = hasLink and 0.56 or 1
	local getButton
	if hasLink then
		getButton = makeButton(tostring(config.GetKeyText or "Get key"), false, 1, 0.42)
	end
	local checkButton = makeButton(tostring(config.CheckText or "Unlock"), true, 2, checkWidth)

	local footer = Util.label({
		Size = UDim2.new(1, 0, 0, 14),
		Text = "Attempts left: " .. tostring(attemptsLeft),
		Font = FONT.Regular,
		TextSize = 11,
		TextColor3 = theme.MutedText,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 7,
		ZIndex = 4,
		Parent = panel,
	})

	local function finish(success)
		if resolved then return end
		resolved, result = true, success
		if success then
			for _, key in ipairs(nameList(unlocks)) do Access:UnlockKey(key, true) end
			if saveKey and typeof(writefile) == "function" then
				pcall(writefile, fileName, box.Text)
			end
			Util.safe(config.OnSuccess, box.Text)
		else
			Util.safe(config.OnFail)
		end
		Util.safe(config.Callback, success, box.Text)
		Util.tween(panel, 0.2, { Size = UDim2.fromOffset(panel.AbsoluteSize.X, 0) })
		task.delay(0.24, function() pcall(function() gui:Destroy() end) end)
		NexoUI.FireHook("KeySystemResolved", success)
	end

	local function submit()
		if resolved then return end
		if validate(box.Text) then
			status.TextColor3 = theme.Success
			status.Text = "Key accepted"
			Util.tween(boxStroke, 0.15, { Color = theme.Success, Transparency = 0.2 })
			task.delay(0.35, function() finish(true) end)
		else
			attemptsLeft = attemptsLeft - 1
			status.TextColor3 = theme.Error
			status.Text = attemptsLeft > 0 and "Invalid key" or "Too many attempts"
			footer.Text = "Attempts left: " .. tostring(math.max(attemptsLeft, 0))
			Util.tween(boxStroke, 0.12, { Color = theme.Error, Transparency = 0.15 })
			local origin = panel.Position
			Util.tween(panel, 0.05, { Position = origin + UDim2.fromOffset(9, 0) })
			task.delay(0.05, function()
				if panel.Parent then Util.tween(panel, 0.05, { Position = origin - UDim2.fromOffset(9, 0) }) end
			end)
			task.delay(0.1, function()
				if panel.Parent then Util.tween(panel, 0.08, { Position = origin }) end
			end)
			if attemptsLeft <= 0 then task.delay(0.6, function() finish(false) end) end
		end
	end

	checkButton.Activated:Connect(submit)
	box.FocusLost:Connect(function(enter) if enter then submit() end end)
	if getButton then
		getButton.Activated:Connect(function()
			local copied = NexoUI:Copy(tostring(config.GetKeyLink))
			status.TextColor3 = copied and theme.Success or theme.Warning
			status.Text = copied and "Link copied to clipboard" or tostring(config.GetKeyLink)
			Util.safe(config.OnGetKey)
		end)
	end

	-- saved key auto unlock
	if saveKey and typeof(readfile) == "function" then
		local exists = true
		if typeof(isfile) == "function" then
			local ok, found = pcall(isfile, fileName)
			exists = ok and found
		end
		if exists then
			local ok, saved = pcall(readfile, fileName)
			if ok and validate(saved) then
				box.Text = saved
				status.TextColor3 = theme.Success
				status.Text = "Saved key accepted"
				task.delay(0.35, function() finish(true) end)
			end
		end
	end

	local handle = {
		Gui = gui,
		Panel = panel,
		Submit = submit,
		Close = function() finish(false) end,
		IsResolved = function() return resolved end,
		GetResult = function() return result end,
	}
	if config.Blocking == false then return handle end
	while not resolved do task.wait(0.05) end
	return result, handle
end


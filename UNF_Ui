			end)
			return button
		end

		local hasLink = config.GetKeyLink ~= nil
		local getButton
		if hasLink then
			getButton = makeButton(tostring(config.GetKeyText or "Get key"), false, 1, 0.42)
		end
		local checkButton = makeButton(tostring(config.CheckText or "Unlock"), true, 2, hasLink and 0.56 or 1)

		local footer = Util.label({
			Size = UDim2.new(1, 0, 0, 13),
			Text = "Attempts left: " .. tostring(attemptsLeft),
			Font = FONT.Regular,
			TextSize = 10.5,
			TextColor3 = theme.MutedText,
			TextXAlignment = Enum.TextXAlignment.Center,
			LayoutOrder = 7,
			ZIndex = 4,
			Parent = panel,
		})

		tw(scale, Motion.Slow, { Scale = 1 }, Enum.EasingStyle.Back)

		local function finish(success)
			if resolved then return end
			resolved, result = true, success
			if success then
				for _, key in ipairs(nameList(unlocks)) do Access:UnlockKey(key, true) end
				if saveKey and typeof(writefile) == "function" then
					pcall(writefile, fileName, box.Text)
				end
				Util.safe(config.OnSuccess, box.Text)
			else
				Util.safe(config.OnFail)
			end
			Util.safe(config.Callback, success, box.Text)
			tw(scale, Motion.Base, { Scale = 0.94 })
			tw(panel, Motion.Base, { BackgroundTransparency = 1 })
			tw(blocker, Motion.Base, { BackgroundTransparency = 1 })
			task.delay(Motion.Base + 0.06, function()
				pcall(function() gui:Destroy() end)
			end)
			if success then
				thaw()
			else
				NexoUI.Locked = false
				for _, win in ipairs(NexoUI.Windows) do
					if win.Mini then win.Mini.Visible = true end
				end
			end
			NexoUI.FireHook("KeySystemResolved", success)
		end

		local function submit()
			if resolved then return end
			if validate(box.Text) then
				status.TextColor3 = NexoUI.Theme.Success
				status.Text = "Key accepted"
				tw(boxStroke, Motion.Fast, { Color = NexoUI.Theme.Success, Transparency = 0.2 })
				task.delay(0.3, function() finish(true) end)
			else
				attemptsLeft = attemptsLeft - 1
				status.TextColor3 = NexoUI.Theme.Error
				status.Text = attemptsLeft > 0 and "Invalid key" or "Too many attempts"
				footer.Text = "Attempts left: " .. tostring(math.max(attemptsLeft, 0))
				tw(boxStroke, Motion.Fast, { Color = NexoUI.Theme.Error, Transparency = 0.15 })
				local origin = shell.Position
				Util.tween(shell, 0.05, { Position = origin + UDim2.fromOffset(8, 0) })
				task.delay(0.05, function()
					if shell.Parent then Util.tween(shell, 0.05, { Position = origin - UDim2.fromOffset(8, 0) }) end
				end)
				task.delay(0.1, function()
					if shell.Parent then Util.tween(shell, 0.08, { Position = origin }) end
				end)
				if attemptsLeft <= 0 then task.delay(0.55, function() finish(false) end) end
			end
		end

		checkButton.Activated:Connect(submit)
		box.FocusLost:Connect(function(enter) if enter then submit() end end)
		if getButton then
			getButton.Activated:Connect(function()
				local copied = NexoUI:Copy(tostring(config.GetKeyLink))
				status.TextColor3 = copied and NexoUI.Theme.Success or NexoUI.Theme.Warning
				status.Text = copied and "Link copied to clipboard" or tostring(config.GetKeyLink)
				Util.safe(config.OnGetKey)
			end)
		end

		if saveKey and typeof(readfile) == "function" then
			local exists = true
			if typeof(isfile) == "function" then
				local ok, found = pcall(isfile, fileName)
				exists = ok and found
			end
			if exists then
				local ok, saved = pcall(readfile, fileName)
				if ok and validate(saved) then
					box.Text = saved
					status.TextColor3 = NexoUI.Theme.Success
					status.Text = "Saved key accepted"
					task.delay(0.3, function() finish(true) end)
				end
			end
		end

		local handle = {
			Gui = gui,
			Panel = panel,
			Submit = submit,
			Close = function() finish(false) end,
			IsResolved = function() return resolved end,
			GetResult = function() return result end,
		}
		if config.Blocking == false then return handle end
		while not resolved do task.wait(0.05) end
		return result, handle
	end

	-- ------------------------------------------------------------------
	--  WRAPPERS: tabs on top, sections on the left, unified shell
	-- ------------------------------------------------------------------
	local previousTab = Window.CreateTab
	function Window:CreateTab(config)
		local tab = previousTab(self, config)
		if tab and tab.Page then polishScroll(tab.Page) end
		if tab and tab.Button and self.TopBar then
			Util.safe(function()
				local isImage = tab.Icon and tab.Icon:IsA("ImageLabel")
				local textStart = isImage and 24 or 18
				local width = math.clamp(#tostring(tab.Name) * 7 + textStart + 12, 58, 170)
				tab.Button.Size = UDim2.fromOffset(width, (self.TopBarHeight or 30) - 8)
				if tab.Icon then
					tab.Icon.AnchorPoint = Vector2.new(0, 0.5)
					tab.Icon.Position = UDim2.new(0, isImage and 7 or 9, 0.5, 0)
				end
				if tab.Label then
					tab.Label.Position = UDim2.fromOffset(textStart, 0)
					tab.Label.Size = UDim2.new(1, -(textStart + 8), 1, 0)
					tab.Label.TextSize = 11.5
				end
				tab._SetCompact = function() return tab end
			end)
		end
		return tab
	end

	local previousSection = ContainerMethods.CreateSection
	function ContainerMethods:CreateSection(config)
		local section = previousSection(self, config)
		local win = self.Window
		if section and win and win.SectionNav then
			Util.safe(function()
				addNavEntry(win, section.Tab or self.Tab or win.ActiveTab, section)
			end)
		end
		return section
	end

	local previousCreateWindow = NexoUI.CreateWindow
	function NexoUI:CreateWindow(config)
		if typeof(config) ~= "table" then config = {} end
		local win = previousCreateWindow(self, config)
		if not win then return win end

		Util.safe(function()
			-- 1. one container so every layer animates as a single unit
			local shell, isGroup = makeShell(win.Gui)
			win.Shell, win.ShellGroup = shell, isGroup
			for _, name in ipairs({ "Root", "PopupLayer", "TooltipLayer", "DialogLayer", "ToastLayer" }) do
				local part = win[name]
				if part then part.Parent = shell end
			end
			if win.Mini then win.Mini.Parent = win.Gui end

			-- 2. glass look and hard bounds
			win:SetTransparency(win.BackgroundAlpha or 0.22)
			win.Body.ClipsDescendants = true
			win.Pages.ClipsDescendants = true
			win.Sidebar.ClipsDescendants = true
			win.Main.ClipsDescendants = true

			-- 3. tabs on top, categories on the left
			if config.TopTabs ~= false then buildTopBar(win) end

			-- 4. scrollbars
			for _, descendant in ipairs(win.Gui:GetDescendants()) do polishScroll(descendant) end

			-- 5. one synchronised entrance
			if isGroup then
				shell.GroupTransparency = 1
				tw(shell, Motion.Slow, { GroupTransparency = 0 })
			end
			win:_ApplyLayoutMode()
			win:_Refresh()
			win:_SyncMini(true)
		end)

		if config.Colors then Util.safe(function() NexoUI:SetColors(config.Colors) end) end
		return win
	end
end


-- =====================================================================
--  31. NEXO UI 2.2  -  FLAT UNDERLINE TABS + EQUIPPED (RED) OUTLINE
--  Top row = tabs (plain text + sliding red underline, no pill button,
--  no dot). Left rail = sections. Active items get a clean red ring so
--  it is obvious what is currently equipped / selected.
-- =====================================================================
do
	local Motion = NexoUI.Motion
	local function tw(inst, dur, goal, style)
		return Util.tween(inst, dur or Motion.Base, goal, style or Motion.Style, Motion.Dir)
	end

	-- ------------------------------------------------------------------
	--  TABS
	-- ------------------------------------------------------------------
	local previousTab = Window.CreateTab
	function Window:CreateTab(config)
		local tab = previousTab(self, config)
		if not tab or not tab.Button then return tab end
		local window = self

		Util.safe(function()
			local button, label, icon = tab.Button, tab.Label, tab.Icon
			local theme = NexoUI.Theme

			-- strip the old pill: no fill, no border, no gradient, no dot
			button.BackgroundTransparency = 1
			button.AutoButtonColor = false
			button.ClipsDescendants = false
			for _, child in ipairs(button:GetChildren()) do
				if child:IsA("UIStroke") then
					child.Transparency = 1
					child.Enabled = false
				elseif child:IsA("UIGradient") then
					child.Enabled = false
				elseif child:IsA("UICorner") then
					child.CornerRadius = UDim.new(0, 9)
				end
			end

			local isImage = icon ~= nil and icon:IsA("ImageLabel")
			if icon and not isImage then icon.Visible = false end
			local inset = isImage and 22 or 0
			if isImage then
				icon.AnchorPoint = Vector2.new(0, 0.5)
				icon.Position = UDim2.new(0, 8, 0.5, 0)
			end
			if label then
				label.Position = UDim2.fromOffset(inset, 0)
				label.Size = UDim2.new(1, -inset, 1, 0)
				label.TextXAlignment = Enum.TextXAlignment.Center
				label.Font = FONT.Bold
				label.TextSize = 12
			end

			local width = math.clamp(#tostring(tab.Name) * 7 + inset + 20, 52, 170)
			if window.TopBar then
				button.Size = UDim2.fromOffset(width, (window.TopBarHeight or 30) - 6)
			else
				width = button.AbsoluteSize.X > 0 and button.AbsoluteSize.X or width
			end

			-- sliding red underline
			local underline = Util.new("Frame", {
				Name = "Underline",
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 1, 0),
				Size = UDim2.fromOffset(0, 2),
				BackgroundColor3 = theme.Accent,
				BackgroundTransparency = 0.05,
				BorderSizePixel = 0,
				ZIndex = LAYER.Content + 6,
				Parent = button,
			}, { Util.corner(999) })
			NexoUI.TrackGradient(Util.gradient(NexoUI.Gradient or Util.cseq(
				{ 0, theme.AccentLight }, { 1, theme.AccentDark }
			), 0)).Parent = underline

			-- "equipped" red ring for the active tab
			local ring = Util.stroke(theme.Accent, 1, 1.1)
			ring.Parent = button
			ring.Enabled = true

			tab.Underline = underline
			tab.Ring = ring

			function tab:_Paint(active, instant)
				local t = NexoUI.Theme
				self.Active = active and true or false
				local dur = instant and 0 or Motion.Base
				local target = button.AbsoluteSize.X > 0 and button.AbsoluteSize.X or width
				tw(underline, dur, {
					Size = UDim2.fromOffset(self.Active and math.max(target - 18, 12) or 0, 2),
					BackgroundTransparency = self.Active and 0.05 or 1,
				})
				tw(ring, dur, { Transparency = self.Active and 0.42 or 1 })
				tw(button, dur, { BackgroundTransparency = self.Active and 0.93 or 1 })
				if label then
					tw(label, dur, { TextColor3 = self.Active and t.Text or t.SubText })
					label.TextTransparency = self.Active and 0 or 0.15
				end
				if isImage then
					tw(icon, dur, { ImageColor3 = self.Active and t.Accent or t.MutedText })
				end
				ring.Color = t.Accent
				underline.BackgroundColor3 = t.Accent
				return self
			end

			tab._SetCompact = function() return tab end

			tab.Maid:Give(button.MouseEnter:Connect(function()
				if tab.Active then return end
				if label then tw(label, Motion.Fast, { TextColor3 = NexoUI.Theme.Text }) end
				tw(underline, Motion.Fast, {
					Size = UDim2.fromOffset(14, 2),
					BackgroundTransparency = 0.55,
				})
			end))
			tab.Maid:Give(button.MouseLeave:Connect(function()
				if tab.Active then return end
				if label then tw(label, Motion.Fast, { TextColor3 = NexoUI.Theme.SubText }) end
				tw(underline, Motion.Fast, { Size = UDim2.fromOffset(0, 2), BackgroundTransparency = 1 })
			end))

			tab:_Paint(tab.Active, true)
			task.defer(function()
				if button.Parent then tab:_Paint(tab.Active, true) end
			end)
		end)

		return tab
	end

	-- ------------------------------------------------------------------
	--  LEFT RAIL SECTIONS: same equipped ring, rounded, clean
	-- ------------------------------------------------------------------
	local function paintNav(entry, active, instant)
		local dur = instant and 0 or Motion.Fast
		entry.Active = active and true or false
		if entry.Ring then tw(entry.Ring, dur, { Transparency = entry.Active and 0.4 or 1 }) end
		if entry.Button then
			tw(entry.Button, dur, { BackgroundTransparency = entry.Active and 0.88 or 1 })
		end
		if entry.Label then
			tw(entry.Label, dur, {
				TextColor3 = entry.Active and NexoUI.Theme.Text or NexoUI.Theme.SubText,
			})
		end
		if entry.Dot then
			tw(entry.Dot, dur, {
				BackgroundTransparency = entry.Active and 0 or 0.45,
				Size = UDim2.fromOffset(entry.Active and 5 or 4, entry.Active and 5 or 4),
			})
		end
	end

	function Window:SetActiveSection(section)
		for _, entry in ipairs(self.NavEntries or {}) do
			paintNav(entry, entry.Section == section)
		end
		self.ActiveSection = section
		return self
	end

	local previousSection = ContainerMethods.CreateSection
	function ContainerMethods:CreateSection(config)
		local section = previousSection(self, config)
		local window = self.Window
		if not section or not window or not window.NavEntries then return section end

		Util.safe(function()
			local entry
			for _, candidate in ipairs(window.NavEntries) do
				if candidate.Section == section then entry = candidate end
			end
			if not entry or not entry.Button then return end

			local ring = Util.stroke(NexoUI.Theme.Accent, 1, 1)
			ring.Parent = entry.Button
			entry.Ring = ring
			paintNav(entry, false, true)

			window.Maid:Give(entry.Button.Activated:Connect(function()
				window:SetActiveSection(section)
			end))
			window.Maid:Give(Util.onTheme(function(t)
				if not entry.Button.Parent then return end
				ring.Color = t.Accent
				paintNav(entry, entry.Active, true)
			end))
		end)

		return section
	end

	-- ------------------------------------------------------------------
	--  SOFTER SHELL CORNERS
	-- ------------------------------------------------------------------
	local previousCreateWindow = NexoUI.CreateWindow
	function NexoUI:CreateWindow(config)
		local win = previousCreateWindow(self, config)
		if not win then return win end

		Util.safe(function()
			if win.TopBar then
				Util.corner(12).Parent = win.TopBar
				win.TopBar.ClipsDescendants = false
				local line = win.TopBar:FindFirstChild("Line")
				if line then
					line.Size = UDim2.new(1, -20, 0, 1)
					line.Position = UDim2.new(0, 10, 1, 0)
					line.BackgroundTransparency = 0.88
				end
			end
			if win.Sidebar then Util.corner(12).Parent = win.Sidebar end
			if win.Header then Util.corner(12).Parent = win.Header end
			for _, descendant in ipairs(win.Gui:GetDescendants()) do
				if descendant:IsA("UICorner") and descendant.CornerRadius.Offset > 0
					and descendant.CornerRadius.Offset < 6 then
					descendant.CornerRadius = UDim.new(0, 8)
				end
			end
			for _, tab in ipairs(win.Tabs) do
				if tab._Paint then Util.safe(function() tab:_Paint(tab.Active, true) end) end
			end
		end)

		return win
	end
end


-- =====================================================================
--  32. NEXO UI 2.3
--  * mini ball: big image icon, no letter, no minus badge, red glow +
--    white glossy outline
--  * the top Main/Player row is gone - tabs now live on the header row
--    (where the sub pills used to sit); sub tabs drop to a slim row
--  * smooth loading screen
-- =====================================================================
do
	local Motion = NexoUI.Motion
	local WHITE = Color3.new(1, 1, 1)
	local function tw(inst, dur, goal, style)
		return Util.tween(inst, dur or Motion.Base, goal, style or Motion.Style, Motion.Dir)
	end

	NexoUI.MiniIcon = "rbxassetid://134473690393403"

	-- ------------------------------------------------------------------
	--  MINI BALL
	-- ------------------------------------------------------------------
	local previousMini = Window._BuildMiniButton
	function Window:_BuildMiniButton()
		local mini = previousMini(self)
		Util.safe(function()
			local parts = self.MiniParts
			if not parts or not parts.Root then return end

			-- drop the letter and the little minus badge
			if parts.Letter then
				parts.Letter:Destroy()
				parts.Letter = nil
			end
			if parts.Kill then
				parts.Kill:Destroy()
				parts.Kill = nil
			end

			-- big centred icon
			local icon = Util.new("ImageLabel", {
				Name = "Icon",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(0.74, 0.74),
				BackgroundTransparency = 1,
				Image = tostring(self.Config.MiniIcon or NexoUI.MiniIcon),
				ImageColor3 = WHITE,
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = mini.ZIndex + 4,
				Parent = mini,
			})
			parts.Icon = icon

			-- glossy white outline + red halo
			for _, child in ipairs(mini:GetChildren()) do
				if child:IsA("UIStroke") then child:Destroy() end
			end
			local gloss = Util.stroke(WHITE, 0.12, 1.6)
			gloss.Parent = mini
			parts.Gloss = gloss

			local halo = Util.new("Frame", {
				Name = "Halo",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.new(1, 8, 1, 8),
				BackgroundTransparency = 1,
				ZIndex = mini.ZIndex - 1,
				Parent = mini,
			}, { Util.corner(999) })
			local haloStroke = Util.stroke(Color3.fromRGB(255, 46, 62), 0.55, 2)
			haloStroke.Parent = halo
			parts.Halo = haloStroke

			-- slow shine sweep so it reads as "shiny"
			self.Maid:Give(task.spawn(function()
				while mini.Parent do
					tw(haloStroke, 0.9, { Transparency = 0.28, Thickness = 2.6 })
					task.wait(0.95)
					if not mini.Parent then return end
					tw(haloStroke, 0.9, { Transparency = 0.62, Thickness = 1.8 })
					task.wait(0.95)
				end
			end) and function() end)

			self:_SyncMini(true)
		end)
		return mini
	end

	local previousSync = Window._SyncMini
	function Window:_SyncMini(instant)
		previousSync(self, instant)
		local parts = self.MiniParts
		if not parts or not parts.Icon or not parts.Icon.Parent then return end
		local dur = instant and 0 or Motion.Fast
		tw(parts.Icon, dur, {
			ImageTransparency = self.Visible and 0.72 or 0,
			Size = UDim2.fromScale(self.Visible and 0.6 or 0.74, self.Visible and 0.6 or 0.74),
		})
		if parts.Gloss then
			tw(parts.Gloss, dur, { Transparency = self.Visible and 0.3 or 0.12 })
		end
	end

	-- ------------------------------------------------------------------
	--  ROWS: header = tabs, slim row under it = sub tabs
	-- ------------------------------------------------------------------
	function Window:_HasSubTabs()
		local tab = self.ActiveTab
		if not tab or not tab.SubBar then return false end
		for _, child in ipairs(tab.SubBar:GetChildren()) do
			if child:IsA("GuiButton") then return true end
		end
		return false
	end

	function Window:_LayoutRows()
		local top = self.HeaderHeight or 40
		local holder = self.SubBarHolder
		local rowHeight = 0
		if holder and holder.Parent == self.Body then
			local show = self:_HasSubTabs() and not self.Minimized
			holder.Visible = show
			rowHeight = show and (self.SubRowHeight or 26) or 0
			holder.Position = UDim2.fromOffset(0, top)
			holder.Size = UDim2.new(1, 0, 0, self.SubRowHeight or 26)
		end
		if self.Pages and not self.Minimized then
			local offset = top + rowHeight
			tw(self.Pages, Motion.Fast, {
				Position = UDim2.fromOffset(0, offset),
				Size = UDim2.new(1, 0, 1, -offset),
			})
		end
		return self
	end

	local previousRefresh = Window._Refresh
	function Window:_Refresh()
		previousRefresh(self)
		if self.SubBarHolder then Util.safe(function() self:_LayoutRows() end) end
	end

	local previousSelect = Window.SelectTab
	function Window:SelectTab(tab)
		local out = previousSelect(self, tab)
		Util.safe(function() self:_LayoutRows() end)
		return out
	end

	local previousSubTab = TabMethods.CreateSubTab
	function TabMethods:CreateSubTab(config)
		local sub = previousSubTab(self, config)
		Util.safe(function()
			if not self.SubBar then return end
			for _, child in ipairs(self.SubBar:GetChildren()) do
				if child:IsA("TextButton") then
					child.Size = UDim2.fromOffset(child.Size.X.Offset, 22)
					local corner = child:FindFirstChildOfClass("UICorner")
					if corner then corner.CornerRadius = UDim.new(0, 8) end
					local pad = child:FindFirstChildOfClass("UIPadding")
					if pad then
						pad.PaddingLeft = UDim.new(0, 10)
						pad.PaddingRight = UDim.new(0, 10)
					end
				end
			end
			if self.Window then self.Window:_LayoutRows() end
		end)
		return sub
	end

	local previousCreateWindow = NexoUI.CreateWindow
	function NexoUI:CreateWindow(config)
		local win = previousCreateWindow(self, config)
		if not win then return win end

		Util.safe(function()
			-- 1. delete the separate top bar, keep the tab strip
			local strip = win.TabList
			if win.TopBar then
				if strip then strip.Parent = win.Header end
				win.TopBar:Destroy()
				win.TopBar = nil
			end
			win.TopBarHeight = 0

			-- 2. sub tab pills move to their own slim row inside the body
			win.SubRowHeight = 26
			local holder = win.SubBarHolder
			if holder then
				holder.Parent = win.Body
				holder.Position = UDim2.fromOffset(win.HeaderHeight or 40, 0)
				holder.Size = UDim2.new(1, 0, 0, win.SubRowHeight)
				holder.ZIndex = LAYER.Header
				Util.pad(0, 12, 0, 12).Parent = holder
				holder.Visible = false
			end

			-- 3. tabs take over the header row the pills used to occupy
			if strip then
				strip.Name = "TabStrip"
				strip.Parent = win.Header
				strip.AnchorPoint = Vector2.new(0, 0.5)
				strip.Position = UDim2.new(0, 0, 0.5, 0)
				strip.Size = UDim2.new(1, -104, 1, 0)
				strip.BackgroundTransparency = 1
				strip.ScrollingDirection = Enum.ScrollingDirection.X
				strip.AutomaticCanvasSize = Enum.AutomaticSize.X
				strip.ScrollBarThickness = 0
				strip.ClipsDescendants = true
				strip.ZIndex = LAYER.Header + 2
				local list = strip:FindFirstChildOfClass("UIListLayout")
				if list then
					list.FillDirection = Enum.FillDirection.Horizontal
					list.VerticalAlignment = Enum.VerticalAlignment.Center
					list.Padding = UDim.new(0, 2)
				end
				local pad = strip:FindFirstChildOfClass("UIPadding")
				if pad then
					pad.PaddingTop = UDim.new(0, 0)
					pad.PaddingBottom = UDim.new(0, 0)
					pad.PaddingLeft = UDim.new(0, 2)
					pad.PaddingRight = UDim.new(0, 6)
				end
				for _, tab in ipairs(win.Tabs) do
					if tab.Button then
						tab.Button.Size = UDim2.fromOffset(tab.Button.Size.X.Offset, (win.HeaderHeight or 40) - 12)
					end
				end
			end

			win:_ApplyLayoutMode()
			win:_LayoutRows()
			win:_Refresh()
		end)

		return win
	end

	-- new tabs must match the header row height too
	local previousTab = Window.CreateTab
	function Window:CreateTab(config)
		local tab = previousTab(self, config)
		Util.safe(function()
			if tab and tab.Button and self.TabList and self.TabList.Parent == self.Header then
				tab.Button.Size = UDim2.fromOffset(tab.Button.Size.X.Offset, (self.HeaderHeight or 40) - 12)
				tab:_Paint(tab.Active, true)
			end
		end)
		return tab
	end

	-- ------------------------------------------------------------------
	--  LOADING SCREEN: soft entrance, eased bar, clean fade out
	-- ------------------------------------------------------------------
	local previousLoading = NexoUI.CreateLoadingScreen
	function NexoUI:CreateLoadingScreen(config)
		local screen = previousLoading(self, config)
		if not screen or not screen.Panel then return screen end

		Util.safe(function()
			local panel = screen.Panel
			local gui = screen.Gui

			-- find the progress bar built by the core
			local track, fill, percent
			for _, child in ipairs(panel:GetChildren()) do
				if child:IsA("Frame") and child.Size.Y.Offset == 8 then
					track = child
					fill = child:FindFirstChildWhichIsA("Frame")
				elseif child:IsA("TextLabel") and child.Text:match("%%$") then
					percent = child
				end
			end
			if track then
				track.Size = UDim2.new(1, 0, 0, 5)
				track.BackgroundTransparency = 0.45
			end

			-- smooth entrance instead of a hard pop
			local scale = panel:FindFirstChildOfClass("UIScale")
				or Util.new("UIScale", { Parent = panel })
			scale.Scale = 0.92
			tw(scale, Motion.Slow, { Scale = 1 }, Enum.EasingStyle.Back)
			panel.BackgroundTransparency = 1
			tw(panel, Motion.Slow, { BackgroundTransparency = 0.1 })

			-- travelling shine on the bar
			if fill then
				local shine = Util.new("Frame", {
					Name = "Shine",
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0, 0.5),
					Size = UDim2.new(0, 26, 1, 0),
					BackgroundColor3 = WHITE,
					BackgroundTransparency = 0.7,
					BorderSizePixel = 0,
					ZIndex = (fill.ZIndex or 5) + 1,
					Parent = fill,
				}, { Util.corner(999) })
				Util.gradient(Util.cseq(
					{ 0, WHITE }, { 0.5, WHITE }, { 1, WHITE }
				), 0, NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.5, 0.45),
					NumberSequenceKeypoint.new(1, 1),
				})).Parent = shine
				task.spawn(function()
					while shine.Parent and gui.Parent do
						shine.Position = UDim2.fromScale(0, 0.5)
						Util.tween(shine, 1.1, { Position = UDim2.fromScale(1, 0.5) }, Enum.EasingStyle.Sine)
						task.wait(1.35)
					end
				end)
			end

			-- eased progress with a counting percentage
			local shown = 0
			function screen:SetProgress(alpha, text)
				alpha = math.clamp(tonumber(alpha) or 0, 0, 1)
				self.Progress = alpha
				if fill then
					Util.tween(fill, 0.45, { Size = UDim2.fromScale(alpha, 1) },
						Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
				end
				if text then self:SetStatus(text) end
				if percent then
					local from, to = shown, math.floor(alpha * 100)
					shown = to
					task.spawn(function()
						local steps = math.max(math.abs(to - from), 1)
						for i = 1, steps do
							if not percent.Parent then return end
							percent.Text = tostring(math.floor(from + (to - from) * (i / steps))) .. "%"
							task.wait(0.45 / steps)
						end
					end)
				end
				return self
			end

			function screen:Finish(callback)
				if self._finished then return self end
				self._finished = true
				self:SetProgress(1, config and config.FinishText or "Ready")
				task.delay(0.5, function()
					tw(scale, Motion.Slow, { Scale = 1.04 })
					tw(panel, Motion.Slow, { BackgroundTransparency = 1 })
					for _, d in ipairs(panel:GetDescendants()) do
						if d:IsA("TextLabel") then
							tw(d, Motion.Slow, { TextTransparency = 1 })
						elseif d:IsA("ImageLabel") then
							tw(d, Motion.Slow, { ImageTransparency = 1 })
						elseif d:IsA("Frame") then
							tw(d, Motion.Slow, { BackgroundTransparency = 1 })
						elseif d:IsA("UIStroke") then
							tw(d, Motion.Slow, { Transparency = 1 })
						end
					end
					task.delay(Motion.Slow + 0.1, function()
						pcall(function() gui:Destroy() end)
						Util.safe(callback)
						if config then Util.safe(config.OnFinish) end
					end)
				end)
				return self
			end
		end)

		return screen
	end
end


-- =====================================================================
--  33. NEXO UI 2.4
--  * drag the sidebar border left / right to resize the section rail
--  * even smaller default window
--  * the window may be dragged up to 90% off screen, the mini ball
--    always stays fully on screen
-- =====================================================================
do
	local Motion = NexoUI.Motion
	local function tw(inst, dur, goal, style)
		return Util.tween(inst, dur or Motion.Base, goal, style or Motion.Style, Motion.Dir)
	end

	NexoUI.OffscreenAllowance = 0.9 -- 90% of the window may leave the screen

	-- ------------------------------------------------------------------
	--  FREE DRAGGING (90% off screen allowed)
	-- ------------------------------------------------------------------
	local function clampFree(win, position)
		local vp = Camera.ViewportSize
		local size = win.Root.AbsoluteSize
		local keepX = math.max(size.X * (1 - NexoUI.OffscreenAllowance), 24)
		local keepY = math.max(size.Y * (1 - NexoUI.OffscreenAllowance), 24)
		return UDim2.fromOffset(
			math.clamp(position.X.Offset, -(size.X - keepX), vp.X - keepX),
			math.clamp(position.Y.Offset, -(size.Y - keepY), vp.Y - keepY)
		)
	end

	function Window:_BindDrag(target)
		if not target then return self end
		local window = self
		target.Active = true
		local dragging, startInput, startPos = false, nil, nil

		self.Maid:Give(target.InputBegan:Connect(function(input)
			if window.DragEnabled == false then return end
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				startInput = input.Position
				startPos = window.Root.Position
			end
		end))
		self.Maid:Give(UserInputService.InputChanged:Connect(function(input)
			if not dragging or not window.Root or not window.Root.Parent then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then
				local delta = input.Position - startInput
				local wanted = UDim2.fromOffset(
					startPos.X.Offset + delta.X,
					startPos.Y.Offset + delta.Y
				)
				window._DesiredPos = clampFree(window, wanted)
				window.Root.Position = window._DesiredPos
			end
		end))
		self.Maid:Give(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end))
		return self
	end

	local previousRefresh = Window._Refresh
	function Window:_Refresh()
		previousRefresh(self)
		-- the core re-clamps the window to the screen; restore the position
		-- the user dragged it to (up to 90% outside).
		if self._DesiredPos and self.Root and self.Root.Parent then
			self.Root.Position = clampFree(self, self._DesiredPos)
		end
	end

	-- ------------------------------------------------------------------
	--  SIDEBAR RESIZE HANDLE
	-- ------------------------------------------------------------------
	function Window:SetSidebarWidth(width)
		self.SidebarWidth = math.clamp(math.floor(tonumber(width) or 120), 78, 240)
		self:_ApplyLayoutMode()
		if self.SidebarHandle then
			self.SidebarHandle.Position = UDim2.new(0, self.SidebarWidth - 3, 0, 0)
		end
		return self
	end

	local function buildSidebarHandle(win)
		local handle = Util.new("TextButton", {
			Name = "SidebarHandle",
			Text = "",
			AutoButtonColor = false,
			Active = true,
			Position = UDim2.new(0, (win.SidebarWidth or 120) - 3, 0, 0),
			Size = UDim2.new(0, 6, 1, 0),
			BackgroundTransparency = 1,
			ZIndex = LAYER.Header + 6,
			Parent = win.Main,
		})
		local line = Util.new("Frame", {
			Name = "Line",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 1, 1, -18),
			BackgroundColor3 = NexoUI.Theme.Border,
			BackgroundTransparency = 0.82,
			BorderSizePixel = 0,
			ZIndex = LAYER.Header + 7,
			Parent = handle,
		}, { Util.corner(999) })
		local grip = Util.new("Frame", {
			Name = "Grip",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(2, 18),
			BackgroundColor3 = NexoUI.Theme.Accent,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = LAYER.Header + 8,
			Parent = handle,
		}, { Util.corner(999) })

		win.SidebarHandle = handle
		local dragging, startX, startWidth = false, 0, win.SidebarWidth

		win.Maid:Give(handle.MouseEnter:Connect(function()
			tw(line, Motion.Fast, { BackgroundTransparency = 0.45 })
			tw(grip, Motion.Fast, { BackgroundTransparency = 0.1, Size = UDim2.fromOffset(2, 26) })
		end))
		win.Maid:Give(handle.MouseLeave:Connect(function()
			if dragging then return end
			tw(line, Motion.Fast, { BackgroundTransparency = 0.82 })
			tw(grip, Motion.Fast, { BackgroundTransparency = 1, Size = UDim2.fromOffset(2, 18) })
		end))
		win.Maid:Give(handle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				startX = input.Position.X
				startWidth = win.SidebarWidth
				tw(grip, Motion.Fast, { BackgroundTransparency = 0 })
			end
		end))
		win.Maid:Give(UserInputService.InputChanged:Connect(function(input)
			if not dragging or not handle.Parent then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch then
				local scale = win.Scale and win.Scale.Scale or 1
				local delta = (input.Position.X - startX) / math.max(scale, 0.05)
				win.Narrow = false
				win:SetSidebarWidth(startWidth + delta)
			end
		end))
		win.Maid:Give(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				if dragging then
					dragging = false
					tw(line, Motion.Fast, { BackgroundTransparency = 0.82 })
					tw(grip, Motion.Fast, { BackgroundTransparency = 1, Size = UDim2.fromOffset(2, 18) })
				end
			end
		end))
		win.Maid:Give(Util.onTheme(function(t)
			if not handle.Parent then return end
			line.BackgroundColor3 = t.Border
			grip.BackgroundColor3 = t.Accent
		end))
		return handle
	end

	-- keep the handle glued to the sidebar edge
	local previousLayout = Window._ApplyLayoutMode
	function Window:_ApplyLayoutMode()
		previousLayout(self)
		if self.SidebarHandle and self.SidebarHandle.Parent then
			local width = self.Narrow and 56 or self.SidebarWidth
			self.SidebarHandle.Position = UDim2.new(0, width - 3, 0, 0)
		end
	end

	-- ------------------------------------------------------------------
	--  SMALLER BY DEFAULT + WIRE EVERYTHING UP
	-- ------------------------------------------------------------------
	local previousCreateWindow = NexoUI.CreateWindow
	function NexoUI:CreateWindow(config)
		if typeof(config) ~= "table" then config = {} end
		local win = previousCreateWindow(self, config)
		if not win then return win end

		Util.safe(function()
			-- much smaller unless the caller asked for a specific size
			if config.Size == nil then
				win.BaseSize = Vector2.new(470, 316)
			end
			if config.SidebarWidth == nil then
				win.SidebarWidth = 118
			end
			win.HeaderHeight = math.min(win.HeaderHeight or 40, 34)
			if win.Header then win.Header.Size = UDim2.new(1, 0, 0, win.HeaderHeight) end
			if win.Brand then win.Brand.Size = UDim2.new(1, 0, 0, 48) end

			-- take over dragging so the window can leave the screen
			win.DragEnabled = win.Config.Draggable ~= false
			win.Config.Draggable = false -- disables the core's clamped drag
			if win.Header then win:_BindDrag(win.Header) end
			if win.Brand then win:_BindDrag(win.Brand) end

			buildSidebarHandle(win)
			win:SetSidebarWidth(win.SidebarWidth)
			win:_LayoutRows()
			win:_Refresh()
		end)

		return win
	end
end


-- =====================================================================
--  34. NEXO UI 2.5  -  TAB ROW FIX + PLAIN CIRCLE MINI BALL
--  * tabs get their own dedicated row right under the header (exactly
--    where the Combat / Farming pills used to be) instead of fighting
--    the header layout, so they can never disappear again
--  * sub tabs slide one row further down
--  * mini ball: no laser, no orbit, no spark - just a red circle with
--    the image icon and a white / red outline
-- =====================================================================
do
	local Motion = NexoUI.Motion
	local WHITE = Color3.new(1, 1, 1)
	local function tw(inst, dur, goal, style)
		return Util.tween(inst, dur or Motion.Base, goal, style or Motion.Style, Motion.Dir)
	end

	local TAB_ROW = 28
	local SUB_ROW = 26

	-- ------------------------------------------------------------------
	--  ROW LAYOUT: header / tabs / sub tabs / content
	-- ------------------------------------------------------------------
	function Window:_LayoutRows()
		local top = self.HeaderHeight or 34
		local y = top

		if self.TabRow then
			local show = not self.Minimized and #self.Tabs > 0
			self.TabRow.Visible = show
			self.TabRow.Position = UDim2.fromOffset(0, y)
			self.TabRow.Size = UDim2.new(1, 0, 0, TAB_ROW)
			if show then y = y + TAB_ROW end
		end

		local holder = self.SubBarHolder
		if holder and holder.Parent == self.Body then
			local show = not self.Minimized and self:_HasSubTabs()
			holder.Visible = show
			holder.Position = UDim2.fromOffset(0, y)
			holder.Size = UDim2.new(1, 0, 0, SUB_ROW)
			if show then y = y + SUB_ROW end
		end

		if self.Pages and not self.Minimized then
			tw(self.Pages, Motion.Fast, {
				Position = UDim2.fromOffset(0, y),
				Size = UDim2.new(1, 0, 1, -y),
			})
		end
		return self
	end

	local function sizeTabButton(win, tab)
		if not tab or not tab.Button then return end
		local label = tab.Label
		local isImage = tab.Icon ~= nil and tab.Icon:IsA("ImageLabel") and tab.Icon.Visible
		local inset = isImage and 22 or 0
		local width = math.clamp(#tostring(tab.Name) * 7 + inset + 20, 52, 170)
		tab.Button.Size = UDim2.fromOffset(width, TAB_ROW - 6)
		tab.Button.Visible = tab.UserVisible ~= false
		if label then
			label.Visible = true
			label.TextTransparency = tab.Active and 0 or 0.15
		end
		if tab._Paint then Util.safe(function() tab:_Paint(tab.Active, true) end) end
	end

	local previousCreateWindow = NexoUI.CreateWindow
	function NexoUI:CreateWindow(config)
		local win = previousCreateWindow(self, config)
		if not win then return win end

		Util.safe(function()
			-- dedicated tab row, owned by us, nothing else lays it out
			local row = win.TabRow
			if not row then
				row = Util.new("Frame", {
					Name = "TabRow",
					Position = UDim2.fromOffset(0, win.HeaderHeight or 34),
					Size = UDim2.new(1, 0, 0, TAB_ROW),
					BackgroundTransparency = 1,
					ClipsDescendants = true,
					ZIndex = LAYER.Header + 1,
					Parent = win.Body,
				})
				win.TabRow = row
			end

			local strip = win.TabList
			if strip then
				strip.Name = "TabStrip"
				strip.Parent = row
				strip.Visible = true
				strip.AnchorPoint = Vector2.new(0, 0)
				strip.Position = UDim2.fromOffset(0, 0)
				strip.Size = UDim2.fromScale(1, 1)
				strip.BackgroundTransparency = 1
				strip.ScrollingDirection = Enum.ScrollingDirection.X
				strip.AutomaticCanvasSize = Enum.AutomaticSize.X
				strip.CanvasSize = UDim2.new()
				strip.ScrollBarThickness = 0
				strip.ClipsDescendants = true
				strip.ZIndex = LAYER.Header + 2
				local list = strip:FindFirstChildOfClass("UIListLayout")
				if list then
					list.FillDirection = Enum.FillDirection.Horizontal
					list.VerticalAlignment = Enum.VerticalAlignment.Center
					list.HorizontalAlignment = Enum.HorizontalAlignment.Left
					list.Padding = UDim.new(0, 2)
				end
				local pad = strip:FindFirstChildOfClass("UIPadding")
				if pad then
					pad.PaddingTop = UDim.new(0, 0)
					pad.PaddingBottom = UDim.new(0, 0)
					pad.PaddingLeft = UDim.new(0, 12)
					pad.PaddingRight = UDim.new(0, 12)
				end
				for _, tab in ipairs(win.Tabs) do sizeTabButton(win, tab) end
			end

			-- sub tabs sit one row lower
			if win.SubBarHolder then
				win.SubBarHolder.Parent = win.Body
				win.SubBarHolder.ZIndex = LAYER.Header
			end

			win:_LayoutRows()
			win:_Refresh()
		end)

		return win
	end

	local previousTab = Window.CreateTab
	function Window:CreateTab(config)
		local tab = previousTab(self, config)
		Util.safe(function()
			if not tab then return end
			sizeTabButton(self, tab)
			self:_LayoutRows()
		end)
		return tab
	end

	-- ------------------------------------------------------------------
	--  MINI BALL: plain red circle + icon, no laser / orbit / spark
	-- ------------------------------------------------------------------
	local previousMini = Window._BuildMiniButton
	function Window:_BuildMiniButton()
		local mini = previousMini(self)
		Util.safe(function()
			local parts = self.MiniParts
			if not parts or not parts.Root then return end

			-- strip every laser / orbit / spark part
			local laser = mini:FindFirstChild("LaserRing")
			if laser then laser:Destroy() end
			parts.Ring = nil
			parts.Dot = nil
			parts.Trail = nil

			-- guarantee a perfect circle
			local aspect = mini:FindFirstChildOfClass("UIAspectRatioConstraint")
				or Util.new("UIAspectRatioConstraint", { Parent = mini })
			aspect.AspectRatio = 1
			local corner = mini:FindFirstChildOfClass("UICorner")
			if corner then corner.CornerRadius = UDim.new(1, 0) end

			if parts.Icon then
				parts.Icon.Size = UDim2.fromScale(0.82, 0.82)
				parts.Icon.ScaleType = Enum.ScaleType.Fit
			end
			if parts.Halo and parts.Halo.Parent then
				local halo = parts.Halo.Parent
				local haloCorner = halo:FindFirstChildOfClass("UICorner")
				if haloCorner then haloCorner.CornerRadius = UDim.new(1, 0) end
				local haloAspect = halo:FindFirstChildOfClass("UIAspectRatioConstraint")
					or Util.new("UIAspectRatioConstraint", { Parent = halo })
				haloAspect.AspectRatio = 1
			end

			self:_SyncMini(true)
		end)
		return mini
	end

	local previousSync = Window._SyncMini
	function Window:_SyncMini(instant)
		local parts = self.MiniParts
		if parts then
			parts.Ring = nil
			parts.Dot = nil
			parts.Trail = nil
		end
		previousSync(self, instant)
	end
end


-- =====================================================================
--  35. NEXO UI 2.6
--  * tabs go back to the LEFT rail (vertical), sections sit under them
-- =====================================================================
do
	local Motion = NexoUI.Motion
	local function tw(inst, dur, goal, style)
		return Util.tween(inst, dur or Motion.Base, goal, style or Motion.Style, Motion.Dir)
	end

	local BRAND_H = 42

	local function styleTab(win, tab)
		if not tab or not tab.Button then return end
		local button, label, icon = tab.Button, tab.Label, tab.Icon
		local isImage = icon ~= nil and icon:IsA("ImageLabel")

		button.Size = UDim2.new(1, 0, 0, 24)
		button.Visible = tab.UserVisible ~= false

		if isImage then
			icon.AnchorPoint = Vector2.new(0, 0.5)
			icon.Position = UDim2.new(0, 10, 0.5, 0)
		end
		local inset = isImage and 26 or 12
		if label then
			label.Position = UDim2.fromOffset(inset, 0)
			label.Size = UDim2.new(1, -(inset + 8), 1, 0)
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.TextSize = 11.5
			label.Visible = true
		end

		local bar = tab.Underline
		if bar then
			bar.AnchorPoint = Vector2.new(0, 0.5)
			bar.Position = UDim2.new(0, 3, 0.5, 0)
			bar.Size = UDim2.fromOffset(2, 0)
		end

		function tab:_Paint(active, instant)
			local t = NexoUI.Theme
			self.Active = active and true or false
			local dur = instant and 0 or Motion.Base
			if bar then
				tw(bar, dur, {
					Size = UDim2.fromOffset(2, self.Active and 13 or 0),
					BackgroundTransparency = self.Active and 0 or 1,
				})
				bar.BackgroundColor3 = t.Accent
			end
			if self.Ring then
				tw(self.Ring, dur, { Transparency = self.Active and 0.45 or 1 })
				self.Ring.Color = t.Accent
			end
			tw(button, dur, { BackgroundTransparency = self.Active and 0.9 or 1 })
			if label then
				tw(label, dur, { TextColor3 = self.Active and t.Text or t.SubText })
				label.TextTransparency = self.Active and 0 or 0.2
			end
			if isImage then
				tw(icon, dur, { ImageColor3 = self.Active and t.Accent or t.MutedText })
			end
			return self
		end

		tab._SetCompact = function(_, compact)
			if label then label.Visible = not compact end
			return tab
		end
		tab:_Paint(tab.Active, true)
	end

	local function mountLeftRail(win)
		local strip = win.TabList
		if not strip then return end

		if win.TabRow then
			win.TabRow.Visible = false
			win.TabRow:Destroy()
			win.TabRow = nil
		end

		strip.Name = "TabList"
		strip.Parent = win.Sidebar
		strip.Visible = true
		strip.AnchorPoint = Vector2.new(0, 0)
		strip.Position = UDim2.fromOffset(0, BRAND_H)
		strip.Size = UDim2.new(1, 0, 0.52, -(BRAND_H + 4))
		strip.BackgroundTransparency = 1
		strip.ScrollingDirection = Enum.ScrollingDirection.Y
		strip.AutomaticCanvasSize = Enum.AutomaticSize.Y
		strip.CanvasSize = UDim2.new()
		strip.ScrollBarThickness = 0
		strip.ClipsDescendants = true
		strip.ZIndex = LAYER.Content + 3

		local list = strip:FindFirstChildOfClass("UIListLayout")
		if list then
			list.FillDirection = Enum.FillDirection.Vertical
			list.HorizontalAlignment = Enum.HorizontalAlignment.Left
			list.VerticalAlignment = Enum.VerticalAlignment.Top
			list.Padding = UDim.new(0, 2)
		end
		local pad = strip:FindFirstChildOfClass("UIPadding")
		if pad then
			pad.PaddingTop = UDim.new(0, 2)
			pad.PaddingBottom = UDim.new(0, 4)
			pad.PaddingLeft = UDim.new(0, 6)
			pad.PaddingRight = UDim.new(0, 6)
		end

		if win.NavCaption then
			win.NavCaption.Position = UDim2.new(0, 10, 0.52, 0)
			win.NavCaption.Size = UDim2.new(1, -20, 0, 11)
		end
		if win.SectionNav then
			win.SectionNav.Position = UDim2.new(0, 0, 0.52, 13)
			win.SectionNav.Size = UDim2.new(1, 0, 0.48, -35)
		end

		for _, tab in ipairs(win.Tabs) do styleTab(win, tab) end
	end

	local previousTab = Window.CreateTab
	function Window:CreateTab(config)
		local tab = previousTab(self, config)
		Util.safe(function() styleTab(self, tab) end)
		return tab
	end

	local previousCreateWindow = NexoUI.CreateWindow
	function NexoUI:CreateWindow(config)
		if typeof(config) ~= "table" then config = {} end
		local win = previousCreateWindow(self, config)
		if not win then return win end

		Util.safe(function()
			mountLeftRail(win)
			win:SetSidebarWidth(win.SidebarWidth)
			win:_LayoutRows()
			win:_Refresh()
		end)

		return win
	end
end


-- =====================================================================
--  36. NEXO UI 2.7
--  * one full width top bar:  [ IMAGE ]  |  texts  |  search/min/close
--  * brand logo + brand text removed from the sidebar
--  * controls physically cannot leave the window (clipped + padded)
--  * minimize collapses to the tall top bar, instantly
--  * old mini/hide button deleted, rebuilt from scratch (image only)
-- =====================================================================
do
	local Motion = NexoUI.Motion
	local WHITE = Color3.new(1, 1, 1)
	local TOP_H = 44
	local SUB_ROW = 24
	local MINI = 40

	local function tw(inst, dur, goal, style)
		return Util.tween(inst, dur or Motion.Base, goal, style or Motion.Style, Motion.Dir)
	end

	-- placeholder slots, fill these in whenever you want
	NexoUI.BrandIcon = NexoUI.BrandIcon or ""
	NexoUI.MiniIcon = NexoUI.MiniIcon or "rbxassetid://134473690393403"

	-- ------------------------------------------------------------------
	--  GEOMETRY: everything sits under the top bar
	-- ------------------------------------------------------------------
	function Window:_ApplyTopOffset()
		if not self.TopBar or not self.TopBar.Parent then return self end
		local top = self.TopBarHeight or TOP_H
		local width = self.Narrow and 56 or self.SidebarWidth

		self.TopBar.Visible = true
		self.TopBar.Position = UDim2.fromOffset(0, 0)
		self.TopBar.Size = UDim2.new(1, 0, 0, top)

		if not self.Minimized then
			self.Sidebar.Position = UDim2.fromOffset(0, top)
			self.Sidebar.Size = UDim2.new(0, width, 1, -top)
			self.Body.Position = UDim2.fromOffset(width, top)
			self.Body.Size = UDim2.new(1, -width, 1, -top)
			Util.safe(function()
				if self.SidebarHandle and self.SidebarHandle.Parent then
					self.SidebarHandle.Position = UDim2.fromOffset(width - 3, top)
					self.SidebarHandle.Size = UDim2.new(0, 6, 1, -top)
				end
			end)
		end
		return self
	end

	local previousRefresh = Window._Refresh
	function Window:_Refresh(...)
		local result = previousRefresh(self, ...)
		Util.safe(function() self:_ApplyTopOffset() end)
		return result
	end

	local previousLayoutMode = Window._ApplyLayoutMode
	function Window:_ApplyLayoutMode(...)
		local result = previousLayoutMode(self, ...)
		Util.safe(function() self:_ApplyTopOffset() end)
		return result
	end

	-- the inner header is gone, so rows start at the top of the body
	function Window:_LayoutRows()
		local y = 0
		if self.TabRow then self.TabRow.Visible = false end
		if self.Header then
			self.Header.Visible = false
			self.Header.Size = UDim2.new(1, 0, 0, 0)
		end

		local holder = self.SubBarHolder
		if holder and holder.Parent == self.Body then
			local show = not self.Minimized and self:_HasSubTabs()
			holder.Visible = show
			holder.Position = UDim2.fromOffset(0, y)
			holder.Size = UDim2.new(1, -8, 0, SUB_ROW)
			if show then y = y + SUB_ROW end
		end

		if self.Pages and not self.Minimized then
			tw(self.Pages, Motion.Fast, {
				Position = UDim2.fromOffset(0, y),
				Size = UDim2.new(1, 0, 1, -y),
			})
		end
		return self
	end

	-- ------------------------------------------------------------------
	--  MINIMISE: collapse to the top bar, no thin black strip
	-- ------------------------------------------------------------------
	function Window:Minimize(state)
		if state == nil then state = not self.Minimized end
		self.Minimized = state and true or false
		local small = self.Minimized

		self.Main.Visible = true
		self.Main.BackgroundTransparency = self.BackgroundAlpha or 0.22
		if self.TopBar then self.TopBar.Visible = true end
		self.Sidebar.Visible = not small
		self.Body.Visible = not small
		self.Pages.Visible = not small
		if self.SubBarHolder then
			self.SubBarHolder.Visible = (not small) and self:_HasSubTabs()
		end
		if self.ResizeGrip then self.ResizeGrip.Visible = not small end
		Util.safe(function()
			if self.SidebarHandle then self.SidebarHandle.Visible = not small end
		end)

		self:_ApplyTopOffset()
		self:_Refresh()
		if small then
			self.Root.Size = UDim2.fromOffset(self.BaseSize.X, self.TopBarHeight or TOP_H)
		end
		if self.MinimizeIcon then
			tw(self.MinimizeIcon, Motion.Fast, { Rotation = small and 180 or 0 })
		end
		return self
	end

	-- ------------------------------------------------------------------
	--  BRAND ICON SLOT
	-- ------------------------------------------------------------------
	function Window:SetBrandIcon(id)
		if not self.BrandIcon then return self end
		local img = Util.image(id)
		self.BrandIcon.Image = img
		self.BrandIcon.BackgroundTransparency = (img ~= "" and 1) or 0.4
		if self.BrandHint then self.BrandHint.Visible = img == "" end
		return self
	end

	function Window:SetHeaderText(title, subtitle)
		if self.TopTitle and title ~= nil then self.TopTitle.Text = tostring(title) end
		if self.TopSub and subtitle ~= nil then self.TopSub.Text = tostring(subtitle) end
		return self
	end

	local function buildTopBar(win, config)
		local theme = NexoUI.Theme

		local bar = Util.new("Frame", {
			Name = "TopBar",
			Position = UDim2.fromOffset(0, 0),
			Size = UDim2.new(1, 0, 0, TOP_H),
			BackgroundColor3 = theme.Panel,
			BackgroundTransparency = 0.5,
			ClipsDescendants = true,
			Active = true,
			ZIndex = LAYER.Header + 2,
			Parent = win.Main,
		}, { Util.corner(13), Util.pad(0, 10, 0, 9) })

		-- square off the bottom corners so it merges with the window
		Util.new("Frame", {
			Name = "Foot",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, -9, 1, 0),
			Size = UDim2.new(1, 18, 0, 13),
			BackgroundColor3 = theme.Panel,
			BackgroundTransparency = 0.5,
			BorderSizePixel = 0,
			ZIndex = LAYER.Header + 1,
			Parent = bar,
		})
		Util.new("Frame", {
			Name = "Underline",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, -9, 1, 0),
			Size = UDim2.new(1, 18, 0, 1),
			BackgroundColor3 = theme.Border,
			BackgroundTransparency = 0.82,
			BorderSizePixel = 0,
			ZIndex = LAYER.Header + 3,
			Parent = bar,
		})

		-- 1) big image slot -------------------------------------------------
		local icon = Util.new("ImageLabel", {
			Name = "BrandIcon",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(30, 30),
			BackgroundColor3 = theme.Field,
			BackgroundTransparency = 0.4,
			Image = "",
			ScaleType = Enum.ScaleType.Fit,
			BorderSizePixel = 0,
			ZIndex = LAYER.Header + 4,
			Parent = bar,
		}, { Util.corner(9) })
		Util.stroke(theme.Border, 0.6, 1).Parent = icon
		local hint = Util.label({
			Name = "Hint",
			Size = UDim2.fromScale(1, 1),
			Text = "IMG",
			Font = FONT.Bold,
			TextSize = 8.5,
			TextColor3 = theme.MutedText,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = LAYER.Header + 5,
			Parent = icon,
		})
		win.BrandIcon = icon
		win.BrandHint = hint

		-- separator
		Util.new("Frame", {
			Name = "Sep1",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 39, 0.5, 0),
			Size = UDim2.fromOffset(1, 18),
			BackgroundColor3 = theme.Border,
			BackgroundTransparency = 0.75,
			BorderSizePixel = 0,
			ZIndex = LAYER.Header + 4,
			Parent = bar,
		})

		-- 2) texts ----------------------------------------------------------
		local info = Util.new("Frame", {
			Name = "BrandInfo",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 49, 0.5, 0),
			Size = UDim2.new(1, -175, 0, 30),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			ZIndex = LAYER.Header + 4,
			Parent = bar,
		})
		win.TopTitle = Util.label({
			Name = "Title",
			Position = UDim2.fromOffset(0, 1),
			Size = UDim2.new(1, 0, 0, 15),
			Text = tostring(config.Title or config.Name or win.Name or "NEXO"),
			Font = FONT.Black,
			TextSize = 13,
			TextColor3 = theme.Text,
			ZIndex = LAYER.Header + 5,
			Parent = info,
		})
		win.TopSub = Util.label({
			Name = "Subtitle",
			Position = UDim2.fromOffset(0, 16),
			Size = UDim2.new(1, 0, 0, 12),
			Text = tostring(config.Subtitle or "v2  -  premium suite"),
			Font = FONT.Medium,
			TextSize = 9.5,
			TextColor3 = theme.MutedText,
			ZIndex = LAYER.Header + 5,
			Parent = info,
		})

		-- 3) controls, locked inside the bar --------------------------------
		local controls = win.Header and win.Header:FindFirstChild("Controls")
		if controls then
			controls.Parent = bar
			controls.AnchorPoint = Vector2.new(1, 0.5)
			controls.Position = UDim2.new(1, 0, 0.5, 0)
			controls.ZIndex = LAYER.Header + 5
			for _, child in ipairs(controls:GetDescendants()) do
				if child:IsA("GuiObject") then child.ZIndex = LAYER.Header + 6 end
			end
			Util.new("Frame", {
				Name = "Sep2",
				Size = UDim2.fromOffset(1, 18),
				BackgroundColor3 = theme.Border,
				BackgroundTransparency = 0.75,
				BorderSizePixel = 0,
				LayoutOrder = -1,
				ZIndex = LAYER.Header + 5,
				Parent = controls,
			})
			-- keep the expanded search field from pushing anything outside
			if win.SearchBox then
				win.Maid:Give(win.SearchBox:GetPropertyChangedSignal("Size"):Connect(function()
					local cap = math.max(40, math.floor(win.Root.AbsoluteSize.X - 150))
					if win.SearchBox.Size.X.Offset > cap then
						win.SearchBox.Size = UDim2.fromOffset(cap, win.SearchBox.Size.Y.Offset)
					end
				end))
			end
		end

		win.TopBar = bar
		win.TopBarHeight = TOP_H
		Util.safe(function() win:_BindDrag(bar) end)
		win.Maid:Give(Util.onTheme(function(t)
			if not bar.Parent then return end
			bar.BackgroundColor3 = t.Panel
			if win.TopTitle then win.TopTitle.TextColor3 = t.Text end
			if win.TopSub then win.TopSub.TextColor3 = t.MutedText end
		end))
		return bar
	end

	-- ------------------------------------------------------------------
	--  MINI BUTTON, BUILT FROM SCRATCH (old one is destroyed)
	-- ------------------------------------------------------------------
	function Window:_SyncMini(instant)
		local parts = self.MiniParts
		if not parts or not parts.Root or not parts.Root.Parent then return end
		local open = self.Visible and true or false
		local dur = instant and 0 or Motion.Fast
		for _, bar in ipairs(parts.XBars or {}) do
			tw(bar, dur, {
				BackgroundTransparency = open and 0 or 1,
				Rotation = (bar:GetAttribute("Base") or 45) + (open and 0 or 45),
			})
		end
		if parts.Icon then
			tw(parts.Icon, dur, {
				ImageTransparency = open and 0.6 or 0,
				Size = UDim2.fromScale(open and 0.8 or 1, open and 0.8 or 1),
			})
		end
	end

	function Window:_BuildMiniButton()
		-- wipe anything left over from older versions
		Util.safe(function()
			if self.Mini and self.Mini.Parent then self.Mini:Destroy() end
			for _, child in ipairs(self.Gui:GetChildren()) do
				local n = child.Name
				if n == "Mini" or n == "MiniButton" or n == "Toggle" or n == "HideButton" then
					child:Destroy()
				end
			end
		end)
		self.MiniParts = nil

		local vp = Camera.ViewportSize
		local mini = Util.new("TextButton", {
			Name = "Mini",
			Text = "",
			AutoButtonColor = false,
			Position = UDim2.fromOffset(16, math.max(16, math.floor(vp.Y / 2) - MINI // 2)),
			Size = UDim2.fromOffset(MINI, MINI),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ClipsDescendants = false,
			ZIndex = LAYER.Toast + 40,
			Parent = self.Gui,
		}, { Util.corner(999) })
		Util.new("UIAspectRatioConstraint", { AspectRatio = 1, Parent = mini })

		local icon = Util.new("ImageLabel", {
			Name = "Icon",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Image = Util.image(self.Config and self.Config.MiniIcon or NexoUI.MiniIcon),
			ScaleType = Enum.ScaleType.Fit,
			BorderSizePixel = 0,
			ZIndex = LAYER.Toast + 41,
			Parent = mini,
		})

		local xBars = {}
		for i = 1, 2 do
			local base = i == 1 and 45 or -45
			local bar = Util.new("Frame", {
				Name = "X" .. i,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(12, 2),
				Rotation = base,
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = LAYER.Toast + 45,
				Parent = mini,
			}, { Util.corner(999) })
			bar:SetAttribute("Base", base)
			table.insert(xBars, bar)
		end

		self.Mini = mini
		self.MiniParts = { Root = mini, Icon = icon, XBars = xBars }

		-- drag, with a hard screen clamp: the ball never leaves the screen
		local dragging, moved, startInput, startPos = false, false, nil, nil
		self.Maid:Give(mini.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging, moved = true, false
				startInput, startPos = input.Position, mini.Position
				tw(mini, 0.08, { Size = UDim2.fromOffset(MINI - 3, MINI - 3) })
			end
		end))
		self.Maid:Give(UserInputService.InputChanged:Connect(function(input)
			if not dragging or not startInput then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement
				and input.UserInputType ~= Enum.UserInputType.Touch then return end
			local delta = input.Position - startInput
			if math.abs(delta.X) + math.abs(delta.Y) > 4 then moved = true end
			local screen = Camera.ViewportSize
			local x = math.clamp(startPos.X.Offset + delta.X, 4, math.max(4, screen.X - MINI - 4))
			local y = math.clamp(startPos.Y.Offset + delta.Y, 4, math.max(4, screen.Y - MINI - 4))
			mini.Position = UDim2.fromOffset(x, y)
		end))
		self.Maid:Give(UserInputService.InputEnded:Connect(function(input)
			if not dragging then return end
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
				tw(mini, 0.1, { Size = UDim2.fromOffset(MINI, MINI) })
				if not moved then Util.safe(function() self:Toggle() end) end
			end
		end))

		self:_SyncMini(true)
		return mini
	end

	-- ------------------------------------------------------------------
	--  ASSEMBLE
	-- ------------------------------------------------------------------
	local previousCreateWindow = NexoUI.CreateWindow
	function NexoUI:CreateWindow(config)
		if typeof(config) ~= "table" then config = {} end
		local win = previousCreateWindow(self, config)
		if not win then return win end

		Util.safe(function()
			-- sidebar brand block is gone for good
			if win.Brand then win.Brand.Visible = false end
			if win.Logo then win.Logo.Visible = false end
			if win.BrandText then win.BrandText.Visible = false end
			if win.BrandSub then win.BrandSub.Visible = false end

			-- reclaim the space the brand used to take
			if win.TabList then
				win.TabList.Position = UDim2.fromOffset(0, 6)
				win.TabList.Size = UDim2.new(1, 0, 0.55, -14)
			end
			if win.NavCaption then
				win.NavCaption.Position = UDim2.new(0, 10, 0.55, 0)
			end
			if win.SectionNav then
				win.SectionNav.Position = UDim2.new(0, 0, 0.55, 13)
				win.SectionNav.Size = UDim2.new(1, 0, 0.45, -35)
			end

			win.HeaderHeight = TOP_H
			buildTopBar(win, config)
			win:SetBrandIcon(config.BrandIcon or config.HeaderIcon or NexoUI.BrandIcon)

			-- nothing may render outside the window frame
			win.Main.ClipsDescendants = true
			if win.Body then win.Body.ClipsDescendants = true end

			win:_ApplyTopOffset()
			win:_LayoutRows()
			win:_Refresh()
		end)

		return win
	end
end


-- =====================================================================
--  37. NEXO UI 2.8
--  * brand image slot is WIDE (horizontal banner), not a square tile
--  * mini ball: zero effects. perfect circle, red outline, image only
--  * every corner in the window gets a smooth radius (no sharp edges)
-- =====================================================================
do
	local Motion = NexoUI.Motion
	local MINI = 40

	local function tw(inst, dur, goal, style)
		return Util.tween(inst, dur or Motion.Base, goal, style or Motion.Style, Motion.Dir)
	end

	-- width x height of the header image slot. horizontal by default.
	NexoUI.BrandIconSize = NexoUI.BrandIconSize or Vector2.new(96, 26)

	local function resolveIconSize(value)
		if typeof(value) == "Vector2" then return value end
		if typeof(value) == "number" then return Vector2.new(value, 26) end
		if typeof(value) == "table" and value.X and value.Y then
			return Vector2.new(value.X, value.Y)
		end
		return NexoUI.BrandIconSize
	end

	-- ------------------------------------------------------------------
	--  WIDE HEADER IMAGE
	-- ------------------------------------------------------------------
	function Window:SetBrandIconSize(value)
		local size = resolveIconSize(value)
		if not self.BrandIcon then return self end
		self.BrandIcon.Size = UDim2.fromOffset(size.X, size.Y)

		local sep = self.TopBar and self.TopBar:FindFirstChild("Sep1")
		if sep then sep.Position = UDim2.new(0, size.X + 9, 0.5, 0) end

		local info = self.TopBar and self.TopBar:FindFirstChild("BrandInfo")
		if info then
			info.Position = UDim2.new(0, size.X + 19, 0.5, 0)
			info.Size = UDim2.new(1, -(size.X + 19 + 112), 0, 30)
		end
		return self
	end

	-- ------------------------------------------------------------------
	--  MINI BALL: no effects whatsoever
	-- ------------------------------------------------------------------
	function Window:_SyncMini()
		-- intentionally empty: the ball never changes on open/close
		return self
	end

	function Window:_BuildMiniButton()
		Util.safe(function()
			if self.Mini and self.Mini.Parent then self.Mini:Destroy() end
			for _, child in ipairs(self.Gui:GetChildren()) do
				local n = child.Name
				if n == "Mini" or n == "MiniButton" or n == "Toggle" or n == "HideButton" then
					child:Destroy()
				end
			end
		end)

		local vp = Camera.ViewportSize
		local mini = Util.new("ImageButton", {
			Name = "Mini",
			AutoButtonColor = false,
			Position = UDim2.fromOffset(16, math.max(16, math.floor(vp.Y / 2) - 20)),
			Size = UDim2.fromOffset(MINI, MINI),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = Util.image((self.Config and self.Config.MiniIcon) or NexoUI.MiniIcon),
			ImageTransparency = 0,
			ScaleType = Enum.ScaleType.Crop,
			ClipsDescendants = true,
			ZIndex = LAYER.Toast + 40,
			Parent = self.Gui,
		})

		-- perfect circle, always
		Util.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = mini })
		Util.new("UIAspectRatioConstraint", { AspectRatio = 1, Parent = mini })

		-- red outline
		local outline = Util.stroke(NexoUI.Theme.Accent, 0, 2)
		outline.Parent = mini
		self.Maid:Give(Util.onTheme(function(t)
			if outline.Parent then outline.Color = t.Accent end
		end))

		self.Mini = mini
		self.MiniParts = { Root = mini, Icon = mini, XBars = {} }

		-- drag with a hard screen clamp, no visual feedback
		local dragging, moved, startInput, startPos = false, false, nil, nil
		self.Maid:Give(mini.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging, moved = true, false
				startInput, startPos = input.Position, mini.Position
			end
		end))
		self.Maid:Give(UserInputService.InputChanged:Connect(function(input)
			if not dragging or not startInput then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement
				and input.UserInputType ~= Enum.UserInputType.Touch then return end
			local delta = input.Position - startInput
			if math.abs(delta.X) + math.abs(delta.Y) > 4 then moved = true end
			local screen = Camera.ViewportSize
			local x = math.clamp(startPos.X.Offset + delta.X, 4, math.max(4, screen.X - MINI - 4))
			local y = math.clamp(startPos.Y.Offset + delta.Y, 4, math.max(4, screen.Y - MINI - 4))
			mini.Position = UDim2.fromOffset(x, y)
		end))
		self.Maid:Give(UserInputService.InputEnded:Connect(function(input)
			if not dragging then return end
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
				if not moved then Util.safe(function() self:Toggle() end) end
			end
		end))

		return mini
	end

	-- ------------------------------------------------------------------
	--  ROUND EVERY CORNER
	-- ------------------------------------------------------------------
	local ROUNDABLE = {
		Frame = true, TextButton = true, ImageButton = true,
		TextBox = true, ImageLabel = true, ScrollingFrame = true, CanvasGroup = true,
	}

	local function smoothCorners(root, minRadius)
		minRadius = minRadius or 8
		for _, obj in ipairs(root:GetDescendants()) do
			if ROUNDABLE[obj.ClassName] then
				local existing = obj:FindFirstChildOfClass("UICorner")
				if existing then
					if existing.CornerRadius.Scale == 0
						and existing.CornerRadius.Offset > 0
						and existing.CornerRadius.Offset < minRadius then
						existing.CornerRadius = UDim.new(0, minRadius)
					end
				else
					local box = obj.AbsoluteSize
					local thin = (box.X > 0 and box.X <= 3) or (box.Y > 0 and box.Y <= 3)
					local painted = obj.BackgroundTransparency < 0.99
					if painted and not thin then
						local side = math.min(box.X > 0 and box.X or 999, box.Y > 0 and box.Y or 999)
						local radius = math.clamp(math.floor(side / 3), 4, minRadius)
						Util.new("UICorner", { CornerRadius = UDim.new(0, radius), Parent = obj })
					end
				end
			end
		end
	end

	function Window:SmoothCorners(minRadius)
		Util.safe(function() smoothCorners(self.Root, minRadius) end)
		return self
	end

	-- ------------------------------------------------------------------
	--  ASSEMBLE
	-- ------------------------------------------------------------------
	local previousCreateWindow = NexoUI.CreateWindow
	function NexoUI:CreateWindow(config)
		if typeof(config) ~= "table" then config = {} end
		local win = previousCreateWindow(self, config)
		if not win then return win end

		Util.safe(function()
			if win.BrandIcon then
				win.BrandIcon.ScaleType = Enum.ScaleType.Fit
				win:SetBrandIconSize(config.BrandIconSize)
				if win.BrandHint then win.BrandHint.Text = "IMAGE ID" end
			end

			-- corners after the first frame so AbsoluteSize is real
			task.defer(function()
				Util.safe(function() smoothCorners(win.Root, 8) end)
			end)
		end)

		return win
	end

	-- new tabs/sections created later also get rounded
	local previousCreateTab = Window.CreateTab
	function Window:CreateTab(config)
		local tab = previousCreateTab(self, config)
		task.defer(function()
			Util.safe(function()
				if tab and tab.Page then smoothCorners(tab.Page, 8) end
				if tab and tab.Button then smoothCorners(tab.Button, 8) end
			end)
		end)
		return tab
	end
end


-- =====================================================================
--  38. NEXO UI 2.9
--  * top image slot back to the small square, using the given asset
--  * much smaller window: 320 x 205, sidebar 88, top bar 32
--  * sidebar resize line stops below the top bar, never crosses it
-- =====================================================================
do
	local Motion = NexoUI.Motion
	local TOP_H = 32

	local function tw(inst, dur, goal, style)
		return Util.tween(inst, dur or Motion.Base, goal, style or Motion.Style, Motion.Dir)
	end

	-- the header slot uses the same asset unless you override it
	if NexoUI.BrandIcon == nil or NexoUI.BrandIcon == "" then
		NexoUI.BrandIcon = NexoUI.MiniIcon or "rbxassetid://134473690393403"
	end
	NexoUI.BrandIconSize = Vector2.new(24, 24)

	-- ------------------------------------------------------------------
	--  THE RESIZE LINE MUST NEVER TOUCH THE TOP BAR
	-- ------------------------------------------------------------------
	function Window:_FixHandle()
		local handle = self.SidebarHandle
		if not handle or not handle.Parent then return self end
		local top = self.TopBarHeight or TOP_H
		local width = self.Narrow and 56 or self.SidebarWidth
		handle.Position = UDim2.new(0, width - 3, 0, top)
		handle.Size = UDim2.new(0, 6, 1, -top)
		handle.ZIndex = LAYER.Content + 6
		for _, child in ipairs(handle:GetChildren()) do
			if child:IsA("GuiObject") then child.ZIndex = LAYER.Content + 7 end
		end
		return self
	end

	local previousSetSidebarWidth = Window.SetSidebarWidth
	function Window:SetSidebarWidth(width)
		local result = previousSetSidebarWidth(self, width)
		Util.safe(function() self:_FixHandle() end)
		return result
	end

	local previousTopOffset = Window._ApplyTopOffset
	function Window:_ApplyTopOffset(...)
		local result = previousTopOffset(self, ...)
		Util.safe(function() self:_FixHandle() end)
		return result
	end

	-- ------------------------------------------------------------------
	--  COMPACT TOP BAR
	-- ------------------------------------------------------------------
	local function shrinkTopBar(win)
		local bar = win.TopBar
		if not bar or not bar.Parent then return end

		win.TopBarHeight = TOP_H
		win.HeaderHeight = TOP_H
		bar.Size = UDim2.new(1, 0, 0, TOP_H)

		local pad = bar:FindFirstChildOfClass("UIPadding")
		if pad then
			pad.PaddingLeft = UDim.new(0, 8)
			pad.PaddingRight = UDim.new(0, 7)
		end

		-- small square image slot again
		if win.BrandIcon then
			win.BrandIcon.Size = UDim2.fromOffset(24, 24)
			win.BrandIcon.ScaleType = Enum.ScaleType.Fit
		end
		if win.BrandHint then win.BrandHint.TextSize = 7 end

		local sep = bar:FindFirstChild("Sep1")
		if sep then
			sep.Position = UDim2.new(0, 31, 0.5, 0)
			sep.Size = UDim2.fromOffset(1, 14)
		end

		local info = bar:FindFirstChild("BrandInfo")
		if info then
			info.Position = UDim2.new(0, 39, 0.5, 0)
			info.Size = UDim2.new(1, -142, 0, 26)
		end
		if win.TopTitle then
			win.TopTitle.Position = UDim2.fromOffset(0, 0)
			win.TopTitle.Size = UDim2.new(1, 0, 0, 13)
			win.TopTitle.TextSize = 11.5
		end
		if win.TopSub then
			win.TopSub.Position = UDim2.fromOffset(0, 13)
			win.TopSub.Size = UDim2.new(1, 0, 0, 11)
			win.TopSub.TextSize = 8.5
		end

		-- control buttons shrink with the bar
		local controls = bar:FindFirstChild("Controls")
		if controls then
			controls.Size = UDim2.fromOffset(0, 20)
			local list = controls:FindFirstChildOfClass("UIListLayout")
			if list then list.Padding = UDim.new(0, 4) end
			for _, child in ipairs(controls:GetChildren()) do
				if child:IsA("GuiButton") then
					child.Size = UDim2.fromOffset(20, 20)
				elseif child.Name == "Sep2" then
					child.Size = UDim2.fromOffset(1, 14)
				end
			end
			if win.SearchBox then win.SearchBox.TextSize = 10 end
		end

		local foot = bar:FindFirstChild("Foot")
		if foot then foot.Size = UDim2.new(1, 18, 0, 13) end
	end

	-- ------------------------------------------------------------------
	--  ASSEMBLE
	-- ------------------------------------------------------------------
	local previousCreateWindow = NexoUI.CreateWindow
	function NexoUI:CreateWindow(config)
		if typeof(config) ~= "table" then config = {} end
		local win = previousCreateWindow(self, config)
		if not win then return win end

		Util.safe(function()
			-- smaller again
			if config.Size == nil then win.BaseSize = Vector2.new(320, 205) end
			if config.SidebarWidth == nil then win.SidebarWidth = 88 end

			shrinkTopBar(win)

			if win.FooterLabel then win.FooterLabel.TextSize = 8.5 end
			if win.NavCaption then win.NavCaption.TextSize = 8.5 end

			win:SetSidebarWidth(win.SidebarWidth)
			win:_ApplyTopOffset()
			win:_LayoutRows()
			win:_Refresh()
			win:_FixHandle()
		end)

		return win
	end
end


return NexoUI

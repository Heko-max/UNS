-- Tooltips live in their own layer and are clamped to the viewport.
function NexoUI.ShowTooltip(window, anchor, text)
	if not window or not window.TooltipLayer or not anchor then return end
	NexoUI.HideTooltip(window)
	local theme = NexoUI.Theme
	local frame = Util.new("Frame", {
		Name = "Tooltip",
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = theme.PanelAlt,
		BackgroundTransparency = 0.05,
		ZIndex = LAYER.Tooltip + 1,
		Parent = window.TooltipLayer,
	}, { Util.corner(8), Util.pad(7, 10, 7, 10) })
	Util.stroke(theme.Border, 0.6, 1).Parent = frame
	Util.new("UISizeConstraint", { MaxSize = Vector2.new(260, 200), Parent = frame })
	Util.label({
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		Text = tostring(text),
		Font = FONT.Medium,
		TextSize = 12,
		TextColor3 = theme.Text,
		TextWrapped = true,
		ZIndex = LAYER.Tooltip + 2,
		Parent = frame,
	})
	window._tooltip = frame
	-- place it after a frame so AbsoluteSize is known, then keep it on screen
	task.defer(function()
		if not frame.Parent then return end
		local vp = Camera.ViewportSize
		local size = frame.AbsoluteSize
		local pos = anchor.AbsolutePosition
		local x = math.clamp(pos.X, 8, math.max(8, vp.X - size.X - 8))
		local y = pos.Y - size.Y - 8
		if y < 8 then y = pos.Y + anchor.AbsoluteSize.Y + 8 end
		frame.Position = UDim2.fromOffset(x, math.clamp(y, 8, math.max(8, vp.Y - size.Y - 8)))
	end)
	return frame
end

function NexoUI.HideTooltip(window)
	if window and window._tooltip then
		pcall(function() window._tooltip:Destroy() end)
		window._tooltip = nil
	end
end

-- Window:Notify{ Title, Content, Icon, Duration, Type }
-- Toasts are laid out by a UIListLayout so they can never overlap.
function Window:Notify(config)
	if typeof(config) ~= "table" then config = { Title = tostring(config or "") } end
	local theme = NexoUI.Theme
	local kind = tostring(config.Type or "Info")
	local accent = theme[kind] or theme.Accent
	local duration = tonumber(config.Duration) or 5

	-- keep the stack short; oldest disappears first
	local maxVisible = tonumber(config.Max) or 5
	while #self.Notifications >= maxVisible do
		local oldest = table.remove(self.Notifications, 1)
		if oldest and oldest.Close then oldest:Close() end
	end

	local holder = Util.new("Frame", {
		Name = "Toast",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		LayoutOrder = tick() * 1000 % 2147483647,
		ZIndex = LAYER.Toast + 1,
		Parent = self.ToastLayer,
	})
	local card = Util.new("Frame", {
		Name = "Card",
		Position = UDim2.fromScale(1.1, 0),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = theme.Notification,
		ZIndex = LAYER.Toast + 2,
		Parent = holder,
	}, { Util.corner(12), Util.pad(12, 14, 12, 14) })
	Util.stroke(theme.Border, 0.62, 1.2).Parent = card
	Util.new("Frame", {
		Name = "Accent",
		Size = UDim2.new(0, 3, 1, -20),
		Position = UDim2.fromOffset(-8, 10),
		BackgroundColor3 = accent,
		ZIndex = LAYER.Toast + 3,
		Parent = card,
	}, { Util.corner(999) })

	local iconId = Util.image(config.Icon or config.Image)
	local inset = 0
	if iconId ~= "" then
		local img = Util.imageObject({ Image = iconId, Size = config.IconSize or 22, Color = config.IconColor }, 22)
		img.AnchorPoint = Vector2.new(0, 0)
		img.Position = UDim2.fromOffset(0, 1)
		img.ZIndex = LAYER.Toast + 4
		img.Parent = card
		inset = 32
	end

	local textCol = Util.new("Frame", {
		Position = UDim2.fromOffset(inset, 0),
		Size = UDim2.new(1, -inset - 22, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ZIndex = LAYER.Toast + 4,
		Parent = card,
	}, { Util.list(3) })
	Util.label({
		Size = UDim2.new(1, 0, 0, 17),
		Text = tostring(config.Title or config.Name or "Notification"),
		Font = FONT.Bold,
		TextSize = 13.5,
		TextColor3 = theme.Text,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = LAYER.Toast + 5,
		Parent = textCol,
	})
	local body = config.Content or config.Description or config.Text
	if body then
		Util.label({
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = tostring(body),
			Font = FONT.Regular,
			TextSize = 12,
			TextColor3 = theme.SubText,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			LineHeight = 1.25,
			ZIndex = LAYER.Toast + 5,
			Parent = textCol,
		})
	end

	local closeBtn = Util.new("TextButton", {
		Name = "Close",
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		ZIndex = LAYER.Toast + 5,
		Parent = card,
	})
	for i = 1, 2 do
		Util.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(10, 1.6),
			Rotation = i == 1 and 45 or -45,
			BackgroundColor3 = theme.MutedText,
			ZIndex = LAYER.Toast + 6,
			Parent = closeBtn,
		}, { Util.corner(1) })
	end

	local bar = Util.new("Frame", {
		Name = "Timer",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 8),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = accent,
		BackgroundTransparency = 0.25,
		ZIndex = LAYER.Toast + 5,
		Parent = card,
	}, { Util.corner(999) })

	local toast = { Frame = holder, Card = card }
	local closed = false
	function toast:Close()
		if closed then return end
		closed = true
		Util.tween(card, 0.18, { Position = UDim2.fromScale(1.15, 0) })
		task.delay(0.2, function() pcall(function() holder:Destroy() end) end)
		for i, n in ipairs(self.Notifications) do
			if n == toast then table.remove(self.Notifications, i) break end
		end
		Util.safe(config.OnClose)
	end

	closeBtn.Activated:Connect(function() toast:Close() end)
	if typeof(config.Callback) == "function" then
		local hit = Util.new("TextButton", {
			Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1), ZIndex = LAYER.Toast + 3, Parent = card,
		})
		hit.Activated:Connect(function()
			Util.safe(config.Callback, toast)
			toast:Close()
		end)
	end

	Util.tween(card, 0.26, { Position = UDim2.fromScale(0, 0) }, Enum.EasingStyle.Quint)
	if duration > 0 then
		Util.tween(bar, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
		task.delay(duration + 0.05, function() toast:Close() end)
	else
		bar.Visible = false
	end

	table.insert(self.Notifications, toast)
	return toast
end


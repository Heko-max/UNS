-- =====================================================================
--  14. CLIPBOARD
-- =====================================================================
function NexoUI:Copy(text)
	text = tostring(text or "")
	local setter
	if typeof(setclipboard) == "function" then
		setter = setclipboard
	elseif typeof(toclipboard) == "function" then
		setter = toclipboard
	elseif typeof(Clipboard) == "table" and typeof(Clipboard.set) == "function" then
		setter = Clipboard.set
	elseif typeof(syn) == "table" and typeof(syn.write_clipboard) == "function" then
		setter = syn.write_clipboard
	end
	if not setter then
		Util.warn("clipboard is not available in this environment")
		return false
	end
	local ok = pcall(setter, text)
	if ok then NexoUI.FireHook("Copied", text) end
	return ok
end

function NexoUI:GetClipboard()
	if typeof(getclipboard) == "function" then
		local ok, value = pcall(getclipboard)
		if ok then return value end
	end
	return nil
end

function NexoUI:CopyWithToast(text, label)
	local ok = NexoUI:Copy(text)
	local window = NexoUI.Windows[#NexoUI.Windows]
	if window then
		window:Notify({
			Title = ok and "Copied" or "Copy failed",
			Content = ok and (label or "Copied to clipboard") or "Clipboard is unavailable here",
			Type = ok and "Success" or "Error",
			Duration = 3,
		})
	end
	return ok
end


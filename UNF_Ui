function Util.minSize(x, y)
	return Util.new("UISizeConstraint", { MinSize = Vector2.new(x or 0, y or 0) })
end

function Util.aspect(ratio)
	return Util.new("UIAspectRatioConstraint", { AspectRatio = ratio or 1 })

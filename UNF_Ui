function NexoUI:GetThemePresets()
	local names = {}
	for name in pairs(NexoUI.Themes) do table.insert(names, name) end
	table.sort(names)
	return names
end

function NexoUI:ApplyPreset(name)
	local palette = NexoUI.Themes[tostring(name)]
	if not palette then
		Util.warn("unknown theme preset '" .. tostring(name) .. "'")
		return false
	end
	NexoUI:SetTheme(palette)
	NexoUI.FireHook("ThemeChanged", name)
	return true
end

function NexoUI:ExportTheme(name)
	local palette = name and NexoUI.Themes[tostring(name)] or NexoUI.Theme
	local data = { Name = tostring(palette.Name or name or "Custom"), Colors = {} }
	for key, value in pairs(palette) do
		if typeof(value) == "Color3" then
			data.Colors[key] = {
				math.floor(value.R * 255 + 0.5),
				math.floor(value.G * 255 + 0.5),
				math.floor(value.B * 255 + 0.5),
			}
		end
	end
	local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
	if not ok then return nil end
	return encoded
end

function NexoUI:ImportTheme(source, name, apply)
	local data = source
	if typeof(source) == "string" then
		local ok, decoded = pcall(function() return HttpService:JSONDecode(source) end)
		if not ok then
			Util.warn("theme import failed: invalid JSON")
			return nil
		end
		data = decoded
	end
	if typeof(data) ~= "table" or typeof(data.Colors) ~= "table" then
		Util.warn("theme import failed: missing Colors table")
		return nil
	end
	local palette = Util.copy(NexoUI.Themes.NEXO)
	for key, value in pairs(data.Colors) do
		if typeof(value) == "table" and #value >= 3 then
			palette[key] = Color3.fromRGB(
				math.clamp(tonumber(value[1]) or 0, 0, 255),
				math.clamp(tonumber(value[2]) or 0, 0, 255),
				math.clamp(tonumber(value[3]) or 0, 0, 255))
		end
	end
	palette.Name = tostring(name or data.Name or "Imported")
	NexoUI:AddTheme(palette.Name, palette)
	if apply ~= false then NexoUI:SetTheme(palette) end
	return palette
end

function NexoUI:ExportThemeToClipboard(name)
	local encoded = NexoUI:ExportTheme(name)
	if not encoded then return false end
	return NexoUI:CopyWithToast(encoded, "Theme JSON")
end

function NexoUI:ImportThemeFromClipboard(apply)
	local contents = NexoUI:GetClipboard()
	if not contents then
		Util.warn("clipboard read is not available")
		return nil
	end
	return NexoUI:ImportTheme(contents, nil, apply)
end

function NexoUI:SaveThemeToFile(path, name)
	if typeof(writefile) ~= "function" then return false end
	local encoded = NexoUI:ExportTheme(name)
	if not encoded then return false end
	return pcall(writefile, tostring(path or "NexoUI_theme.json"), encoded)
end

function NexoUI:LoadThemeFromFile(path, apply)
	if typeof(readfile) ~= "function" then return nil end
	local ok, contents = pcall(readfile, tostring(path or "NexoUI_theme.json"))
	if not ok then return nil end
	return NexoUI:ImportTheme(contents, nil, apply)
end

